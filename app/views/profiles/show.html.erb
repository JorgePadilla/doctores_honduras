<div class="max-w-4xl mx-auto">
  <% if @user.doctor_profile %>
    <!-- Profile exists - show doctor profile -->
    <% actions = capture do %>
      <%= link_to "Editar perfil", edit_profile_path, class: "btn-primary" %>
    <% end %>
    <%= render "shared/page_header",
        title: @doctor_profile.display_name,
        subtitle: "Especialista en #{@doctor_profile.specialty&.name}",
        actions: actions %>

    <div class="card overflow-hidden">
      <div class="flex flex-col md:flex-row">
        <div class="md:w-1/3 p-6">
          <% if @doctor_profile.image_url.present? %>
            <img src="<%= @doctor_profile.image_url %>" alt="<%= @doctor_profile.display_name %>" class="w-full h-auto rounded-lg object-cover" />
          <% else %>
            <div class="w-full h-64 bg-slate-100 dark:bg-slate-700 rounded-lg flex items-center justify-center">
              <span class="text-muted dark:text-slate-400">Sin imagen</span>
            </div>
          <% end %>

          <%# Social media links %>
          <% social_links = [
            { url: @doctor_profile.facebook_url, label: "Facebook" },
            { url: @doctor_profile.instagram_url, label: "Instagram" },
            { url: @doctor_profile.twitter_url, label: "X" },
            { url: @doctor_profile.linkedin_url, label: "LinkedIn" },
            { url: @doctor_profile.tiktok_url, label: "TikTok" },
            { url: @doctor_profile.youtube_url, label: "YouTube" }
          ].select { |l| l[:url].present? } %>

          <% if social_links.any? %>
            <div class="mt-4 flex flex-wrap gap-2">
              <% social_links.each do |link| %>
                <a href="<%= link[:url] %>" target="_blank" rel="noopener noreferrer"
                   class="inline-flex items-center px-3 py-1.5 text-sm rounded-full bg-primary-soft dark:bg-sky-900/30 text-primary-hover dark:text-sky-400 hover:bg-sky-100 dark:hover:bg-sky-900/50 transition-colors">
                  <%= link[:label] %>
                </a>
              <% end %>
            </div>
          <% end %>
        </div>

        <div class="md:w-2/3 p-6">
          <% if @doctor_profile.subspecialty.present? %>
            <p class="text-muted dark:text-slate-400 mb-4">Subespecialidad: <%= @doctor_profile.subspecialty.name %></p>
          <% end %>

          <% if @doctor_profile.description.present? %>
            <div class="mb-6">
              <h2 class="card-title">Sobre el médico</h2>
              <p class="text-ink dark:text-slate-300"><%= @doctor_profile.description %></p>
            </div>
          <% end %>

          <%# Services %>
          <% if @doctor_profile.services.any? %>
            <div class="mb-6">
              <h2 class="card-title">Servicios</h2>
              <div class="flex flex-wrap gap-2">
                <% @doctor_profile.services.each do |service| %>
                  <span class="inline-block px-3 py-1 text-sm rounded-full bg-primary-soft dark:bg-sky-900/30 text-primary-hover dark:text-sky-300"><%= service.name %></span>
                <% end %>
              </div>
            </div>
          <% end %>

          <%# Languages %>
          <% if @doctor_profile.languages.present? && @doctor_profile.languages.reject(&:blank?).any? %>
            <div class="mb-6">
              <h2 class="card-title">Idiomas</h2>
              <div class="flex flex-wrap gap-2">
                <% @doctor_profile.languages.reject(&:blank?).each do |language| %>
                  <span class="inline-block px-3 py-1 text-sm rounded-full bg-primary-soft dark:bg-sky-900/30 text-primary-hover dark:text-sky-400"><%= language %></span>
                <% end %>
              </div>
            </div>
          <% end %>

          <div class="mb-6">
            <h2 class="card-title">Información de Contacto</h2>
            <div class="space-y-2">
              <p class="text-ink dark:text-slate-300"><strong>Ubicación:</strong> <%= @doctor_profile.city&.name %>, <%= @doctor_profile.department&.name %></p>
              <% if @doctor_profile.website.present? %>
                <p class="text-ink dark:text-slate-300">
                  <strong>Sitio web:</strong>
                  <a href="<%= @doctor_profile.website %>" target="_blank" class="break-all hover:underline text-primary-hover dark:text-sky-400"><%= @doctor_profile.website %></a>
                </p>
              <% end %>
              <% if @doctor_profile.medical_license.present? %>
                <p class="text-ink dark:text-slate-300"><strong>No. de colegiación:</strong> <%= @doctor_profile.medical_license %></p>
              <% end %>
            </div>
          </div>

          <%# Education %>
          <% educations = @doctor_profile.doctor_educations.ordered %>
          <% if educations.any? %>
            <div class="mb-6">
              <h2 class="card-title">Formación Académica</h2>
              <div class="space-y-3">
                <% educations.each do |edu| %>
                  <div class="border-l-2 pl-4 border-line dark:border-slate-600">
                    <p class="font-medium text-ink dark:text-slate-200"><%= edu.institution %></p>
                    <% if edu.degree.present? %>
                      <p class="text-muted dark:text-slate-400"><%= edu.degree %></p>
                    <% end %>
                    <% if edu.graduation_year.present? %>
                      <p class="text-sm text-muted dark:text-slate-500"><%= edu.graduation_year %></p>
                    <% end %>
                  </div>
                <% end %>
              </div>
            </div>
          <% end %>

          <%# Certifications %>
          <% certifications = @doctor_profile.doctor_certifications.ordered %>
          <% if certifications.any? %>
            <div class="mb-6">
              <h2 class="card-title">Capacitaciones y Certificaciones</h2>
              <div class="space-y-3">
                <% certifications.each do |cert| %>
                  <div class="border-l-2 pl-4 border-line dark:border-slate-600">
                    <p class="font-medium text-ink dark:text-slate-200"><%= cert.name %></p>
                    <% if cert.institution.present? %>
                      <p class="text-muted dark:text-slate-400"><%= cert.institution %></p>
                    <% end %>
                    <% if cert.year.present? %>
                      <p class="text-sm text-muted dark:text-slate-500"><%= cert.year %></p>
                    <% end %>
                  </div>
                <% end %>
              </div>
            </div>
          <% end %>

          <%# Branches %>
          <% branches = @doctor_profile.doctor_branches.ordered %>
          <% if branches.any? %>
            <div class="mb-6">
              <h2 class="card-title">Ubicaciones</h2>
              <% branches.each do |branch| %>
                <div class="mb-4 border-l-2 pl-4 border-line dark:border-slate-600">
                  <p class="text-base font-semibold text-ink dark:text-white"><%= branch.name %></p>
                  <p class="text-muted dark:text-slate-400"><%= branch.address %></p>
                  <% if branch.city.present? || branch.department.present? %>
                    <p class="text-muted dark:text-slate-400"><%= [branch.city&.name, branch.department&.name].compact.join(", ") %></p>
                  <% end %>
                  <% if paid_plan? && branch.phone.present? %>
                    <p class="text-muted dark:text-slate-400">Tel: <%= branch.phone %></p>
                  <% end %>
                  <% if branch.map_link.present? %>
                    <a href="<%= branch.map_link %>" target="_blank" class="text-sm hover:underline text-primary-hover dark:text-sky-400">Ver en mapa</a>
                  <% end %>
                  <% if paid_plan? %>
                    <%= render "shared/branch_schedule", branch: branch %>
                  <% end %>
                </div>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  <% else %>
    <!-- No profile exists - redirect to creation -->
    <div class="card p-8 text-center">
      <div class="max-w-md mx-auto">
        <%= icon(:user_circle, class: "h-16 w-16 mx-auto text-slate-300 dark:text-slate-600 mb-4") %>
        <p class="text-lg font-semibold text-ink dark:text-white mb-2">No tienes un perfil creado</p>
        <p class="text-muted dark:text-slate-400 mb-6">Crea tu perfil de doctor para que los pacientes puedan encontrarte.</p>
        <%= link_to new_profile_path, class: "btn-primary" do %>
          <%= icon(:plus, class: "w-4 h-4") %>
          Crear perfil
        <% end %>
      </div>
    </div>
  <% end %>
</div>
