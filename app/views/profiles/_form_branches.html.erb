<% max_branches = paid_plan? ? 0 : 1 %>
<div class="card p-6 mb-6"
     data-controller="nested-fields"
     data-nested-fields-max-entries-value="<%= max_branches %>">
  <div class="flex flex-wrap items-center justify-between gap-y-3 mb-5 pb-4 border-b border-line dark:border-slate-700">
    <div class="flex items-center gap-3">
      <div class="w-10 h-10 rounded-lg bg-primary-soft dark:bg-sky-900/30 flex items-center justify-center text-primary dark:text-sky-400">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
        </svg>
      </div>
      <div>
        <h2 class="card-title mb-0">Ubicaciones</h2>
        <% unless paid_plan? %>
          <p class="text-sm text-muted dark:text-slate-400">
            El plan gratuito permite 1 ubicación sin horarios ni teléfono.
          </p>
        <% else %>
          <p class="text-sm text-muted dark:text-slate-400">Consultorios y ubicaciones donde atiendes</p>
        <% end %>
      </div>
    </div>
    <div class="flex flex-wrap items-center gap-2">
      <button type="button" data-action="nested-fields#add"
              data-nested-fields-target="addButton"
              class="btn-secondary btn-sm">
        <%= icon(:plus, class: "w-4 h-4") %>
        Agregar ubicación
      </button>
      <% unless paid_plan? %>
        <a href="<%= settings_subscription_path %>"
           data-nested-fields-target="upgrade"
           style="display: none;"
           class="btn-secondary btn-sm whitespace-normal text-center w-full sm:w-auto">
          <%= icon(:sparkles, class: "w-4 h-4") %>
          Mejorar plan para más ubicaciones
        </a>
      <% end %>
    </div>
  </div>

  <template data-nested-fields-target="template">
    <%= render "profiles/form_branch_fields", form: form, branch_title: "Nueva ubicación" %>
  </template>

  <div data-nested-fields-target="container">
    <% @doctor_profile.doctor_branches.each_with_index do |branch, index| %>
      <%= form.fields_for :doctor_branches, branch, child_index: branch.persisted? ? branch.id : index do |bf| %>
        <%= render "profiles/form_branch_fields", form: form, bf: bf, branch: branch, branch_title: "Ubicación ##{index + 1}" %>
      <% end %>
    <% end %>
  </div>
</div>
