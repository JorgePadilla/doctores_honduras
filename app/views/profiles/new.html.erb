<div class="max-w-3xl mx-auto">
  <%= render "shared/page_header", title: "Crear perfil de doctor", subtitle: "Completa la información de tu perfil para que los pacientes puedan encontrarte" %>

  <%= form_with model: @doctor_profile, url: profile_path, class: "card p-6", multipart: true do |form| %>
    <%= render "shared/form_errors", model: @doctor_profile %>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <!-- Información Básica -->
      <div class="md:col-span-2">
        <h2 class="card-title">Información Básica</h2>
      </div>

      <div class="md:col-span-2">
        <%= form.label :name, "Nombre completo", class: "form-label" %>
        <%= form.text_field :name, class: "form-input", required: true %>
      </div>

      <div class="md:col-span-2 grid grid-cols-1 md:grid-cols-2 gap-6">
        <div data-controller="subspecialty">
          <div class="mb-4">
            <%= form.label :specialty_id, "Especialidad", class: "form-label" %>
            <%= form.select :specialty_id,
                            options_for_select(@specialties.map { |s| [s.name, s.id] }, @doctor_profile.specialty_id),
                            { include_blank: "Selecciona una especialidad" },
                            { class: "form-input form-select",
                              data: { action: "change->subspecialty#updateSubspecialties", subspecialty_target: "specialty" }, required: true } %>
          </div>

          <div>
            <%= form.label :subspecialty_id, "Subespecialidad", class: "form-label" %>
            <%= form.select :subspecialty_id,
                            options_for_select(@subspecialties.map { |s| [s.name, s.id] }, @doctor_profile.subspecialty_id),
                            { include_blank: "Selecciona una subespecialidad (opcional)" },
                            { class: "form-input form-select",
                              data: { subspecialty_target: "subspecialty" } } %>
          </div>
        </div>

        <div>
          <%= form.label :medical_license, "No. de colegiación", class: "form-label" %>
          <%= form.text_field :medical_license, placeholder: "00-00000", maxlength: 8, data: { controller: "colegiacion-mask" }, class: "form-input" %>
          <p class="form-hint">Formato: 00-00000</p>
        </div>
      </div>

      <!-- Información de Contacto -->
      <div class="md:col-span-2 mt-4">
        <h2 class="card-title">Información de Contacto</h2>
      </div>


      <div>
        <%= form.label :website, "Sitio web", class: "form-label" %>
        <%= form.text_field :website, class: "form-input" %>
      </div>


      <div>
        <%= form.label :department_id, "Departamento", class: "form-label" %>
        <%= form.select :department_id,
                        options_for_select(@departments.map { |d| [d.name, d.id] }, @doctor_profile.department_id),
                        { include_blank: "Selecciona un departamento" },
                        { class: "form-input form-select", required: true } %>
      </div>

      <div>
        <%= form.label :city_id, "Ciudad", class: "form-label" %>
        <%= form.select :city_id,
                        options_for_select(@cities.map { |c| [c.name, c.id] }, @doctor_profile.city_id),
                        { include_blank: "Selecciona una ciudad" },
                        { class: "form-input form-select", required: true } %>
      </div>

      <!-- Información Adicional -->
      <div class="md:col-span-2 mt-4">
        <h2 class="card-title">Información Adicional</h2>
      </div>

      <div class="md:col-span-2">
        <%= form.label :description, "Biografía/Descripción", class: "form-label" %>
        <%= form.text_area :description, rows: 4, class: "form-input", placeholder: "Describe tu experiencia, educación, y enfoque médico..." %>
      </div>

      <div class="md:col-span-2" data-controller="image-upload">
        <%= form.label :image_file, "Imagen de perfil", class: "form-label" %>

        <!-- Hidden file input -->
        <%= form.file_field :image_file,
            accept: "image/*",
            class: "hidden",
            data: {
              image_upload_target: "input",
              action: "change->image-upload#fileSelected"
            } %>

        <!-- Drop zone -->
        <div data-image-upload-target="dropzone"
             class="border-2 border-dashed border-line dark:border-slate-600 rounded-lg p-8 text-center cursor-pointer hover:border-primary dark:hover:border-sky-500 transition-colors"
             data-action="click->image-upload#browse">
          <svg class="mx-auto h-12 w-12 text-muted dark:text-slate-500" stroke="currentColor" fill="none" viewBox="0 0 48 48">
            <path d="M28 8H12a4 4 0 00-4 4v20m32-12v8m0 0v8a4 4 0 01-4 4H12a4 4 0 01-4-4v-4m32-4l-3.172-3.172a4 4 0 00-5.656 0L28 28M8 32l9.172-9.172a4 4 0 015.656 0L28 28m0 0l4 4m4-24h8m-4-4v8m-12 4h.02" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
          <p class="mt-2 text-sm text-muted dark:text-slate-400">
            <span class="font-semibold text-primary dark:text-sky-400">Haz clic para seleccionar</span> o arrastra una imagen aquí
          </p>
          <p class="mt-1 text-sm text-muted dark:text-slate-400">PNG, JPG, GIF hasta 5MB</p>
        </div>

        <!-- Preview -->
        <div data-image-upload-target="preview" class="hidden mt-4">
          <div class="relative inline-block">
            <img data-image-upload-target="previewImage"
                 class="w-48 h-48 object-cover rounded-lg border border-line dark:border-slate-600"
                 alt="Vista previa" />
            <button type="button"
                    data-image-upload-target="removeButton"
                    data-action="click->image-upload#removeImage"
                    class="absolute top-2 right-2 bg-red-500 text-white rounded-full p-2 hover:bg-red-600 transition-colors shadow-lg">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
              </svg>
            </button>
          </div>
          <p class="mt-2 text-sm text-muted dark:text-slate-400">
            <span class="font-medium" data-image-upload-target="fileName"></span>
          </p>
        </div>

        <p class="mt-2 text-sm text-muted dark:text-slate-400">
          La imagen se subirá a AWS S3 al crear el perfil
        </p>
      </div>
    </div>

    <div class="mt-6 flex items-center justify-end gap-3">
      <%= link_to "Cancelar", profile_path, class: "btn-secondary" %>
      <%= form.submit "Crear perfil", class: "btn-primary" %>
    </div>
  <% end %>
</div>
