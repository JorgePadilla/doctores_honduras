<div class="card p-6 mb-6" data-controller="nested-fields">
  <div class="flex flex-wrap items-center justify-between gap-y-3 mb-5 pb-4 border-b border-line dark:border-slate-700">
    <div class="flex items-center gap-3">
      <div class="w-10 h-10 rounded-lg bg-primary-soft dark:bg-sky-900/30 flex items-center justify-center text-primary dark:text-sky-400">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
        </svg>
      </div>
      <div>
        <h2 class="card-title mb-0">Capacitaciones y Certificaciones</h2>
        <p class="text-sm text-muted dark:text-slate-400">Certificados y capacitaciones obtenidas</p>
      </div>
    </div>
    <button type="button" data-action="nested-fields#add" class="btn-secondary btn-sm">
      <%= icon(:plus, class: "w-4 h-4") %>
      Agregar
    </button>
  </div>

  <template data-nested-fields-target="template">
    <div data-nested-fields-entry class="border border-line dark:border-slate-600 rounded-lg p-4 mb-4">
      <div class="flex justify-between items-start mb-3">
        <p class="text-sm font-medium text-ink dark:text-slate-200">Nueva certificación</p>
        <button type="button" data-action="nested-fields#remove" class="text-red-500 hover:text-red-700 dark:text-red-400 dark:hover:text-red-300 text-sm">Eliminar</button>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <div>
          <label class="form-label">Nombre</label>
          <input type="text" name="doctor_profile[doctor_certifications_attributes][NEW_RECORD][name]"
                 class="form-input">
        </div>
        <div>
          <label class="form-label">Institución</label>
          <input type="text" name="doctor_profile[doctor_certifications_attributes][NEW_RECORD][institution]"
                 class="form-input">
        </div>
        <div>
          <label class="form-label">Año</label>
          <input type="number" name="doctor_profile[doctor_certifications_attributes][NEW_RECORD][year]"
                 min="1950" max="<%= Date.today.year %>"
                 class="form-input">
        </div>
      </div>
    </div>
  </template>

  <div data-nested-fields-target="container">
    <% @doctor_profile.doctor_certifications.each_with_index do |certification, index| %>
      <%= form.fields_for :doctor_certifications, certification, child_index: certification.persisted? ? certification.id : index do |cf| %>
        <div data-nested-fields-entry class="border border-line dark:border-slate-600 rounded-lg p-4 mb-4">
          <div class="flex justify-between items-start mb-3">
            <p class="text-sm font-medium text-ink dark:text-slate-200">Certificación #<%= index + 1 %></p>
            <button type="button" data-action="nested-fields#remove" class="text-red-500 hover:text-red-700 dark:text-red-400 dark:hover:text-red-300 text-sm">Eliminar</button>
          </div>
          <%= cf.hidden_field :_destroy %>
          <%= cf.hidden_field :id if certification.persisted? %>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            <div>
              <label class="form-label">Nombre</label>
              <%= cf.text_field :name, class: "form-input" %>
            </div>
            <div>
              <label class="form-label">Institución</label>
              <%= cf.text_field :institution, class: "form-input" %>
            </div>
            <div>
              <label class="form-label">Año</label>
              <%= cf.number_field :year, min: 1950, max: Date.today.year, class: "form-input" %>
            </div>
          </div>
        </div>
      <% end %>
    <% end %>
  </div>
</div>
