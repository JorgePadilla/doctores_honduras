<div class="card p-6 mb-6">
  <div class="flex items-center gap-3 mb-5 pb-4 border-b border-line dark:border-slate-700">
    <div class="w-10 h-10 rounded-lg bg-primary-soft dark:bg-sky-900/30 flex items-center justify-center text-primary dark:text-sky-400">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9" />
      </svg>
    </div>
    <div>
      <h2 class="card-title mb-0">Contacto y Redes Sociales</h2>
      <p class="text-sm text-muted dark:text-slate-400">Sitio web y perfiles en redes sociales</p>
    </div>
  </div>
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    <div>
      <%= form.label :phone, "Teléfono de contacto", class: "form-label" %>
      <%= form.telephone_field :phone, class: "form-input", placeholder: "+504 2200-0000" %>
      <p class="form-hint">Número para el botón "Llamar" (teléfono fijo o celular).</p>
    </div>

    <div>
      <%= form.label :whatsapp, "WhatsApp", class: "form-label" %>
      <%= form.telephone_field :whatsapp, class: "form-input", placeholder: "+504 9999-9999" %>
      <p class="form-hint">Incluye el código de país (ej. 504) para el botón de WhatsApp.</p>
    </div>

    <div>
      <%= form.label :website, "Sitio web", class: "form-label" %>
      <%= form.url_field :website, class: "form-input", placeholder: "https://ejemplo.com" %>
    </div>

    <div>
      <%= form.label :facebook_url, "Facebook", class: "form-label" %>
      <%= form.url_field :facebook_url, class: "form-input", placeholder: "https://facebook.com/tu-perfil" %>
    </div>

    <div>
      <%= form.label :instagram_url, "Instagram", class: "form-label" %>
      <%= form.url_field :instagram_url, class: "form-input", placeholder: "https://instagram.com/tu-perfil" %>
    </div>

    <div>
      <%= form.label :twitter_url, "Twitter / X", class: "form-label" %>
      <%= form.url_field :twitter_url, class: "form-input", placeholder: "https://x.com/tu-perfil" %>
    </div>

    <div>
      <%= form.label :linkedin_url, "LinkedIn", class: "form-label" %>
      <%= form.url_field :linkedin_url, class: "form-input", placeholder: "https://linkedin.com/in/tu-perfil" %>
    </div>

    <div>
      <%= form.label :tiktok_url, "TikTok", class: "form-label" %>
      <%= form.url_field :tiktok_url, class: "form-input", placeholder: "https://tiktok.com/@tu-perfil" %>
    </div>

    <div>
      <%= form.label :youtube_url, "YouTube", class: "form-label" %>
      <%= form.url_field :youtube_url, class: "form-input", placeholder: "https://youtube.com/@tu-canal" %>
    </div>
  </div>
</div>
