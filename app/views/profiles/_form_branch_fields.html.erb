<%# Template for a single branch entry. Used both for existing records and as the template for new ones. %>
<%# When used as a template, field names use NEW_RECORD placeholder. %>
<%# When used for existing records, pass branch_form (fields_for object). %>

<div data-nested-fields-entry class="border border-line dark:border-slate-600 rounded-lg p-4 mb-4" data-controller="branch-city">
  <div class="flex justify-between items-start mb-3">
    <p class="text-sm font-medium text-ink dark:text-slate-200"><%= branch_title %></p>
    <% if paid_plan? %>
      <button type="button" data-action="nested-fields#remove" class="text-red-500 hover:text-red-700 dark:text-red-400 dark:hover:text-red-300 text-sm">Eliminar</button>
    <% end %>
  </div>

  <% if defined?(bf) && bf %>
    <%= bf.hidden_field :_destroy %>
    <%= bf.hidden_field :id if branch.persisted? %>
  <% end %>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
    <div>
      <label class="form-label">Nombre de la ubicación</label>
      <% if defined?(bf) && bf %>
        <%= bf.text_field :name, class: "form-input" %>
      <% else %>
        <input type="text" name="doctor_profile[doctor_branches_attributes][NEW_RECORD][name]"
               class="form-input">
      <% end %>
    </div>

    <div>
      <label class="form-label">Dirección</label>
      <% if defined?(bf) && bf %>
        <%= bf.text_field :address, class: "form-input" %>
      <% else %>
        <input type="text" name="doctor_profile[doctor_branches_attributes][NEW_RECORD][address]"
               class="form-input">
      <% end %>
    </div>

    <div>
      <label class="form-label">Departamento</label>
      <% if defined?(bf) && bf %>
        <%= bf.select :department_id,
                      options_for_select(@departments.map { |d| [d.name, d.id] }, branch.department_id),
                      { include_blank: "Selecciona un departamento" },
                      { class: "form-input form-select",
                        data: { branch_city_target: "department", action: "change->branch-city#loadCities" } } %>
      <% else %>
        <select name="doctor_profile[doctor_branches_attributes][NEW_RECORD][department_id]"
                class="form-input form-select"
                data-branch-city-target="department" data-action="change->branch-city#loadCities">
          <option value="">Selecciona un departamento</option>
          <% @departments.each do |d| %>
            <option value="<%= d.id %>"><%= d.name %></option>
          <% end %>
        </select>
      <% end %>
    </div>

    <div>
      <label class="form-label">Ciudad</label>
      <% if defined?(bf) && bf %>
        <%= bf.select :city_id,
                      options_for_select(
                        (branch.department&.cities || @cities).map { |c| [c.name, c.id] },
                        branch.city_id
                      ),
                      { include_blank: "Selecciona una ciudad" },
                      { class: "form-input form-select",
                        data: { branch_city_target: "city" } } %>
      <% else %>
        <select name="doctor_profile[doctor_branches_attributes][NEW_RECORD][city_id]"
                class="form-input form-select"
                data-branch-city-target="city">
          <option value="">Selecciona una ciudad</option>
        </select>
      <% end %>
    </div>

    <div>
      <label class="form-label">Enlace de mapa</label>
      <% if defined?(bf) && bf %>
        <%= bf.url_field :map_link, class: "form-input", placeholder: "https://maps.google.com/..." %>
      <% else %>
        <input type="url" name="doctor_profile[doctor_branches_attributes][NEW_RECORD][map_link]"
               class="form-input" placeholder="https://maps.google.com/...">
      <% end %>
    </div>

    <% if paid_plan? %>
      <div>
        <label class="form-label">Teléfono</label>
        <% if defined?(bf) && bf %>
          <%= bf.text_field :phone, class: "form-input" %>
        <% else %>
          <input type="text" name="doctor_profile[doctor_branches_attributes][NEW_RECORD][phone]"
                 class="form-input">
        <% end %>
      </div>

      <div>
        <label class="form-label">Pacientes simultáneos (sobrecupo)</label>
        <% if defined?(bf) && bf %>
          <%= bf.number_field :max_concurrent, min: 1, max: DoctorBranch::MAX_CONCURRENT_LIMIT, step: 1,
              class: "form-input" %>
        <% else %>
          <input type="number" min="1" max="<%= DoctorBranch::MAX_CONCURRENT_LIMIT %>" step="1" value="1"
                 name="doctor_profile[doctor_branches_attributes][NEW_RECORD][max_concurrent]"
                 class="form-input">
        <% end %>
        <p class="form-hint">Cuántos pacientes puedes atender al mismo tiempo en <strong>este consultorio</strong> (ej. 3 si tiene 3 salas). Usa 1 para no permitir sobrecupo.</p>
      </div>
    <% end %>
  </div>

  <% if paid_plan? %>
    <%# Schedule section for paid plans %>
    <div class="mt-4 border-t border-line dark:border-slate-600 pt-4">
      <h4 class="text-sm font-medium text-ink dark:text-slate-200 mb-1">Horarios de atención</h4>
      <p class="text-xs text-muted dark:text-slate-400 mb-3">Define la hora de apertura y cierre de cada día. Marca <span class="font-medium">Cerrado</span> en los días que no atiendes; esos días no aparecerán en tu perfil ni en la agenda.</p>
      <div class="space-y-2">
        <% if defined?(bf) && bf %>
          <% BranchSchedule::DAY_NAMES.each do |day_num, day_name| %>
            <% schedule = branch.branch_schedules.detect { |s| s.day_of_week == day_num } || branch.branch_schedules.build(day_of_week: day_num) %>
            <% defaults = BranchSchedule::DEFAULT_HOURS[day_num] %>
            <% unless schedule.persisted? %>
              <% schedule.opens_at ||= defaults[:opens_at] %>
              <% schedule.closes_at ||= defaults[:closes_at] %>
            <% end %>
            <%= bf.fields_for :branch_schedules, schedule, child_index: schedule.persisted? ? schedule.id : "#{day_num}_new" do |sf| %>
              <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
                <span class="w-24 text-sm text-muted dark:text-slate-400"><%= day_name %></span>
                <%= sf.hidden_field :day_of_week %>
                <%= sf.hidden_field :id if schedule.persisted? %>
                <%= sf.time_field :opens_at, class: "form-input w-auto text-sm" %>
                <span class="text-muted dark:text-slate-400">a</span>
                <%= sf.time_field :closes_at, class: "form-input w-auto text-sm" %>
                <label class="inline-flex items-center text-sm text-muted dark:text-slate-400">
                  <%= sf.check_box :_destroy, { checked: !schedule.persisted? && defaults[:closed], class: "form-check" }, "1", "0" %> <span class="ml-1">Cerrado</span>
                </label>
              </div>
            <% end %>
          <% end %>
        <% else %>
          <% BranchSchedule::DAY_NAMES.each do |day_num, day_name| %>
            <% defaults = BranchSchedule::DEFAULT_HOURS[day_num] %>
            <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
              <span class="w-24 text-sm text-muted dark:text-slate-400"><%= day_name %></span>
              <input type="hidden" name="doctor_profile[doctor_branches_attributes][NEW_RECORD][branch_schedules_attributes][<%= day_num %>][day_of_week]" value="<%= day_num %>">
              <input type="time" name="doctor_profile[doctor_branches_attributes][NEW_RECORD][branch_schedules_attributes][<%= day_num %>][opens_at]"
                     value="<%= defaults[:opens_at] %>"
                     class="form-input w-auto text-sm">
              <span class="text-muted dark:text-slate-400">a</span>
              <input type="time" name="doctor_profile[doctor_branches_attributes][NEW_RECORD][branch_schedules_attributes][<%= day_num %>][closes_at]"
                     value="<%= defaults[:closes_at] %>"
                     class="form-input w-auto text-sm">
              <% if defaults[:closed] %>
                <input type="hidden" name="doctor_profile[doctor_branches_attributes][NEW_RECORD][branch_schedules_attributes][<%= day_num %>][_destroy]" value="1">
                <label class="inline-flex items-center text-sm text-muted dark:text-slate-400">
                  <input type="checkbox" name="doctor_profile[doctor_branches_attributes][NEW_RECORD][branch_schedules_attributes][<%= day_num %>][_destroy]" value="1" checked class="form-check"> <span class="ml-1">Cerrado</span>
                </label>
              <% end %>
            </div>
          <% end %>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
