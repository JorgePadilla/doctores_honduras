<div class="card p-6 mb-6">
  <div class="flex items-center gap-3 mb-5 pb-4 border-b border-line dark:border-slate-700">
    <div class="w-10 h-10 rounded-lg bg-primary-soft dark:bg-sky-900/30 flex items-center justify-center text-primary dark:text-sky-400">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
      </svg>
    </div>
    <div>
      <h2 class="card-title mb-0">Información Personal</h2>
      <p class="text-sm text-muted dark:text-slate-400">Datos básicos de identificación</p>
    </div>
  </div>
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    <div class="md:col-span-2">
      <%= form.label :name, "Nombre completo", class: "form-label" %>
      <div class="flex gap-2">
        <%= form.select :prefix,
                    options_for_select(DoctorProfile::PREFIXES, @doctor_profile.prefix),
                    { include_blank: "Título" },
                    { class: "form-input form-select w-28" } %>
        <%= form.text_field :name, class: "form-input flex-1", required: true %>
      </div>
    </div>

    <div>
      <%= form.label :fecha_de_nacimiento, "Fecha de nacimiento", class: "form-label" %>
      <%= form.text_field :fecha_de_nacimiento,
            value: @doctor_profile.fecha_de_nacimiento&.to_s,
            data: { controller: "datepicker", datepicker_mode_value: "past" },
            placeholder: "Selecciona una fecha",
            autocomplete: "off",
            class: "form-input" %>
    </div>

    <div>
      <%= form.label :numero_de_identidad, "Número de identidad", class: "form-label" %>
      <%= form.text_field :numero_de_identidad, class: "form-input" %>
    </div>

    <div>
      <%= form.label :correo_personal, "Correo personal", class: "form-label" %>
      <%= form.email_field :correo_personal, class: "form-input" %>
    </div>
  </div>
</div>
