<div class="card p-6 mb-6">
  <div class="flex items-center gap-3 mb-5 pb-4 border-b border-line dark:border-slate-700">
    <div class="w-10 h-10 rounded-lg bg-primary-soft dark:bg-sky-900/30 flex items-center justify-center text-primary dark:text-sky-400">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
      </svg>
    </div>
    <div>
      <h2 class="card-title mb-0">Idiomas</h2>
      <p class="text-sm text-muted dark:text-slate-400">Idiomas en los que atiendes pacientes</p>
    </div>
  </div>
  <div class="flex flex-wrap gap-4">
    <% DoctorProfile::AVAILABLE_LANGUAGES.each do |language| %>
      <label class="inline-flex items-center">
        <%= form.check_box :languages, { multiple: true, checked: @doctor_profile.languages&.include?(language), class: "form-check" }, language, nil %>
        <span class="ml-2 text-sm text-ink dark:text-slate-300"><%= language %></span>
      </label>
    <% end %>
  </div>
</div>
