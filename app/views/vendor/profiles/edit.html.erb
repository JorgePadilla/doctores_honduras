<div class="max-w-3xl mx-auto">
  <%= render "shared/page_header", title: "Editar Perfil de Proveedor" %>

  <%= form_with model: @supplier, url: vendor_profile_path, method: :patch, class: "space-y-6" do |f| %>
    <%= render "shared/form_errors", model: @supplier %>

    <%= render "shared/image_upload_field",
        form: f,
        attr: :logo_file,
        current_url: @supplier.logo_url,
        title: "Logo de la empresa",
        subtitle: "PNG, JPG o WebP hasta 5MB" %>

    <div class="card p-6 space-y-6">
      <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
        <div>
          <%= f.label :name, "Nombre de la empresa", class: "form-label" %>
          <%= f.text_field :name, class: "form-input", required: true %>
        </div>
        <div>
          <%= f.label :phone, "Teléfono", class: "form-label" %>
          <%= f.telephone_field :phone, class: "form-input", required: true %>
        </div>
        <div>
          <%= f.label :email, "Email", class: "form-label" %>
          <%= f.email_field :email, class: "form-input" %>
        </div>
        <div>
          <%= f.label :website, "Sitio web", class: "form-label" %>
          <%= f.url_field :website, class: "form-input" %>
        </div>
        <div>
          <%= f.label :category, "Categoría", class: "form-label" %>
          <%= f.select :category,
                      options_for_select([
                        ["Equipos Médicos", "equipos_medicos"],
                        ["Suministros Médicos", "suministros_medicos"],
                        ["Farmacéuticos", "farmaceuticos"],
                        ["Tecnología Médica", "tecnologia_medica"],
                        ["Mobiliario Hospitalario", "mobiliario_hospitalario"],
                        ["Otro", "otro"]
                      ], @supplier.category),
                      { include_blank: "Selecciona una categoría" },
                      { class: "form-input form-select" } %>
        </div>
        <div>
          <%= f.label :address, "Dirección", class: "form-label" %>
          <%= f.text_field :address, class: "form-input" %>
        </div>
        <div>
          <%= f.label :department_id, "Departamento", class: "form-label" %>
          <%= f.select :department_id,
                      options_for_select(@departments.map { |d| [d.name, d.id] }, @supplier.department_id),
                      { include_blank: "Selecciona un departamento" },
                      { class: "form-input form-select" } %>
        </div>
        <div>
          <%= f.label :city_id, "Ciudad", class: "form-label" %>
          <%= f.select :city_id,
                      options_for_select(@cities.map { |c| [c.name, c.id] }, @supplier.city_id),
                      { include_blank: "Selecciona una ciudad" },
                      { class: "form-input form-select" } %>
        </div>
      </div>

      <div>
        <%= f.label :description, "Descripción", class: "form-label" %>
        <%= f.text_area :description, rows: 4, class: "form-input" %>
      </div>
    </div>

    <div class="mt-6 flex items-center justify-end gap-3">
      <%= link_to "Cancelar", vendor_profile_path, class: "btn-secondary" %>
      <%= f.submit "Guardar cambios", class: "btn-primary" %>
    </div>
  <% end %>
</div>
