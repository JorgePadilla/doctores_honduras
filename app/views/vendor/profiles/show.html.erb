<% actions = capture do %>
  <%= link_to "Editar perfil", edit_vendor_profile_path, class: "btn-secondary" %>
<% end %>

<div class="max-w-3xl mx-auto">
  <%= render "shared/page_header", title: "Mi Perfil de Proveedor", actions: actions %>

  <div class="card p-6">
    <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
      <div>
        <p class="text-sm text-muted dark:text-slate-400">Nombre de la empresa</p>
        <p class="font-medium text-ink dark:text-white"><%= @supplier.name %></p>
      </div>
      <div>
        <p class="text-sm text-muted dark:text-slate-400">Teléfono</p>
        <p class="font-medium text-ink dark:text-white"><%= @supplier.phone || "No especificado" %></p>
      </div>
      <div>
        <p class="text-sm text-muted dark:text-slate-400">Categoría</p>
        <p class="font-medium text-ink dark:text-white"><%= @supplier.category&.humanize || "No especificada" %></p>
      </div>
      <div>
        <p class="text-sm text-muted dark:text-slate-400">Email</p>
        <p class="font-medium text-ink dark:text-white"><%= @supplier.email || "No especificado" %></p>
      </div>
      <div>
        <p class="text-sm text-muted dark:text-slate-400">Sitio web</p>
        <p class="font-medium text-ink dark:text-white"><%= @supplier.website || "No especificado" %></p>
      </div>
      <div>
        <p class="text-sm text-muted dark:text-slate-400">Dirección</p>
        <p class="font-medium text-ink dark:text-white"><%= @supplier.address || "No especificada" %></p>
      </div>
    </div>

    <% if @supplier.description.present? %>
      <div class="mt-6">
        <p class="text-sm text-muted dark:text-slate-400">Descripción</p>
        <p class="text-ink dark:text-white mt-1"><%= @supplier.description %></p>
      </div>
    <% end %>
  </div>
</div>
