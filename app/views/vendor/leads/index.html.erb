<div class="max-w-6xl mx-auto">
  <%= render "shared/page_header", title: "Contactos Recibidos" %>

  <% if @leads.any? %>
    <div class="card overflow-hidden">
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-line dark:divide-slate-700">
          <thead class="bg-slate-50 dark:bg-slate-700/50">
            <tr>
              <th class="px-6 py-3 text-left text-sm font-medium text-muted uppercase tracking-wider">Nombre</th>
              <th class="px-6 py-3 text-left text-sm font-medium text-muted uppercase tracking-wider">Email</th>
              <th class="px-6 py-3 text-left text-sm font-medium text-muted uppercase tracking-wider">Organización</th>
              <th class="px-6 py-3 text-left text-sm font-medium text-muted uppercase tracking-wider">Estado</th>
              <th class="px-6 py-3 text-left text-sm font-medium text-muted uppercase tracking-wider">Fecha</th>
              <th class="px-6 py-3 text-right text-sm font-medium text-muted uppercase tracking-wider">Ver</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-line dark:divide-slate-700">
            <% @leads.each do |lead| %>
              <tr class="hover:bg-slate-50 dark:hover:bg-slate-700/50 transition-colors">
                <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-ink dark:text-white"><%= lead.name %></td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-muted dark:text-slate-400"><%= lead.email %></td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-muted dark:text-slate-400"><%= lead.organization || "-" %></td>
                <td class="px-6 py-4 whitespace-nowrap">
                  <% case lead.status %>
                  <% when "new" %>
                    <span class="px-2.5 py-0.5 inline-flex text-sm leading-5 font-semibold rounded-full bg-sky-100 dark:bg-sky-900/30 text-sky-800 dark:text-sky-300">Nuevo</span>
                  <% when "contacted" %>
                    <span class="px-2.5 py-0.5 inline-flex text-sm leading-5 font-semibold rounded-full bg-yellow-100 dark:bg-yellow-900/30 text-yellow-800 dark:text-yellow-300">Contactado</span>
                  <% when "converted" %>
                    <span class="px-2.5 py-0.5 inline-flex text-sm leading-5 font-semibold rounded-full bg-green-100 dark:bg-green-900/30 text-green-800 dark:text-green-300">Convertido</span>
                  <% end %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-muted dark:text-slate-400"><%= lead.created_at.strftime("%d/%m/%Y") %></td>
                <td class="px-6 py-4 whitespace-nowrap">
                  <div class="flex items-center justify-end">
                    <%= link_to "Ver", vendor_lead_path(lead), class: "btn-secondary btn-sm" %>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  <% else %>
    <div class="card p-8 text-center">
      <%= icon(:envelope, class: "w-12 h-12 mx-auto text-slate-300 dark:text-slate-600") %>
      <p class="mt-3 text-muted dark:text-slate-400">Aún no has recibido contactos.</p>
    </div>
  <% end %>
</div>
