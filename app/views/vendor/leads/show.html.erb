<div class="max-w-3xl mx-auto">
  <%= render "shared/page_header", title: "Detalle del Contacto", back: { label: "Volver", path: vendor_leads_path } %>

  <div class="card p-6 space-y-6">
    <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
      <div>
        <p class="text-sm text-muted dark:text-slate-400">Nombre</p>
        <p class="font-medium text-ink dark:text-white"><%= @lead.name %></p>
      </div>
      <div>
        <p class="text-sm text-muted dark:text-slate-400">Email</p>
        <p class="font-medium text-ink dark:text-white"><%= @lead.email %></p>
      </div>
      <div>
        <p class="text-sm text-muted dark:text-slate-400">Teléfono</p>
        <p class="font-medium text-ink dark:text-white"><%= @lead.phone || "No proporcionado" %></p>
      </div>
      <div>
        <p class="text-sm text-muted dark:text-slate-400">Organización</p>
        <p class="font-medium text-ink dark:text-white"><%= @lead.organization || "No proporcionada" %></p>
      </div>
      <div>
        <p class="text-sm text-muted dark:text-slate-400">Fecha</p>
        <p class="font-medium text-ink dark:text-white"><%= @lead.created_at.strftime("%d/%m/%Y %H:%M") %></p>
      </div>
    </div>

    <% if @lead.message.present? %>
      <div>
        <p class="text-sm text-muted dark:text-slate-400">Mensaje</p>
        <p class="text-ink dark:text-white mt-1 bg-slate-50 dark:bg-slate-700/50 p-3 rounded-lg"><%= @lead.message %></p>
      </div>
    <% end %>

    <div class="border-t border-line dark:border-slate-700 pt-4">
      <p class="text-sm text-muted dark:text-slate-400 mb-2">Actualizar estado</p>
      <%= form_with model: @lead, url: vendor_lead_path(@lead), method: :patch, class: "flex items-center gap-3" do |f| %>
        <%= f.select :status,
                    options_for_select([["Nuevo", "new"], ["Contactado", "contacted"], ["Convertido", "converted"]], @lead.status),
                    {},
                    { class: "form-input form-select w-auto" } %>
        <%= f.submit "Actualizar estado", class: "btn-primary" %>
      <% end %>
    </div>
  </div>
</div>
