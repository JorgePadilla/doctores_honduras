<%= form_with model: product, url: url, method: method, class: "space-y-6" do |f| %>
  <%= render "shared/form_errors", model: product %>

  <div class="card p-6 space-y-6">
    <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
      <div>
        <%= f.label :name, "Nombre del producto", class: "form-label" %>
        <%= f.text_field :name, class: "form-input", required: true %>
      </div>
      <div>
        <%= f.label :sku, "SKU", class: "form-label" %>
        <%= f.text_field :sku, class: "form-input", required: true %>
      </div>
      <div>
        <%= f.label :category, "Categoría", class: "form-label" %>
        <%= f.select :category,
                    options_for_select([
                      "Cuidado del Diabético",
                      "Cuidado en Casa",
                      "Equipo Diagnóstico",
                      "Rehabilitación",
                      "Fisioterapia",
                      "Movilidad",
                      "Terapia para Varices",
                      "Terapia Respiratoria"
                    ], product.category),
                    { include_blank: "Selecciona una categoría" },
                    { class: "form-input form-select", required: true } %>
      </div>
      <div>
        <%= f.label :price, "Precio (USD)", class: "form-label" %>
        <%= f.number_field :price, step: 0.01, min: 0, class: "form-input" %>
      </div>
      <div class="flex items-center pt-8">
        <label class="inline-flex items-center gap-2">
          <%= f.check_box :active, class: "form-check" %>
          <span class="text-sm text-ink dark:text-slate-300">Activo</span>
        </label>
      </div>
    </div>

    <div>
      <%= f.label :description, "Descripción", class: "form-label" %>
      <%= f.text_area :description, rows: 3, class: "form-input" %>
    </div>
  </div>

  <%= render "shared/image_upload_field",
      form: f,
      attr: :image_file,
      current_url: product.image_url,
      title: "Imagen del producto",
      subtitle: "PNG, JPG o WebP hasta 5MB" %>

  <div class="mt-6 flex items-center justify-end gap-3">
    <%= link_to "Cancelar", vendor_products_path, class: "btn-secondary" %>
    <%= f.submit class: "btn-primary" %>
  </div>
<% end %>
