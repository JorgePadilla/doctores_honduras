<% unless product_limit_reached? %>
  <% actions = capture do %>
    <%= link_to new_vendor_product_path, class: "btn-primary" do %>
      <%= icon(:plus, class: "w-4 h-4") %> Nuevo producto
    <% end %>
  <% end %>
<% end %>

<div class="max-w-6xl mx-auto">
  <%= render "shared/page_header", title: "Mis Productos", actions: actions %>

  <% unless paid_plan? %>
    <div class="mb-6 rounded-xl border border-yellow-200 bg-yellow-50 p-4 dark:border-yellow-800 dark:bg-yellow-900/20">
      <p class="text-sm text-yellow-800 dark:text-yellow-300">
        Plan gratuito: <%= current_supplier.products.count %>/5 productos.
        <%= link_to "Actualizar plan", settings_subscription_path, class: "font-medium underline" %> para productos ilimitados.
      </p>
    </div>
  <% end %>

  <% if @products.any? %>
    <div class="card overflow-hidden">
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-line dark:divide-slate-700">
          <thead class="bg-slate-50 dark:bg-slate-700/50">
            <tr>
              <th class="px-6 py-3 text-left text-sm font-medium text-muted uppercase tracking-wider">Producto</th>
              <th class="px-6 py-3 text-left text-sm font-medium text-muted uppercase tracking-wider">SKU</th>
              <th class="px-6 py-3 text-left text-sm font-medium text-muted uppercase tracking-wider">Categoría</th>
              <th class="px-6 py-3 text-left text-sm font-medium text-muted uppercase tracking-wider">Precio</th>
              <th class="px-6 py-3 text-left text-sm font-medium text-muted uppercase tracking-wider">Estado</th>
              <th class="px-6 py-3 text-right text-sm font-medium text-muted uppercase tracking-wider">Acciones</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-line dark:divide-slate-700">
            <% @products.each do |product| %>
              <tr class="hover:bg-slate-50 dark:hover:bg-slate-700/50 transition-colors">
                <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-ink dark:text-white"><%= product.name %></td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-muted dark:text-slate-400"><%= product.sku %></td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-muted dark:text-slate-400"><%= product.category %></td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-muted dark:text-slate-400">$<%= number_with_precision(product.price, precision: 2) %></td>
                <td class="px-6 py-4 whitespace-nowrap">
                  <% if product.active? %>
                    <span class="px-2.5 py-0.5 inline-flex text-sm leading-5 font-semibold rounded-full bg-green-100 dark:bg-green-900/30 text-green-800 dark:text-green-300">Activo</span>
                  <% else %>
                    <span class="px-2.5 py-0.5 inline-flex text-sm leading-5 font-semibold rounded-full bg-slate-100 dark:bg-slate-600 text-slate-700 dark:text-slate-300">Inactivo</span>
                  <% end %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                  <div class="flex items-center justify-end gap-2">
                    <%= link_to "Editar", edit_vendor_product_path(product), class: "btn-secondary btn-sm" %>
                    <%= button_to "Eliminar", vendor_product_path(product), method: :delete, class: "btn-danger btn-sm", data: { turbo_confirm: "¿Eliminar este producto?" } %>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  <% else %>
    <div class="card p-8 text-center">
      <%= icon(:cube, class: "w-12 h-12 mx-auto text-slate-300 dark:text-slate-600") %>
      <p class="mt-3 mb-4 text-muted dark:text-slate-400">Aún no tienes productos registrados.</p>
      <%= link_to new_vendor_product_path, class: "btn-primary" do %>
        <%= icon(:plus, class: "w-4 h-4") %> Agregar primer producto
      <% end %>
    </div>
  <% end %>
</div>
