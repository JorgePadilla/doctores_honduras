<div class="container mx-auto px-4 py-8">
  <header class="text-center mb-10">
    <h1 class="page-title mb-3">Proveedores médicos</h1>
    <p class="text-lg text-slate-600 dark:text-slate-400">Equipos y suministros médicos en Honduras.</p>
  </header>

  <div class="max-w-5xl mx-auto mb-8">
    <div class="flex items-center gap-2 bg-white dark:bg-slate-800 rounded-full border border-line dark:border-slate-700 shadow-[0_12px_32px_-8px_rgb(11_18_32_/_0.14)] p-2 pl-5">
      <%= icon(:magnifying_glass, class: "w-5 h-5 text-primary shrink-0") %>
      <form action="/proveedores" method="get" class="flex flex-1 items-center gap-2">
        <input type="text" name="q" value="<%= params[:q] %>" placeholder="Busca por nombre o tipo de producto"
               class="flex-1 min-w-0 bg-transparent border-0 focus:ring-0 focus:outline-none text-ink dark:text-white placeholder:text-muted py-2 text-base">
        <button type="submit" class="shrink-0 inline-flex items-center bg-primary-hover hover:bg-primary-deep text-white font-semibold rounded-full px-6 py-3 transition-colors">
          Buscar
        </button>
      </form>
    </div>
  </div>

  <div class="max-w-6xl mx-auto">
    <% if @suppliers.any? %>
      <div class="grid gap-6 sm:grid-cols-2 xl:grid-cols-3">
        <% @suppliers.each_with_index do |supplier, index| %>
          <%= render "supplier_card", supplier: supplier, index: index %>
        <% end %>
      </div>
    <% else %>
      <div class="rounded-2xl border border-line dark:border-slate-700 bg-white dark:bg-slate-800 p-10 text-center">
        <p class="text-slate-600 dark:text-slate-400">No encontramos proveedores. Probá con otra búsqueda.</p>
      </div>
    <% end %>

    <!-- Pagination controls -->
    <% if @total_pages > 1 %>
      <div class="mt-10 mb-6 flex justify-center">
        <nav class="rounded-lg" aria-label="Pagination">
          <%= pagination_links(@page, @total_pages, { q: params[:q] }) %>
        </nav>
      </div>
    <% end %>
  </div>
</div>
