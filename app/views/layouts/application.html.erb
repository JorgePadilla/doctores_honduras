<!DOCTYPE html>
<html lang="<%= I18n.locale %>" data-controller="dark-mode">
  <head>
    <title><%= content_for(:title) || "Doctores Honduras - Doctores Hospitales y Clínicas" %></title>
    <meta charset="utf-8">
    <%# Marca que JS está activo antes del primer paint (para gatear el reveal sin flash). %>
    <script>document.documentElement.classList.add('js')</script>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="view-transition" content="same-origin">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">

    <!-- Fuentes del rediseño (DESIGN.md): Bricolage Grotesque + Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400..700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    
    <!-- SEO Meta Tags -->
    <meta name="description" content="<%= content_for(:meta_description) || 'Directorio de médicos y establecimientos de salud en Honduras. Encuentra especialistas, hospitales y clínicas cerca de ti.' %>">
    <meta name="keywords" content="<%= content_for(:meta_keywords) || 'médicos, doctores, hospitales, clínicas, salud, Honduras, especialistas' %>">
    <meta name="author" content="Doctores Honduras">
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website">
    <meta property="og:url" content="<%= request.original_url %>">
    <meta property="og:title" content="<%= content_for(:title) || 'Doctores Honduras' %>">
    <meta property="og:description" content="<%= content_for(:meta_description) || 'Directorio de médicos y establecimientos de salud en Honduras' %>">
    <meta property="og:image" content="<%= content_for(:og_image) || asset_path('og-image.jpg') %>">
    
    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image">
    <meta property="twitter:url" content="<%= request.original_url %>">
    <meta property="twitter:title" content="<%= content_for(:title) || 'Doctores Honduras' %>">
    <meta property="twitter:description" content="<%= content_for(:meta_description) || 'Directorio de médicos y establecimientos de salud en Honduras' %>">
    <meta property="twitter:image" content="<%= content_for(:og_image) || asset_path('og-image.jpg') %>">
    
    <!-- Canonical URL -->
    <link rel="canonical" href="<%= content_for(:canonical_url) || request.original_url %>">
    
    <!-- Alternate language versions -->
    <link rel="alternate" hreflang="es" href="<%= url_for(locale: :es) %>">
    <link rel="alternate" hreflang="en" href="<%= url_for(locale: :en) %>">
    <link rel="alternate" hreflang="x-default" href="<%= url_for(locale: :es) %>">
    
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Flatpickr datepicker CSS %>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr@4.6.13/dist/flatpickr.min.css">

    <%# Include Tailwind CSS %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>

    <%# Ahoy.js (classic, same-origin) — tracks the visit and exposes window.ahoy for click events %>
    <%= javascript_include_tag "ahoy", defer: true %>
  </head>

  <body class="min-h-screen flex flex-col bg-gray-50 dark:bg-slate-900 dark:text-slate-100 transition-colors duration-200"
        data-controller="command-palette" data-command-palette-url-value="<%= quick_search_doctors_path %>">
    <%= render "shared/navbar" %>

    <%# Paleta de comandos ⌘K (global). %>
    <div data-command-palette-target="overlay" data-action="click->command-palette#backdropClose"
         class="fixed inset-0 z-[100] hidden items-start justify-center bg-ink/40 dark:bg-black/60 backdrop-blur-sm p-4 pt-[12vh]">
      <div data-command-palette-target="panel" class="cmdk-panel w-full max-w-xl overflow-hidden rounded-2xl border border-line dark:border-slate-700 bg-white dark:bg-slate-800 shadow-2xl">
        <div class="flex items-center gap-3 border-b border-line dark:border-slate-700 px-4">
          <%= icon(:magnifying_glass, class: "w-5 h-5 text-muted shrink-0") %>
          <input type="text" data-command-palette-target="input"
                 data-action="input->command-palette#search keydown->command-palette#nav"
                 placeholder="Busca doctores, especialidades o procedimientos…" autocomplete="off"
                 class="flex-1 bg-transparent py-4 text-base text-ink dark:text-white placeholder:text-muted focus:outline-none">
          <kbd class="hidden sm:block rounded border border-line dark:border-slate-600 px-1.5 py-0.5 text-xs text-muted">Esc</kbd>
        </div>
        <div data-command-palette-target="results" class="max-h-[55vh] overflow-y-auto p-2"></div>
        <div class="flex items-center gap-4 border-t border-line dark:border-slate-700 px-4 py-2 text-xs text-muted">
          <span>↑↓ navegar</span><span>↵ abrir</span><span class="ml-auto">Buscador rápido</span>
        </div>
      </div>
    </div>
    
    <%= render "shared/flash" %>
    
    <main class="container mx-auto px-4 py-8 grow w-full">
      <%= yield %>
    </main>

    <footer class="bg-primary-deep dark:bg-slate-950 text-white">
      <div class="container mx-auto px-4 py-14">
        <div class="grid gap-10 md:grid-cols-12">
          <div class="md:col-span-5 max-w-sm">
            <a href="/" class="font-display text-xl font-bold tracking-tight text-white hover:text-sky-200 transition-colors">Doctores Honduras</a>
            <p class="mt-3 text-sm leading-relaxed text-sky-100/70">Directorio médico de Honduras. Encontrá al especialista que buscás y agendá tu cita.</p>
          </div>
          <nav class="md:col-span-3 md:col-start-8 flex flex-col gap-2.5 text-sm">
            <span class="text-xs font-semibold uppercase tracking-wider text-sky-100/50 mb-1">Explorar</span>
            <%= link_to "Doctores", doctors_path, class: "text-sky-100/80 hover:text-white transition-colors w-fit" %>
            <% if section_visible?("establishments") %>
              <%= link_to "Hospitales y Clínicas", establishments_path, class: "text-sky-100/80 hover:text-white transition-colors w-fit" %>
            <% end %>
            <% if section_visible?("suppliers") %>
              <%= link_to "Proveedores", suppliers_path, class: "text-sky-100/80 hover:text-white transition-colors w-fit" %>
            <% end %>
          </nav>
          <nav class="md:col-span-2 flex flex-col gap-2.5 text-sm">
            <span class="text-xs font-semibold uppercase tracking-wider text-sky-100/50 mb-1">Contacto</span>
            <a href="mailto:info@doctoreshonduras.com" class="text-sky-100/80 hover:text-white transition-colors w-fit">info@doctoreshonduras.com</a>
          </nav>
        </div>
        <div class="mt-12 pt-6 border-t border-white/10 flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between text-xs text-sky-100/50">
          <span>&copy; <%= Date.current.year %> Doctores Honduras</span>
          <span class="inline-flex items-center gap-1">Hecho con <span class="heartbeat text-red-400"><%= icon(:heart, class: "w-4 h-4", fill: "currentColor", "stroke-width": "0") %></span> en Honduras</span>
        </div>
      </div>
    </footer>
  </body>
</html>
