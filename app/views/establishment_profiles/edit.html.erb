<div class="max-w-3xl mx-auto">
  <% actions = capture do %>
    <% if section_visible?("establishments") && @establishment.present? %>
      <%= link_to "Ver página pública", establishment_path(@establishment), class: "btn-secondary btn-sm" %>
    <% end %>
  <% end %>
  <%= render "shared/page_header", title: "Editar Establecimiento", actions: actions %>

  <%= form_with model: @establishment, url: establishment_profile_path, method: :patch, class: "space-y-6" do |f| %>
    <%= render "shared/form_errors", model: @establishment %>

    <%= render "shared/image_upload_field",
        form: f,
        attr: :logo_file,
        current_url: @establishment.logo_url,
        title: "Logo",
        subtitle: "Logotipo del establecimiento — PNG, JPG o WebP hasta 5MB" %>

    <%= render "shared/image_upload_field",
        form: f,
        attr: :building_image_file,
        current_url: @establishment.building_image_url,
        title: "Foto del edificio",
        subtitle: "Fotografía de la fachada — PNG, JPG o WebP hasta 5MB" %>

    <div class="card p-6">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div>
          <%= f.label :name, "Nombre", class: "form-label" %>
          <%= f.text_field :name, class: "form-input", required: true %>
        </div>
        <div>
          <%= f.label :phone, "Teléfono", class: "form-label" %>
          <%= f.telephone_field :phone, class: "form-input" %>
        </div>
        <div>
          <%= f.label :email, "Email", class: "form-label" %>
          <%= f.email_field :email, class: "form-input" %>
        </div>
        <div>
          <%= f.label :website, "Sitio web", class: "form-label" %>
          <%= f.url_field :website, class: "form-input" %>
        </div>
        <div class="md:col-span-2">
          <%= f.label :address, "Dirección", class: "form-label" %>
          <%= f.text_field :address, class: "form-input", required: true %>
        </div>
        <div class="md:col-span-2">
          <%= f.label :map_link, "Enlace de mapa (Google Maps)", class: "form-label" %>
          <%= f.url_field :map_link, class: "form-input" %>
        </div>
        <div>
          <%= f.label :department_id, "Departamento", class: "form-label" %>
          <%= f.select :department_id,
                      options_for_select(@departments.map { |d| [d.name, d.id] }, @establishment.department_id),
                      { include_blank: "Selecciona un departamento" },
                      { class: "form-input form-select" } %>
        </div>
        <div>
          <%= f.label :city_id, "Ciudad", class: "form-label" %>
          <%= f.select :city_id,
                      options_for_select(@cities.map { |c| [c.name, c.id] }, @establishment.city_id),
                      { include_blank: "Selecciona una ciudad" },
                      { class: "form-input form-select" } %>
        </div>
        <div class="md:col-span-2">
          <%= f.label :description, "Descripción", class: "form-label" %>
          <%= f.text_area :description, rows: 4, class: "form-input" %>
        </div>
      </div>
    </div>

    <div class="mt-6 flex items-center justify-end gap-3">
      <%= link_to "Cancelar", dashboard_path, class: "btn-secondary" %>
      <%= f.submit "Guardar cambios", class: "btn-primary" %>
    </div>
  <% end %>
</div>
