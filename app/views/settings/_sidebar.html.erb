<div class="bg-white dark:bg-slate-800 rounded-xl shadow-md dark:shadow-slate-900/50 p-4 border-l-4 border-l-sky-300 dark:border-l-sky-500">
  <nav class="space-y-1">
    <%
      items = [
        { path: settings_path,              icon: :squares_2x2, label: "Resumen",     key: "resumen" },
        { path: settings_subscription_path, icon: :credit_card, label: "Suscripción", key: "subscription" },
        { path: settings_security_path,     icon: :lock_closed, label: "Seguridad",   key: "security" },
        { path: settings_preferences_path,  icon: :bell,        label: "Preferencias", key: "preferences" },
      ]
    %>
    <% items.each do |item| %>
      <% active = item[:key] == local_assigns[:current] %>
      <%= link_to item[:path], class: "flex items-center gap-2 px-3 py-2 rounded-md text-sm #{active ? 'bg-sky-100 dark:bg-sky-900/30 text-sky-700 dark:text-sky-400 font-medium' : 'text-gray-700 dark:text-slate-300 hover:bg-gray-50 dark:hover:bg-slate-700 hover:text-gray-900 dark:hover:text-white'}" do %>
        <%= icon(item[:icon], class: "w-5 h-5 shrink-0") %>
        <span><%= item[:label] %></span>
      <% end %>
    <% end %>
  </nav>
</div>
