<div class="max-w-6xl mx-auto">
  <%= render "shared/page_header", title: "Mi cuenta", subtitle: "Administra tu suscripción y facturación" %>
  <%= render "settings/nav", active: :subscription %>

  <div class="space-y-6">
    <%# Plan actual %>
    <div class="card p-6">
      <h2 class="card-title">Plan Actual</h2>
      <% if @subscription && @subscription.active? %>
        <div class="flex justify-between items-center">
          <div>
            <p class="text-ink dark:text-white font-medium"><%= @subscription.plan_name %></p>
            <p class="text-muted dark:text-slate-400 text-sm">Renovación: <%= @subscription.current_period_end&.strftime("%d/%m/%Y") || "N/A" %></p>
          </div>
          <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-sm font-medium bg-green-100 dark:bg-green-900/30 text-green-800 dark:text-green-300">
            Activo
          </span>
        </div>
      <% else %>
        <div class="flex justify-between items-center">
          <div>
            <p class="text-ink dark:text-white font-medium">Plan Gratuito</p>
            <p class="text-muted dark:text-slate-400 text-sm">Perfil sin aparecer en el directorio</p>
          </div>
          <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-sm font-medium bg-gray-100 dark:bg-slate-600 text-gray-800 dark:text-slate-300">
            Activo
          </span>
        </div>
      <% end %>
    </div>

    <%# Planes disponibles %>
    <div>
      <h2 class="card-title">Planes Disponibles</h2>

      <%# Plan recomendado: el de pago más barato. %>
      <% recommended = @plans&.select { |p| p.price.to_i > 0 }&.min_by(&:price) %>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-5 items-stretch pt-3">
        <% @plans&.each do |plan| %>
          <%= render "settings/plan_card", plan: plan,
                current: @subscription&.subscription_plan_id == plan.id,
                recommended: plan == recommended %>
        <% end %>
      </div>
    </div>

    <% if @subscription&.active? %>
      <div class="card card-accent border-l-red-400 dark:border-l-red-500 p-6">
        <h3 class="text-lg font-semibold text-red-600 dark:text-red-400 mb-2">Cancelar Suscripción</h3>
        <p class="text-muted dark:text-slate-400 mb-4">Al cancelar tu suscripción, seguirás teniendo acceso a las características premium hasta el final del período de facturación actual.</p>
        <%= button_to settings_cancel_subscription_path, method: :delete, class: "btn-danger", data: { confirm: "¿Estás seguro de que deseas cancelar tu suscripción?" } do %>
          Cancelar Suscripción
        <% end %>
      </div>
    <% end %>
  </div>
</div>

<!-- Target for Stripe redirect -->
<div id="stripe_redirect"></div>
