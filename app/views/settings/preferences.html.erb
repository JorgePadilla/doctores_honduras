<div class="max-w-6xl mx-auto">
  <%= render "shared/page_header", title: "Mi cuenta", subtitle: "Preferencias" %>
  <%= render "settings/nav", active: :preferences %>

  <div class="space-y-6">
    <%# Notificaciones %>
    <div class="card p-6">
      <h2 class="card-title">Notificaciones por correo</h2>
      <%= form_with model: @notification_preferences, url: settings_notifications_path, method: :patch, class: "space-y-6" do |f| %>
        <div class="space-y-4">
          <% [
            [:email_notifications, "Notificaciones por correo electrónico", "Recibe notificaciones importantes por correo electrónico."],
            [:marketing_emails, "Correos de marketing", "Recibe información sobre promociones y ofertas especiales."],
            [:new_features_notifications, "Nuevas características", "Recibe notificaciones cuando se añadan nuevas características a la plataforma."],
            [:security_alerts, "Alertas de seguridad", "Recibe alertas importantes relacionadas con la seguridad de tu cuenta."],
          ].each do |field, label, hint| %>
            <div class="flex items-start">
              <div class="flex items-center h-5">
                <%= f.check_box field, class: "form-check" %>
              </div>
              <div class="ml-3 text-sm">
                <%= f.label field, label, class: "font-medium text-ink dark:text-slate-300" %>
                <p class="text-muted dark:text-slate-400"><%= hint %></p>
              </div>
            </div>
          <% end %>
        </div>
        <div class="flex justify-end">
          <%= f.submit "Guardar notificaciones", class: "btn-primary" %>
        </div>
      <% end %>
    </div>

    <%# Idioma %>
    <div class="card p-6">
      <h2 class="card-title">Idioma</h2>
      <%= form_with model: @user, url: settings_language_path, method: :patch, class: "space-y-6" do |f| %>
        <div class="max-w-md">
          <%= f.label :language, "Selecciona tu idioma preferido", class: "form-label" %>
          <%= f.select :language,
                options_for_select([ [ "Español", "es" ], [ "English", "en" ] ], @user.language),
                {},
                { class: "form-input form-select" } %>
          <p class="form-hint">Este idioma se utilizará en toda la plataforma.</p>
        </div>
        <div class="flex justify-end">
          <%= f.submit "Guardar idioma", class: "btn-primary" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
