<div class="max-w-6xl mx-auto">
  <%= render "shared/page_header", title: "Mi cuenta", subtitle: "Seguridad de la cuenta" %>
  <%= render "settings/nav", active: :security %>

  <div class="space-y-6">
    <%# Cambiar contraseña %>
    <div class="card p-6">
      <h2 class="card-title">Cambiar Contraseña</h2>

      <%= form_with url: settings_password_path, method: :patch, class: "space-y-6" do |f| %>
        <div class="max-w-md space-y-6">
          <div>
            <%= f.label :current_password, "Contraseña actual", class: "form-label" %>
            <%= f.password_field :current_password, autocomplete: "current-password", class: "form-input" %>
          </div>

          <div>
            <%= f.label :password, "Nueva contraseña", class: "form-label" %>
            <%= f.password_field :password, autocomplete: "new-password", class: "form-input" %>
            <p class="form-hint">Mínimo 8 caracteres.</p>
          </div>

          <div>
            <%= f.label :password_confirmation, "Confirmar nueva contraseña", class: "form-label" %>
            <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "form-input" %>
          </div>
        </div>

        <div class="flex justify-end">
          <%= f.submit "Cambiar contraseña", class: "btn-primary" %>
        </div>
      <% end %>
    </div>

    <%# Autenticación de dos factores (próximamente) %>
    <div class="card p-6">
      <div class="flex flex-wrap items-center gap-3 mb-2">
        <h2 class="text-lg font-semibold text-ink dark:text-white">Autenticación de Dos Factores</h2>
        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-sky-100 dark:bg-sky-900/30 text-sky-800 dark:text-sky-300">Próximamente</span>
      </div>
      <p class="text-muted dark:text-slate-400">La autenticación de dos factores añadirá una capa adicional de seguridad a tu cuenta. Estamos trabajando en esta función y estará disponible pronto.</p>
    </div>

    <%# Sesiones activas %>
    <div class="card p-6">
      <h2 class="card-title">Sesiones Activas</h2>

      <div class="overflow-x-auto rounded-lg border border-line dark:border-slate-700">
        <table class="min-w-full divide-y divide-line dark:divide-slate-700">
          <thead class="bg-slate-50 dark:bg-slate-700/50">
            <tr>
              <th scope="col" class="py-3.5 pl-4 pr-3 text-left text-xs font-semibold uppercase tracking-wide text-muted sm:pl-6">Dispositivo</th>
              <th scope="col" class="px-3 py-3.5 text-left text-xs font-semibold uppercase tracking-wide text-muted">Ubicación</th>
              <th scope="col" class="px-3 py-3.5 text-left text-xs font-semibold uppercase tracking-wide text-muted">Última actividad</th>
              <th scope="col" class="relative py-3.5 pl-3 pr-4 sm:pr-6">
                <span class="sr-only">Acciones</span>
              </th>
            </tr>
          </thead>
          <tbody class="divide-y divide-line dark:divide-slate-700 bg-white dark:bg-slate-800">
            <% if @active_sessions.present? %>
              <% @active_sessions.each do |session| %>
                <tr>
                  <td class="whitespace-nowrap py-4 pl-4 pr-3 text-sm sm:pl-6">
                    <div class="flex items-center">
                      <div class="flex-shrink-0">
                        <% if session.user_agent&.include?('Mobile') %>
                          <%= icon(:device_phone_mobile, class: "w-5 h-5 text-sky-500") %>
                        <% else %>
                          <%= icon(:computer_desktop, class: "w-5 h-5 text-sky-500") %>
                        <% end %>
                      </div>
                      <div class="ml-4">
                        <div class="font-medium text-ink dark:text-white">
                          <% if session.user_agent&.include?('iPhone') || session.user_agent&.include?('iPad') %>
                            iPhone/iPad
                          <% elsif session.user_agent&.include?('Android') %>
                            Android
                          <% elsif session.user_agent&.include?('Mac') %>
                            Mac
                          <% elsif session.user_agent&.include?('Windows') %>
                            Windows PC
                          <% else %>
                            Dispositivo
                          <% end %>
                        </div>
                        <div class="text-muted dark:text-slate-400">
                          <% if session.user_agent&.include?('Chrome') %>
                            Chrome
                          <% elsif session.user_agent&.include?('Firefox') %>
                            Firefox
                          <% elsif session.user_agent&.include?('Safari') && !session.user_agent&.include?('Chrome') %>
                            Safari
                          <% elsif session.user_agent&.include?('Edge') %>
                            Edge
                          <% elsif session.user_agent&.include?('Opera') %>
                            Opera
                          <% else %>
                            <%= session.user_agent&.truncate(30) || "Navegador desconocido" %>
                          <% end %>
                        </div>
                      </div>
                    </div>
                    <% if session.id == Current.session&.id %>
                      <span class="ml-4 inline-flex items-center px-2.5 py-0.5 rounded-full text-sm font-medium bg-green-100 dark:bg-green-900/30 text-green-800 dark:text-green-300">
                        Actual
                      </span>
                    <% end %>
                  </td>
                  <td class="whitespace-nowrap px-3 py-4 text-sm text-muted dark:text-slate-400"><%= session.ip_address || "Ubicación desconocida" %></td>
                  <td class="whitespace-nowrap px-3 py-4 text-sm text-muted dark:text-slate-400">
                    <% if session.updated_at > 1.day.ago %>
                      Hoy, <%= session.updated_at.strftime("%H:%M") %>
                    <% elsif session.updated_at > 2.days.ago %>
                      Ayer, <%= session.updated_at.strftime("%H:%M") %>
                    <% else %>
                      <%= session.updated_at.strftime("%d/%m/%Y %H:%M") %>
                    <% end %>
                  </td>
                  <td class="relative whitespace-nowrap py-4 pl-3 pr-4 text-right text-sm font-medium sm:pr-6">
                    <% if session.id != Current.session&.id %>
                      <%= button_to "Cerrar Sesión", "#", method: :delete, class: "btn-danger btn-sm" %>
                    <% end %>
                  </td>
                </tr>
              <% end %>
            <% else %>
              <tr>
                <td colspan="4" class="px-6 py-4 text-center text-sm text-muted dark:text-slate-400">
                  No hay sesiones activas registradas.
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>

      <div class="mt-4 text-sm text-muted dark:text-slate-400">
        <p class="flex items-center gap-2">
          <%= icon(:information_circle, class: "w-5 h-5 text-sky-500 shrink-0") %>
          Si no reconoces alguna de estas sesiones, ciérrala y considera cambiar tu contraseña.
        </p>
      </div>
    </div>
  </div>
</div>
