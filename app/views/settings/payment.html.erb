<div class="max-w-6xl mx-auto">
  <%= render "shared/page_header", title: "Mi cuenta", subtitle: "Completar suscripción" %>
  <%= render "settings/nav", active: :subscription %>

  <div class="max-w-2xl space-y-6">
    <%# Resumen del plan %>
    <div class="rounded-2xl border border-sky-200 dark:border-sky-800 bg-sky-50 dark:bg-sky-900/20 p-6">
      <h3 class="text-lg font-semibold mb-2 text-sky-800 dark:text-sky-300">Resumen de la Suscripción</h3>
      <div class="flex flex-wrap justify-between items-center gap-3">
        <div>
          <p class="text-ink dark:text-white font-medium"><%= @plan.name %></p>
          <p class="text-muted dark:text-slate-400 text-sm">Renovación automática mensual</p>
        </div>
        <div class="bg-sky-100 dark:bg-sky-900/30 px-4 py-2 rounded-md">
          <p class="text-xl font-bold text-sky-800 dark:text-sky-300">$<%= sprintf('%.2f', @plan.price / 100.0) %>/mes</p>
        </div>
      </div>
    </div>

    <%= form_with url: settings_process_payment_path(plan_id: @plan.id), method: :post, class: "space-y-6" do |f| %>
      <%# Información de tarjeta %>
      <div class="card p-6">
        <h3 class="text-lg font-semibold mb-4 flex items-center gap-2 text-ink dark:text-white">
          <%= icon(:credit_card, class: "h-6 w-6 text-sky-600 dark:text-sky-400") %>
          Información de Tarjeta
        </h3>

        <div class="grid grid-cols-1 gap-6">
          <div>
            <%= f.label :card_number, "Número de Tarjeta", class: "form-label" %>
            <%= f.text_field :card_number, class: "form-input", placeholder: "1234 5678 9012 3456" %>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <%= f.label :expiry, "Fecha de Expiración", class: "form-label" %>
              <%= f.text_field :expiry, class: "form-input", placeholder: "MM/AA" %>
            </div>

            <div>
              <%= f.label :cvv, "Código de Seguridad (CVV)", class: "form-label" %>
              <%= f.text_field :cvv, class: "form-input", placeholder: "123" %>
            </div>
          </div>
        </div>
      </div>

      <%# Información de facturación %>
      <div class="card p-6">
        <h3 class="text-lg font-semibold mb-4 flex items-center gap-2 text-ink dark:text-white">
          <%= icon(:user, class: "h-6 w-6 text-sky-600 dark:text-sky-400") %>
          Información de Facturación
        </h3>

        <div class="grid grid-cols-1 gap-6">
          <div>
            <%= f.label :name, "Nombre en la Tarjeta", class: "form-label" %>
            <%= f.text_field :name, class: "form-input" %>
          </div>

          <div>
            <%= f.label :address, "Dirección", class: "form-label" %>
            <%= f.text_field :address, class: "form-input" %>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <%= f.label :city, "Ciudad", class: "form-label" %>
              <%= f.text_field :city, class: "form-input" %>
            </div>

            <div>
              <%= f.label :postal_code, "Código Postal", class: "form-label" %>
              <%= f.text_field :postal_code, class: "form-input" %>
            </div>
          </div>
        </div>
      </div>

      <%# Términos y condiciones %>
      <div class="card p-6">
        <div class="flex items-start">
          <div class="flex items-center h-5">
            <%= f.check_box :terms, class: "form-check" %>
          </div>
          <div class="ml-3 text-sm">
            <%= f.label :terms, class: "font-medium text-ink dark:text-slate-300" do %>
              Acepto los <a href="#" class="text-sky-600 dark:text-sky-400 hover:text-sky-500">Términos y Condiciones</a> y la <a href="#" class="text-sky-600 dark:text-sky-400 hover:text-sky-500">Política de Privacidad</a>
            <% end %>
          </div>
        </div>
      </div>

      <%# Botones %>
      <div class="flex flex-wrap items-center justify-end gap-3">
        <%= link_to settings_subscription_path, class: "btn-secondary" do %>
          <%= icon(:arrow_left, class: "h-5 w-5") %>
          Cancelar
        <% end %>
        <%= f.button type: "submit", class: "btn-primary btn-lg" do %>
          <%= icon(:credit_card, class: "h-5 w-5") %>
          Completar Pago
        <% end %>
      </div>
    <% end %>

    <%# Aviso de pago seguro %>
    <div class="flex items-center justify-center">
      <%= icon(:lock_closed, class: "h-5 w-5 text-muted dark:text-slate-500 mr-2") %>
      <p class="text-sm text-muted dark:text-slate-400">Pago seguro con encriptación SSL</p>
    </div>
  </div>
</div>
