<% badge = menu_plan_badge(@user) %>
<div class="max-w-6xl mx-auto">
  <%= render "shared/page_header", title: "Mi cuenta" %>
  <%= render "settings/nav", active: :resumen %>

  <div class="space-y-6">
    <%# Header: saludo + plan (un solo punto de entrada a la suscripción) %>
    <div class="card p-6">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <div class="min-w-0">
          <h2 class="text-lg font-semibold text-ink dark:text-white truncate">Hola, <%= menu_display_name(@user) %></h2>
          <p class="text-sm text-muted truncate"><%= @user.email %></p>
        </div>
        <div class="flex items-center gap-3">
          <span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-medium <%= badge[:classes] %>"><%= badge[:label] %></span>
          <%= link_to (@plan&.free? || @plan.nil? ? "Ver planes" : "Administrar plan"), settings_subscription_path, class: "text-sm font-medium text-sky-600 dark:text-sky-400 hover:underline" %>
        </div>
      </div>
    </div>

    <%# Completitud del perfil → enlaza a "Mi perfil" (fuente única del perfil) %>
    <% if @completeness && @completeness < 100 && @profile_type.present? %>
      <div class="card p-6">
        <div class="flex justify-between items-center mb-2">
          <h3 class="text-sm font-medium text-ink dark:text-slate-300">Progreso del perfil</h3>
          <span class="text-sm text-muted dark:text-slate-400"><%= @completeness %>%</span>
        </div>
        <div class="w-full bg-slate-100 dark:bg-slate-700 rounded-full h-2.5">
          <div class="h-2.5 rounded-full <%= @completeness >= 70 ? 'bg-green-500' : @completeness >= 40 ? 'bg-yellow-500' : 'bg-red-500' %>" style="width: <%= @completeness %>%"></div>
        </div>
        <%= link_to "Completar mi perfil →", profile_menu_item(@user)[:path], class: "mt-3 inline-block text-sm font-medium text-sky-600 dark:text-sky-400 hover:underline" %>
      </div>
    <% end %>

    <%# Tarjetas de métricas por tipo (sin duplicar el perfil ni el plan) %>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <% if @profile_type == "doctor" %>
        <% if @doctor_profile %>
          <div class="card card-hover p-6">
            <h3 class="card-title">Visitas al Perfil</h3>
            <div class="flex items-center justify-between">
              <div>
                <p class="text-3xl font-bold text-sky-600 dark:text-sky-400"><%= @profile_views_total || 0 %></p>
                <p class="text-sm text-muted dark:text-slate-400">visitas totales</p>
              </div>
              <div class="text-right">
                <p class="text-lg font-semibold text-ink dark:text-white"><%= @profile_views_week || 0 %></p>
                <p class="text-sm text-muted dark:text-slate-400">esta semana</p>
              </div>
            </div>
            <% if paid_plan?(@plan) %>
              <%= link_to "Ver estadísticas detalladas →", estadisticas_path, class: "mt-4 inline-block text-sm font-medium text-sky-600 dark:text-sky-400 hover:underline" %>
            <% else %>
              <%= link_to "Desbloquear estadísticas con un plan de pago →", settings_subscription_path, class: "mt-4 inline-block text-sm font-medium text-amber-600 dark:text-amber-400 hover:underline" %>
            <% end %>
          </div>

          <% if paid_plan?(@plan) %>
            <div class="card card-hover p-6">
              <h3 class="card-title">Agenda Médica</h3>
              <p class="text-muted dark:text-slate-400 text-sm mb-1"><strong class="dark:text-slate-200">Citas próximas:</strong> <%= @doctor_profile.appointments.active.upcoming.count %></p>
              <p class="text-muted dark:text-slate-400 text-sm mb-4"><strong class="dark:text-slate-200">Hoy:</strong> <%= @doctor_profile.appointments.active.for_date(Date.current).count %> citas</p>
              <div class="flex gap-3">
                <%= link_to "Ver agenda", agenda_appointments_path, class: "text-sky-600 dark:text-sky-400 hover:text-sky-800 dark:hover:text-sky-300 text-sm font-medium" %>
                <%= link_to "Ajustes de agenda", agenda_settings_path, class: "text-sky-600 dark:text-sky-400 hover:text-sky-800 dark:hover:text-sky-300 text-sm font-medium" %>
              </div>
            </div>
          <% end %>
        <% end %>

      <% elsif @profile_type == "hospital" || @profile_type == "clinic" %>
        <% if @establishment %>
          <div class="card card-hover p-6">
            <h3 class="card-title">Visitas al Perfil</h3>
            <div class="flex items-center justify-between">
              <div>
                <p class="text-3xl font-bold text-sky-600 dark:text-sky-400"><%= @profile_views_total || 0 %></p>
                <p class="text-sm text-muted dark:text-slate-400">visitas totales</p>
              </div>
              <div class="text-right">
                <p class="text-lg font-semibold text-ink dark:text-white"><%= @profile_views_week || 0 %></p>
                <p class="text-sm text-muted dark:text-slate-400">esta semana</p>
              </div>
            </div>
          </div>
          <div class="card card-hover p-6">
            <h3 class="card-title">Doctores y Servicios</h3>
            <p class="text-muted dark:text-slate-400 text-sm mb-1"><strong class="dark:text-slate-200">Doctores:</strong> <%= @establishment.doctor_profiles.count %></p>
            <p class="text-muted dark:text-slate-400 text-sm"><strong class="dark:text-slate-200">Servicios:</strong> <%= @establishment.services.count %></p>
          </div>
        <% end %>

      <% elsif @profile_type == "vendor" %>
        <% if @supplier %>
          <div class="card card-hover p-6">
            <h3 class="card-title">Visitas al Perfil</h3>
            <div class="flex items-center justify-between">
              <div>
                <p class="text-3xl font-bold text-sky-600 dark:text-sky-400"><%= @profile_views_total || 0 %></p>
                <p class="text-sm text-muted dark:text-slate-400">visitas totales</p>
              </div>
              <div class="text-right">
                <p class="text-lg font-semibold text-ink dark:text-white"><%= @profile_views_week || 0 %></p>
                <p class="text-sm text-muted dark:text-slate-400">esta semana</p>
              </div>
            </div>
          </div>
        <% end %>
        <div class="card card-hover p-6">
          <h3 class="card-title">Productos y Contactos</h3>
          <p class="text-muted dark:text-slate-400 text-sm mb-1"><strong class="dark:text-slate-200">Productos:</strong> <%= @products_count %>
            <% unless paid_plan?(@plan) %><span class="text-slate-400 dark:text-slate-500">(máx. 5 en plan gratuito)</span><% end %>
          </p>
          <p class="text-muted dark:text-slate-400 text-sm mb-4"><strong class="dark:text-slate-200">Contactos:</strong>
            <% if paid_plan?(@plan) %><%= @leads_count %><% else %><span class="text-slate-400 dark:text-slate-500">Disponible en planes de pago</span><% end %>
          </p>
          <div class="flex gap-3">
            <%= link_to "Mis productos", vendor_products_path, class: "text-sky-600 dark:text-sky-400 hover:text-sky-800 dark:hover:text-sky-300 text-sm font-medium" %>
            <% if paid_plan?(@plan) %>
              <%= link_to "Mis contactos", vendor_leads_path, class: "text-sky-600 dark:text-sky-400 hover:text-sky-800 dark:hover:text-sky-300 text-sm font-medium" %>
            <% end %>
          </div>
        </div>

      <% elsif @profile_type == "paciente" %>
        <div class="card card-hover p-6">
          <h3 class="card-title">Próximas Citas</h3>
          <% if @upcoming_appointments.any? %>
            <div class="space-y-3">
              <% @upcoming_appointments.first(3).each do |apt| %>
                <div class="flex items-center justify-between p-3 bg-slate-50 dark:bg-slate-700/50 rounded-lg">
                  <div>
                    <p class="font-medium text-ink dark:text-white text-sm"><%= apt.doctor_profile.display_name %></p>
                    <p class="text-sm text-muted dark:text-slate-400"><%= apt.appointment_date.strftime("%d/%m/%Y") %> &middot; <%= apt.start_time.strftime("%H:%M") %></p>
                  </div>
                  <span class="text-sm px-2 py-1 rounded-full <%= apt.status_classes[:bg] %> <%= apt.status_classes[:text] %>"><%= apt.status_label %></span>
                </div>
              <% end %>
            </div>
            <%= link_to "Ver todas mis citas", paciente_appointments_path, class: "inline-block mt-3 text-sky-600 dark:text-sky-400 hover:text-sky-800 dark:hover:text-sky-300 text-sm font-medium" %>
          <% else %>
            <p class="text-muted dark:text-slate-400 text-sm mb-4">No tienes citas próximas.</p>
            <%= link_to "Buscar doctores", doctors_path, class: "btn-primary" %>
          <% end %>
        </div>
        <div class="card card-hover p-6">
          <h3 class="card-title">Historial de Citas</h3>
          <% if @past_appointments.any? %>
            <p class="text-3xl font-bold text-sky-600 dark:text-sky-400"><%= @past_appointments.size %></p>
            <p class="text-sm text-muted dark:text-slate-400 mb-3">citas anteriores</p>
            <%= link_to "Ver historial completo", paciente_appointments_path, class: "text-sky-600 dark:text-sky-400 hover:text-sky-800 dark:hover:text-sky-300 text-sm font-medium" %>
          <% else %>
            <p class="text-muted dark:text-slate-400 text-sm">Aún no tienes citas pasadas.</p>
          <% end %>
        </div>

      <% elsif @user.secretary? %>
        <div class="card card-hover p-6">
          <h3 class="card-title">Agenda Médica</h3>
          <% @user.secretary_assignments.active.includes(doctor_profile: :specialty).each do |assignment| %>
            <div class="mb-3">
              <p class="text-muted dark:text-slate-400 text-sm"><strong class="dark:text-slate-200"><%= assignment.doctor_profile.display_name %></strong></p>
              <p class="text-muted dark:text-slate-500 text-sm"><%= assignment.doctor_profile.specialty&.name %></p>
            </div>
          <% end %>
          <%= link_to "Ir a la agenda", agenda_appointments_path, class: "btn-primary" %>
        </div>

      <% else %>
        <div class="card card-hover p-6">
          <h3 class="card-title">Explorar</h3>
          <p class="text-muted dark:text-slate-400 text-sm mb-4">Busca doctores y establecimientos en Honduras.</p>
          <div class="flex flex-wrap gap-3">
            <%= link_to "Ver doctores", doctors_path, class: "btn-primary" %>
            <% if section_visible?("establishments") %>
              <%= link_to "Ver establecimientos", establishments_path, class: "btn-secondary" %>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>
