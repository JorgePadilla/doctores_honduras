<%#
  Card de plan de suscripción (settings/subscription). Premium sobrio — DESIGN.md.
  Locals: `plan`, `current` (bool: es el plan del usuario), `recommended` (bool).

  Solo la card destacada (actual o recomendada) lleva anillo primario + sombra
  elevada + badge flotante; el CTA primario se reserva para la recomendada
  ("una sola cosa audaz"). Nota técnica: `.card` vive fuera de capas y su
  box-shadow le gana a las utilities normales (ring-2/shadow-*), por eso el
  resaltado usa una utility arbitraria con `!` que combina anillo 2px en
  `--color-primary` + la sombra elevada de DESIGN.md.
%>
<% highlighted = current || recommended %>
<div class="card card-hover relative flex flex-col h-full <%= "shadow-[0_0_0_2px_var(--color-primary),0_12px_32px_-8px_rgb(11_18_32_/_0.14)]!" if highlighted %>">
  <% if highlighted %>
    <span class="badge absolute -top-3 left-1/2 -translate-x-1/2 bg-primary-hover text-white shadow-sm">
      <%= current ? "Tu plan" : "Recomendado" %>
    </span>
  <% end %>

  <%# Header: nombre, descripción, precio, límite de expedientes %>
  <div class="p-6 pb-5">
    <h4 class="font-display text-lg font-semibold tracking-tight text-ink dark:text-white"><%= plan.name %></h4>
    <% if plan.description.present? %>
      <p class="mt-1 text-sm text-muted dark:text-slate-400"><%= plan.description %></p>
    <% end %>

    <div class="mt-3 flex items-baseline gap-1">
      <% if plan.free? %>
        <span class="font-display text-4xl font-bold tracking-tight text-ink dark:text-white">Gratis</span>
      <% else %>
        <span class="font-display text-4xl font-bold tracking-tight tabular-nums text-ink dark:text-white">$<%= sprintf('%.2f', plan.price / 100.0) %></span>
        <span class="text-sm text-muted dark:text-slate-400">/mes</span>
      <% end %>
    </div>

    <% if plan.patient_limit? %>
      <span class="mt-3 inline-flex items-center gap-1 rounded-full bg-sky-100 dark:bg-sky-900/40 px-2.5 py-0.5 text-xs font-medium text-sky-800 dark:text-sky-300">
        <%= icon(:user, class: "h-3.5 w-3.5 shrink-0") %>
        <%= plan.patient_limit_label %>
      </span>
    <% end %>
  </div>

  <div class="border-t border-line dark:border-slate-700"></div>

  <%# Features: divide-y acota cada ítem — una feature de 2 líneas no se
      confunde con la siguiente. %>
  <div class="p-6 pt-5 flex-grow">
    <%# Separar por coma+espacio (no por coma sola) para no partir cifras como
        "5,000" dentro de una feature (p.ej. "…(hasta 5,000 registros)"). %>
    <ul class="divide-y divide-line dark:divide-slate-700/60">
      <% plan.features.to_s.split(/,\s+/).each do |feature| %>
        <li class="flex items-start gap-3 py-2.5">
          <span class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-green-100 dark:bg-green-900/30">
            <%= icon(:check, class: "h-3 w-3 text-green-600 dark:text-green-400") %>
          </span>
          <span class="text-sm text-slate-600 dark:text-slate-300 leading-snug"><%= feature.strip %></span>
        </li>
      <% end %>
    </ul>
  </div>

  <%# CTA — el wiring (stripe_checkout / settings_subscribe) se conserva tal cual. %>
  <div class="p-6 pt-0 mt-auto">
    <% if current %>
      <div class="btn-secondary w-full pointer-events-none opacity-90">
        <%= icon(:check, class: "h-5 w-5") %>
        Plan actual
      </div>
    <% elsif plan.price > 0 %>
      <%= button_to stripe_checkout_path(plan_id: plan.id), method: :post, class: "#{recommended ? 'btn-primary' : 'btn-secondary'} w-full" do %>
        <%= icon(:credit_card, class: "h-5 w-5") %>
        Suscribirse
      <% end %>
    <% else %>
      <%= button_to settings_subscribe_path(plan_id: plan.id), method: :post, class: "btn-secondary w-full" do %>
        <%= icon(:plus, class: "h-5 w-5") %>
        Elegir gratis
      <% end %>
    <% end %>
  </div>
</div>
