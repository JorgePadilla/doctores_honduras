<%= form_with model: supplier, url: onboarding_complete_path, method: :post, class: "space-y-6" do |f| %>
  <%= render "shared/form_errors", model: supplier %>

  <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
    <div>
      <%= f.label :name, "Nombre de la empresa", class: "form-label" %>
      <%= f.text_field :name, class: "form-input", required: true %>
    </div>

    <div>
      <%= f.label :phone, "Teléfono", class: "form-label" %>
      <%= f.telephone_field :phone, class: "form-input", required: true %>
    </div>

    <div>
      <%= f.label :category, "Categoría", class: "form-label" %>
      <%= f.select :category,
                  options_for_select([
                    ["Equipos Médicos", "equipos_medicos"],
                    ["Suministros Médicos", "suministros_medicos"],
                    ["Farmacéuticos", "farmaceuticos"],
                    ["Tecnología Médica", "tecnologia_medica"],
                    ["Mobiliario Hospitalario", "mobiliario_hospitalario"],
                    ["Otro", "otro"]
                  ], supplier.category),
                  { include_blank: "Selecciona una categoría" },
                  { class: "form-input form-select" } %>
    </div>

    <div>
      <%= f.label :department_id, "Departamento", class: "form-label" %>
      <%= f.select :department_id,
                  options_for_select(departments.map { |d| [d.name, d.id] }, supplier.department_id),
                  { include_blank: "Selecciona un departamento" },
                  { class: "form-input form-select" } %>
    </div>

    <div>
      <%= f.label :city_id, "Ciudad", class: "form-label" %>
      <%= f.select :city_id,
                  options_for_select(cities.map { |c| [c.name, c.id] }, supplier.city_id),
                  { include_blank: "Selecciona una ciudad" },
                  { class: "form-input form-select" } %>
    </div>
  </div>

  <div class="flex items-center justify-between gap-3">
    <%= link_to "Volver", onboarding_profile_type_path, class: "btn-secondary" %>
    <%= f.submit "Crear Perfil y Continuar", class: "btn-primary" %>
  </div>
<% end %>
