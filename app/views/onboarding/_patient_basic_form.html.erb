<%= form_with model: patient_profile, url: onboarding_complete_path, method: :post, class: "space-y-6" do |f| %>
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6"
       data-controller="location-filter"
       data-location-filter-department-blank-value="Selecciona un departamento"
       data-location-filter-city-blank-value="Selecciona una ciudad">
    <div>
      <%= f.label :name, "Nombre completo", class: "block text-sm font-medium text-gray-700 dark:text-slate-300" %>
      <%= f.text_field :name, class: "mt-1 block w-full border border-gray-300 dark:border-slate-600 rounded-md shadow-sm py-2 px-3 focus:outline-none focus:ring-sky-500 focus:border-sky-500 sm:text-sm dark:bg-slate-700 dark:text-white", placeholder: "Tu nombre completo", required: true %>
    </div>

    <div>
      <%= f.label :identity_document, "Número de identidad (DNI)", class: "block text-sm font-medium text-gray-700 dark:text-slate-300" %>
      <%= f.text_field :identity_document, class: "mt-1 block w-full border border-gray-300 dark:border-slate-600 rounded-md shadow-sm py-2 px-3 focus:outline-none focus:ring-sky-500 focus:border-sky-500 sm:text-sm dark:bg-slate-700 dark:text-white", placeholder: "0801-1990-12345", required: true %>
    </div>

    <div>
      <%= f.label :phone, "Teléfono", class: "block text-sm font-medium text-gray-700 dark:text-slate-300" %>
      <%= f.telephone_field :phone, class: "mt-1 block w-full border border-gray-300 dark:border-slate-600 rounded-md shadow-sm py-2 px-3 focus:outline-none focus:ring-sky-500 focus:border-sky-500 sm:text-sm dark:bg-slate-700 dark:text-white", placeholder: "+504 0000-0000", required: true %>
    </div>

    <div>
      <%= f.label :date_of_birth, "Fecha de nacimiento", class: "block text-sm font-medium text-gray-700 dark:text-slate-300" %>
      <%= f.text_field :date_of_birth,
            value: patient_profile.date_of_birth&.to_s,
            data: { controller: "datepicker", datepicker_mode_value: "past" },
            placeholder: "Selecciona una fecha",
            autocomplete: "off",
            class: "mt-1 block w-full border border-gray-300 dark:border-slate-600 rounded-md shadow-sm py-2 px-3 focus:outline-none focus:ring-sky-500 focus:border-sky-500 sm:text-sm dark:bg-slate-700 dark:text-white" %>
    </div>

    <div>
      <%= f.label :country_id, "País", class: "block text-sm font-medium text-gray-700 dark:text-slate-300" %>
      <%= f.select :country_id,
                  options_for_select(countries.map { |c| [c.name, c.id] }, patient_profile.country_id),
                  { include_blank: "Selecciona un país" },
                  { class: "mt-1 block w-full border border-gray-300 dark:border-slate-600 rounded-md shadow-sm py-2 px-3 focus:outline-none focus:ring-sky-500 focus:border-sky-500 sm:text-sm dark:bg-slate-700 dark:text-white", required: true,
                    data: { location_filter_target: "country", action: "change->location-filter#loadDepartments" } } %>
    </div>

    <div>
      <%= f.label :department_id, "Departamento", class: "block text-sm font-medium text-gray-700 dark:text-slate-300" %>
      <%= f.select :department_id,
                  options_for_select(departments.map { |d| [d.name, d.id] }, patient_profile.department_id),
                  { include_blank: "Selecciona un departamento" },
                  { class: "mt-1 block w-full border border-gray-300 dark:border-slate-600 rounded-md shadow-sm py-2 px-3 focus:outline-none focus:ring-sky-500 focus:border-sky-500 sm:text-sm dark:bg-slate-700 dark:text-white",
                    data: { location_filter_target: "department", action: "change->location-filter#loadCities" } } %>
    </div>

    <div>
      <%= f.label :city_id, "Ciudad", class: "block text-sm font-medium text-gray-700 dark:text-slate-300" %>
      <%= f.select :city_id,
                  options_for_select(cities.map { |c| [c.name, c.id] }, patient_profile.city_id),
                  { include_blank: "Selecciona una ciudad" },
                  { class: "mt-1 block w-full border border-gray-300 dark:border-slate-600 rounded-md shadow-sm py-2 px-3 focus:outline-none focus:ring-sky-500 focus:border-sky-500 sm:text-sm dark:bg-slate-700 dark:text-white",
                    data: { location_filter_target: "city" } } %>
    </div>
  </div>

  <% if patient_profile.errors.any? %>
    <div class="bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-800 rounded-md p-4">
      <ul class="text-sm text-red-600 dark:text-red-300 list-disc list-inside">
        <% patient_profile.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="flex flex-col-reverse gap-3 sm:flex-row sm:justify-between">
    <%= link_to "Volver", onboarding_profile_type_path, class: "w-full sm:w-auto text-center py-2 px-4 border border-gray-300 dark:border-slate-600 rounded-full transition-all hover:shadow-md transform hover:scale-105 shadow-sm text-sm font-medium text-gray-700 dark:text-slate-300 bg-white dark:bg-slate-700 hover:bg-gray-50 dark:hover:bg-slate-600 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-sky-500" %>
    <%= f.submit "Crear Perfil y Continuar", class: "w-full sm:w-auto py-2 px-4 border border-transparent rounded-full transition-all hover:shadow-md transform hover:scale-105 shadow-sm text-sm font-medium text-white bg-sky-500 hover:bg-sky-600 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-sky-500 cursor-pointer" %>
  </div>
<% end %>
