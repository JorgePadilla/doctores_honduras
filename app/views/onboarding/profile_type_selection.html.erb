<div class="container mx-auto px-4 py-8 max-w-4xl">
  <div class="text-center mb-10">
    <h1 class="text-3xl font-bold text-gray-800 dark:text-white mb-2">Bienvenido a Doctores Honduras</h1>
    <p class="text-lg text-gray-600 dark:text-slate-400">Seleccione el tipo de perfil que desea crear</p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8 items-stretch">
    <!-- Doctor -->
    <%= form_with url: onboarding_save_profile_type_path, method: :post, class: "block h-full" do |f| %>
      <%= f.hidden_field :profile_type, value: "doctor" %>
      <button type="submit" class="w-full h-full text-left bg-white dark:bg-slate-800 rounded-xl shadow-md dark:shadow-slate-900/50 overflow-hidden border-2 border-gray-200 dark:border-slate-700 hover:border-sky-500 dark:hover:border-sky-500 transition-all hover:shadow-md transform hover:scale-105 cursor-pointer group">
        <div class="p-6">
          <div class="flex items-center mb-4">
            <div class="w-12 h-12 rounded-full bg-sky-100 dark:bg-sky-900/30 flex items-center justify-center group-hover:bg-sky-200 dark:group-hover:bg-sky-900/50 transition-colors shrink-0">
              <%= icon(:user, class: "w-6 h-6 text-sky-600 dark:text-sky-400") %>
            </div>
            <h3 class="text-xl font-bold text-gray-800 dark:text-white ml-4">Doctor</h3>
          </div>
          <p class="text-gray-600 dark:text-slate-400 text-sm">Para médicos y especialistas que desean crear su perfil profesional y aparecer en el directorio.</p>
        </div>
      </button>
    <% end %>

    <!-- Hospital / Clinic -->
    <% if section_visible?("establishments") %>
    <%= form_with url: onboarding_save_profile_type_path, method: :post, class: "block h-full" do |f| %>
      <%= f.hidden_field :profile_type, value: "hospital" %>
      <button type="submit" class="w-full h-full text-left bg-white dark:bg-slate-800 rounded-xl shadow-md dark:shadow-slate-900/50 overflow-hidden border-2 border-gray-200 dark:border-slate-700 hover:border-sky-500 dark:hover:border-sky-500 transition-all hover:shadow-md transform hover:scale-105 cursor-pointer group">
        <div class="p-6">
          <div class="flex items-center mb-4">
            <div class="w-12 h-12 rounded-full bg-sky-100 dark:bg-sky-900/30 flex items-center justify-center group-hover:bg-sky-200 dark:group-hover:bg-sky-900/50 transition-colors shrink-0">
              <%= icon(:building_office, class: "w-6 h-6 text-sky-600 dark:text-sky-400") %>
            </div>
            <h3 class="text-xl font-bold text-gray-800 dark:text-white ml-4">Hospital / Clínica</h3>
          </div>
          <p class="text-gray-600 dark:text-slate-400 text-sm">Para hospitales y clínicas que desean registrar su establecimiento y servicios.</p>
        </div>
      </button>
    <% end %>
    <% end %>

    <!-- Vendor -->
    <% if section_visible?("suppliers") %>
    <%= form_with url: onboarding_save_profile_type_path, method: :post, class: "block h-full" do |f| %>
      <%= f.hidden_field :profile_type, value: "vendor" %>
      <button type="submit" class="w-full h-full text-left bg-white dark:bg-slate-800 rounded-xl shadow-md dark:shadow-slate-900/50 overflow-hidden border-2 border-gray-200 dark:border-slate-700 hover:border-sky-500 dark:hover:border-sky-500 transition-all hover:shadow-md transform hover:scale-105 cursor-pointer group">
        <div class="p-6">
          <div class="flex items-center mb-4">
            <div class="w-12 h-12 rounded-full bg-sky-100 dark:bg-sky-900/30 flex items-center justify-center group-hover:bg-sky-200 dark:group-hover:bg-sky-900/50 transition-colors shrink-0">
              <%= icon(:cube, class: "w-6 h-6 text-sky-600 dark:text-sky-400") %>
            </div>
            <h3 class="text-xl font-bold text-gray-800 dark:text-white ml-4">Proveedor Médico</h3>
          </div>
          <p class="text-gray-600 dark:text-slate-400 text-sm">Para proveedores de equipos y suministros médicos que desean mostrar sus productos.</p>
        </div>
      </button>
    <% end %>
    <% end %>
  </div>

  <!-- Paciente -->
  <div class="text-center mb-8">
    <%= form_with url: onboarding_save_profile_type_path, method: :post, class: "inline-block w-full max-w-md" do |f| %>
      <%= f.hidden_field :profile_type, value: "paciente" %>
      <button type="submit" class="w-full text-left bg-white dark:bg-slate-800 rounded-xl shadow-md dark:shadow-slate-900/50 overflow-hidden border-2 border-gray-200 dark:border-slate-700 hover:border-sky-500 dark:hover:border-sky-500 transition-all hover:shadow-md transform hover:scale-105 cursor-pointer group">
        <div class="p-6">
          <div class="flex items-center mb-4">
            <div class="w-12 h-12 rounded-full bg-sky-100 dark:bg-sky-900/30 flex items-center justify-center group-hover:bg-sky-200 dark:group-hover:bg-sky-900/50 transition-colors shrink-0">
              <%= icon(:heart, class: "w-6 h-6 text-sky-600 dark:text-sky-400") %>
            </div>
            <h3 class="text-xl font-bold text-gray-800 dark:text-white ml-4">Paciente</h3>
          </div>
          <p class="text-gray-600 dark:text-slate-400 text-sm">Busca doctores y gestiona tus citas médicas desde tu cuenta personal.</p>
        </div>
      </button>
    <% end %>
  </div>

  <!-- Viewer link -->
  <div class="text-center">
    <%= form_with url: onboarding_save_profile_type_path, method: :post, class: "inline" do |f| %>
      <%= f.hidden_field :profile_type, value: "viewer" %>
      <button type="submit" class="text-sky-600 dark:text-sky-400 hover:text-sky-800 dark:hover:text-sky-300 text-sm underline">
        Solo buscar doctores y establecimientos
      </button>
    <% end %>
  </div>
</div>
