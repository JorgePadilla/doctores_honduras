<%# Barra de filtros de /doctors: píldoras con popovers que auto-aplican al
    turbo-frame "doctors-list". Los chips de filtros activos + el conteo viven
    DENTRO del frame (ver doctors/index.html.erb) para refrescarse en cada submit. %>
<div class="mb-6">
  <%= form_with url: doctors_path, method: :get, data: { turbo_frame: "doctors-list", controller: "form" } do |form| %>
    <% if params[:q].present? %><%= hidden_field_tag :q, params[:q] %><% end %>

    <div class="flex flex-nowrap items-center gap-2 overflow-x-auto no-scrollbar sm:flex-wrap sm:gap-3 sm:overflow-visible">
      <%= render "shared/filter_combobox",
            name: "specialty", label: "Especialidad", all_label: "Todas las especialidades",
            items: @specialties, id_prefix: "specialty",
            current: (params[:specialty].presence unless params[:specialty] == "Todas las especialidades") %>

      <%= render "shared/filter_combobox",
            name: "service", label: "Servicio", all_label: "Todos los servicios",
            items: @services, id_prefix: "service",
            current: (params[:service].presence unless params[:service] == "Todos los servicios") %>

      <%# Ubicación — un solo popover con Departamento + Ciudad (País solo si hay varios) %>
      <% selected_city = (@cities.detect { |c| c.id.to_s == params[:city_id].to_s } if params[:city_id].present?) %>
      <% selected_dept = (@departments.detect { |d| d.id.to_s == params[:department_id].to_s } if params[:department_id].present?) %>
      <% location_active = selected_city.present? || selected_dept.present? %>
      <div class="filter-unit relative shrink-0" data-controller="popover location-filter"
           data-location-filter-department-blank-value="Todos los departamentos"
           data-location-filter-city-blank-value="Todas las ciudades"
           data-location-filter-label-default-value="Ubicación">
        <button type="button" class="filter-pill<%= ' is-active' if location_active %>"
                data-popover-target="trigger" data-location-filter-target="trigger"
                data-action="popover#toggle" aria-haspopup="true" aria-expanded="false">
          <span class="max-w-[10rem] truncate" data-location-filter-target="label"><%= selected_city&.name || selected_dept&.name || "Ubicación" %></span>
          <%= icon(:chevron_down, class: "w-4 h-4 text-muted shrink-0") %>
        </button>
        <div class="popover-backdrop" data-popover-target="backdrop" data-action="click->popover#close"></div>
        <div class="popover-panel" data-popover-target="panel">
          <div class="popover-body space-y-3">
            <% if @countries.many? %>
              <div>
                <label class="filter-field-label">País</label>
                <%= form.select :country_id,
                      options_from_collection_for_select(@countries, :id, :name, params[:country_id] || @geo_country_id),
                      { include_blank: "Todos los países" }, class: "filter-field",
                      data: { location_filter_target: "country", action: "change->location-filter#loadDepartments change->location-filter#markActive change->form#submit" } %>
              </div>
            <% end %>
            <div>
              <label class="filter-field-label">Departamento</label>
              <%= form.select :department_id,
                    options_from_collection_for_select(@departments, :id, :name, params[:department_id] || @geo_department_id),
                    { include_blank: "Todos los departamentos" }, class: "filter-field",
                    data: { location_filter_target: "department", action: "change->location-filter#loadCities change->location-filter#markActive change->form#submit" } %>
            </div>
            <div>
              <label class="filter-field-label">Ciudad</label>
              <%= form.select :city_id,
                    options_from_collection_for_select(@cities, :id, :name, params[:city_id]),
                    { include_blank: "Todas las ciudades" }, class: "filter-field",
                    data: { location_filter_target: "city", action: "change->location-filter#markActive change->form#submit" } %>
            </div>
          </div>
        </div>
      </div>

      <%# Hospital / Clínica — solo cuando la sección está visible y hay datos %>
      <% if @establishments.any? %>
        <% selected_hosp = (@establishments.detect { |e| e.id.to_s == params[:establishment_id].to_s } if params[:establishment_id].present?) %>
        <div class="filter-unit relative shrink-0" data-controller="popover">
          <button type="button" class="filter-pill<%= ' is-active' if selected_hosp %>"
                  data-popover-target="trigger" data-action="popover#toggle" aria-haspopup="true" aria-expanded="false">
            <span class="max-w-[10rem] truncate"><%= selected_hosp&.name || "Hospital" %></span>
            <%= icon(:chevron_down, class: "w-4 h-4 text-muted shrink-0") %>
          </button>
          <div class="popover-backdrop" data-popover-target="backdrop" data-action="click->popover#close"></div>
          <div class="popover-panel" data-popover-target="panel">
            <div class="popover-body">
              <label class="filter-field-label">Hospital / Clínica</label>
              <%= form.select :establishment_id,
                    options_from_collection_for_select(@establishments, :id, :name, params[:establishment_id]),
                    { include_blank: "Todos los hospitales" }, class: "filter-field",
                    data: { action: "change->form#submit" } %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>
</div>
