<div class="bg-white dark:bg-slate-800 shadow-md dark:shadow-slate-900/50 rounded-xl p-4 mb-6 border border-gray-100 dark:border-slate-700">
  <h3 class="text-lg font-medium text-gray-900 dark:text-white mb-4">Filtrar Resultados</h3>

  <%= form_with url: doctors_path, method: :get, class: "space-y-4", data: { turbo_frame: "doctors-list", controller: "form", form_target: "filterForm" } do |form| %>
    <% if params[:q].present? %>
      <%= form.hidden_field :q, value: params[:q] %>
    <% end %>

    <%# Especialidad %>
    <div>
      <label for="specialty" class="block text-sm font-medium text-gray-700 dark:text-slate-300 mb-1">Especialidad</label>
      <div class="relative">
        <%= form.select :specialty,
                      options_for_select(@specialties, params[:specialty]),
                      { include_blank: "Todas las especialidades" },
                      class: "mt-1 block w-full pl-3 pr-10 py-2 text-base border-gray-300 dark:border-slate-600 focus:outline-none focus:ring-sky-500 focus:border-sky-500 sm:text-sm rounded-md appearance-none dark:bg-slate-700 dark:text-white",
                      data: { action: "change->form#submit" } %>
        <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-2 text-gray-500 dark:text-slate-400">
          <%= icon(:chevron_down, class: "h-4 w-4") %>
        </div>
      </div>
    </div>

    <%# Ciudad %>
    <div>
      <label for="city_id" class="block text-sm font-medium text-gray-700 dark:text-slate-300 mb-1">Ciudad</label>
      <div class="relative">
        <%= form.select :city_id,
                      options_from_collection_for_select(@cities, :id, :name, params[:city_id]),
                      { include_blank: "Todas las ciudades" },
                      class: "mt-1 block w-full pl-3 pr-10 py-2 text-base border-gray-300 dark:border-slate-600 focus:outline-none focus:ring-sky-500 focus:border-sky-500 sm:text-sm rounded-md appearance-none dark:bg-slate-700 dark:text-white",
                      data: { action: "change->form#submit" } %>
        <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-2 text-gray-500 dark:text-slate-400">
          <%= icon(:chevron_down, class: "h-4 w-4") %>
        </div>
      </div>
    </div>

    <%# Hospital / Clínica (solo si la sección está visible) %>
    <% if @establishments.any? %>
      <div>
        <label for="establishment_id" class="block text-sm font-medium text-gray-700 dark:text-slate-300 mb-1">Hospital / Clínica</label>
        <div class="relative">
          <%= form.select :establishment_id,
                        options_from_collection_for_select(@establishments, :id, :name, params[:establishment_id]),
                        { include_blank: "Todos los hospitales" },
                        class: "mt-1 block w-full pl-3 pr-10 py-2 text-base border-gray-300 dark:border-slate-600 focus:outline-none focus:ring-sky-500 focus:border-sky-500 sm:text-sm rounded-md appearance-none dark:bg-slate-700 dark:text-white",
                        data: { action: "change->form#submit" } %>
          <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-2 text-gray-500 dark:text-slate-400">
            <%= icon(:chevron_down, class: "h-4 w-4") %>
          </div>
        </div>
      </div>
    <% end %>

    <%# Servicio / Procedimiento %>
    <div>
      <label for="service" class="block text-sm font-medium text-gray-700 dark:text-slate-300 mb-1">Servicio o procedimiento</label>
      <div class="relative">
        <%= form.select :service,
                      options_for_select(@services, params[:service]),
                      { include_blank: "Todos los servicios" },
                      class: "mt-1 block w-full pl-3 pr-10 py-2 text-base border-gray-300 dark:border-slate-600 focus:outline-none focus:ring-sky-500 focus:border-sky-500 sm:text-sm rounded-md appearance-none dark:bg-slate-700 dark:text-white",
                      data: { action: "change->form#submit" } %>
        <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-2 text-gray-500 dark:text-slate-400">
          <%= icon(:chevron_down, class: "h-4 w-4") %>
        </div>
      </div>
    </div>

    <div class="flex justify-between pt-2">
      <%= form.submit "Aplicar Filtros",
                    class: "inline-flex justify-center items-center py-2 px-6 border border-transparent shadow-sm text-sm font-medium rounded-full text-white focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-sky-500 transition-all hover:shadow-md transform hover:scale-105 bg-sky-500 hover:bg-sky-600",
                    data: { form_target: "submitButton" } %>

      <% if params[:specialty].present? || params[:service].present? || params[:city_id].present? || params[:establishment_id].present? %>
        <%= link_to doctors_path(q: params[:q]),
                   class: "inline-flex justify-center items-center py-2 px-4 border border-gray-300 dark:border-slate-600 shadow-sm text-sm font-medium rounded-md text-gray-700 dark:text-slate-300 bg-white dark:bg-slate-700 hover:bg-gray-50 dark:hover:bg-slate-600 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-sky-500" do %>
          <span>Limpiar</span>
          <%= icon(:x_mark, class: "h-4 w-4 ml-1") %>
        <% end %>
      <% end %>
    </div>

    <div data-form-target="loadingIndicator" class="hidden mt-2 text-center text-sm text-gray-500 dark:text-slate-400">
      <div class="inline-flex items-center">
        <svg class="animate-spin -ml-1 mr-2 h-4 w-4 text-sky-500" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
        </svg>
        <span>Buscando médicos...</span>
      </div>
    </div>
  <% end %>
</div>
