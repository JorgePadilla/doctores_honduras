<nav data-controller="navbar" class="nav-glass sticky top-0 z-50 bg-white/80 dark:bg-slate-900/80 backdrop-blur-md transition-colors duration-200">
  <div class="container mx-auto px-4">
    <div class="flex justify-between items-center py-3.5">
      <!-- Logo/Brand -->
      <div class="flex items-center">
        <a href="/" class="font-display text-lg md:text-xl font-bold tracking-tight whitespace-nowrap text-ink dark:text-white hover:text-primary transition-colors">
          Doctores Honduras
        </a>
      </div>

      <!-- Public navigation links (desktop) -->
      <div class="hidden md:flex items-center space-x-7">
        <a href="/" class="text-sm font-medium text-slate-600 dark:text-slate-300 hover:text-primary transition-colors">Inicio</a>
        <a href="/doctors" class="text-sm font-medium text-slate-600 dark:text-slate-300 hover:text-primary transition-colors">Doctores</a>
        <% if section_visible?("establishments") %>
          <a href="/hospitales-y-clinicas" class="text-sm font-medium text-slate-600 dark:text-slate-300 hover:text-primary transition-colors">Hospitales y Clínicas</a>
        <% end %>
        <% if section_visible?("suppliers") %>
          <a href="/proveedores" class="text-sm font-medium text-slate-600 dark:text-slate-300 hover:text-primary transition-colors">Proveedores</a>
        <% end %>
      </div>

      <!-- Right side: search, theme, notifications, user menu -->
      <div class="flex items-center gap-1 md:gap-2">
        <!-- ⌘K command palette trigger -->
        <button type="button" data-action="command-palette#open" title="Buscar (⌘K)" aria-label="Buscar"
                class="hidden sm:inline-flex items-center gap-2 rounded-full border border-line dark:border-slate-700 pl-3 pr-2 py-1.5 text-sm text-slate-500 dark:text-slate-400 hover:text-primary hover:border-sky-300 dark:hover:border-slate-600 transition-colors">
          <%= icon(:magnifying_glass, class: "w-4 h-4") %>
          <span>Buscar</span>
          <kbd class="rounded border border-line dark:border-slate-600 px-1.5 py-0.5 text-[10px] font-semibold leading-none">⌘K</kbd>
        </button>
        <button type="button" data-action="command-palette#open" title="Buscar" aria-label="Buscar"
                class="sm:hidden p-2 rounded-lg text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors">
          <%= icon(:magnifying_glass, class: "w-5 h-5") %>
        </button>

        <!-- Dark Mode Toggle -->
        <button data-action="dark-mode#toggle" class="p-2 rounded-lg text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors" title="Cambiar tema">
          <%= icon(:sun, class: "w-5 h-5 hidden", data: { dark_mode_target: "sunIcon" }) %>
          <%= icon(:moon, class: "w-5 h-5", data: { dark_mode_target: "moonIcon" }) %>
        </button>

        <% if Current.user %>
          <!-- Notifications bell + dropdown (desktop + mobile) -->
          <% unread_count = Current.user.unread_notifications_count %>
          <div class="relative" data-controller="dropdown">
            <button data-dropdown-target="trigger" data-action="dropdown#toggle" aria-label="Notificaciones" aria-expanded="false" title="Notificaciones"
                    class="relative p-2 rounded-lg text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors focus:outline-none">
              <%= icon(:bell, class: "w-5 h-5") %>
              <% if unread_count > 0 %>
                <span class="absolute -top-1 -right-1 bg-red-500 text-white text-xs font-semibold rounded-full w-5 h-5 flex items-center justify-center"><%= unread_count > 9 ? "9+" : unread_count %></span>
              <% end %>
            </button>
            <div data-dropdown-target="menu" class="hidden absolute right-0 mt-2 w-80 max-w-[calc(100vw-5rem)] bg-white dark:bg-slate-800 rounded-xl shadow-md border border-line dark:border-slate-700 z-50 overflow-hidden">
              <div class="flex items-center justify-between px-4 py-2.5 border-b border-line dark:border-slate-700">
                <span class="text-sm font-semibold text-ink dark:text-white">Notificaciones</span>
                <% if unread_count > 0 %>
                  <%= button_to "Marcar leídas", mark_all_as_read_notifications_path, method: :patch, class: "text-xs text-sky-600 dark:text-sky-400 hover:underline" %>
                <% end %>
              </div>
              <div class="max-h-96 overflow-y-auto">
                <% recent_notifs = Current.user.notifications.recent.to_a %>
                <% if recent_notifs.any? %>
                  <% recent_notifs.first(8).each do |n| %>
                    <%= button_to mark_as_read_notification_path(n), method: :patch, class: "w-full text-left flex items-start gap-2.5 px-4 py-2.5 hover:bg-sky-50 dark:hover:bg-slate-700/60 transition-colors #{n.read? ? 'opacity-60' : ''}" do %>
                      <span class="w-7 h-7 rounded-full bg-sky-100 dark:bg-sky-900/30 flex items-center justify-center shrink-0 mt-0.5">
                        <%= icon((n.icon.presence || "bell").to_sym, class: "w-4 h-4 text-sky-600 dark:text-sky-400") %>
                      </span>
                      <span class="flex-1 min-w-0">
                        <span class="flex items-center gap-1.5">
                          <% unless n.read? %><span class="w-1.5 h-1.5 bg-sky-500 rounded-full shrink-0"></span><% end %>
                          <span class="text-sm font-medium text-ink dark:text-white truncate"><%= n.title.presence || n.message %></span>
                        </span>
                        <span class="block text-xs text-gray-500 dark:text-slate-400 truncate"><%= n.message %></span>
                        <span class="block text-xs text-gray-400 dark:text-slate-500 mt-0.5"><%= time_ago_in_words(n.created_at) %></span>
                      </span>
                    <% end %>
                  <% end %>
                <% else %>
                  <p class="px-4 py-6 text-center text-sm text-gray-500 dark:text-slate-400">No tienes notificaciones</p>
                <% end %>
              </div>
              <%= link_to "Ver todas", notifications_path, class: "block px-4 py-2.5 text-center text-sm text-sky-600 dark:text-sky-400 hover:bg-sky-50 dark:hover:bg-slate-700 border-t border-line dark:border-slate-700" %>
            </div>
          </div>

          <!-- User menu (desktop trigger; mobile lives in the hamburger) -->
          <div class="relative hidden md:block" data-controller="dropdown">
            <button data-dropdown-target="trigger" data-action="dropdown#toggle" aria-haspopup="true" aria-expanded="false"
                    class="flex items-center gap-1.5 p-1 pr-2 rounded-full hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors focus:outline-none">
              <span class="flex h-8 w-8 items-center justify-center rounded-full bg-sky-100 dark:bg-sky-900/40 font-display text-xs font-semibold text-sky-700 dark:text-sky-300"><%= menu_avatar_initials(Current.user) %></span>
              <%= icon(:chevron_down, class: "h-4 w-4 text-muted") %>
            </button>
            <div data-dropdown-target="menu" class="hidden absolute right-0 mt-2 w-64 bg-white dark:bg-slate-800 rounded-xl shadow-md border border-line dark:border-slate-700 z-50 overflow-hidden">
              <%= render "shared/user_menu" %>
            </div>
          </div>
        <% else %>
          <a href="<%= new_session_path %>" class="hidden md:inline-flex text-sm font-medium text-slate-700 dark:text-slate-200 hover:text-primary transition-colors">Iniciar Sesión</a>
        <% end %>

        <!-- Mobile Menu Button -->
        <button data-action="navbar#toggleMobile" class="md:hidden p-2 rounded-lg text-slate-700 dark:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-800 focus:outline-none" aria-label="Menú">
          <%= icon(:bars_3, class: "h-6 w-6") %>
        </button>
      </div>
    </div>

    <!-- Mobile Menu -->
    <div data-navbar-target="mobileMenu" class="md:hidden hidden pb-4">
      <a href="/" class="block py-2 text-slate-700 dark:text-slate-200 hover:text-primary transition-colors">Inicio</a>
      <a href="/doctors" class="block py-2 text-slate-700 dark:text-slate-200 hover:text-primary transition-colors">Doctores</a>
      <% if section_visible?("establishments") %>
        <a href="/hospitales-y-clinicas" class="block py-2 text-slate-700 dark:text-slate-200 hover:text-primary transition-colors">Hospitales y Clínicas</a>
      <% end %>
      <% if section_visible?("suppliers") %>
        <a href="/proveedores" class="block py-2 text-slate-700 dark:text-slate-200 hover:text-primary transition-colors">Proveedores</a>
      <% end %>
      <% if Current.user %>
        <div class="mt-4 rounded-xl border border-line dark:border-slate-700 overflow-hidden">
          <%= render "shared/user_menu" %>
        </div>
      <% else %>
        <div class="mt-4 pt-4 border-t border-line dark:border-slate-700">
          <a href="<%= new_session_path %>" class="block py-2 text-slate-700 dark:text-slate-200 hover:text-primary transition-colors">Iniciar Sesión</a>
        </div>
      <% end %>
    </div>
  </div>
</nav>
