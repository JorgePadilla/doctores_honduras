<nav class="bg-sky-500 dark:bg-slate-800 text-white shadow-lg dark:shadow-slate-900/50 transition-colors duration-200">
  <div class="container mx-auto px-4">
    <div class="flex justify-between items-center py-4">
      <!-- Logo/Brand -->
      <div class="flex items-center">
        <a href="/" class="text-xl font-bold text-white hover:text-primary-200 transition">
          Doctores Honduras
        </a>
      </div>

      <!-- Navigation Links -->
      <div class="hidden md:flex space-x-6">
        <a href="/" class="text-white hover:text-primary-200 transition">Inicio</a>
        <a href="/doctors" class="text-white hover:text-primary-200 transition">Doctores</a>
        <% if section_visible?("establishments") %>
          <a href="/hospitales-y-clinicas" class="text-white hover:text-primary-200 transition">Hospitales y Clínicas</a>
        <% end %>
        <% if section_visible?("suppliers") %>
          <a href="/proveedores" class="text-white hover:text-primary-200 transition">Proveedores</a>
        <% end %>
      </div>

      <!-- Authentication Links + Dark Mode Toggle -->
      <div class="flex items-center space-x-4">
        <!-- Dark Mode Toggle -->
        <button data-action="dark-mode#toggle" class="p-2 rounded-lg hover:bg-sky-600 dark:hover:bg-slate-700 transition-colors" title="Cambiar tema">
          <!-- Sun icon (shown in dark mode) -->
          <%= icon(:sun, class: "w-5 h-5 hidden", data: { dark_mode_target: "sunIcon" }) %>
          <!-- Moon icon (shown in light mode) -->
          <%= icon(:moon, class: "w-5 h-5", data: { dark_mode_target: "moonIcon" }) %>
        </button>

        <% if Current.user %>
          <div class="relative dropdown">
            <button id="user-menu-button" class="flex items-center text-white hover:text-primary-200 transition focus:outline-none">
              <span><%= Current.user.email %></span>
              <%= icon(:chevron_down, class: "h-5 w-5 ml-1") %>
            </button>
            <div id="user-dropdown" class="absolute right-0 mt-2 w-48 bg-white dark:bg-slate-800 rounded-md shadow-lg dark:shadow-slate-900/50 py-1 z-50 border border-transparent dark:border-slate-700" style="display: none;">
              <% if Current.user&.admin? %>
                <a href="<%= admin_dashboard_path %>" class="block px-4 py-2 text-sm text-gray-700 dark:text-slate-200 hover:bg-sky-50 dark:hover:bg-slate-700 bg-sky-50 dark:bg-slate-700/50 border-l-2 border-sky-500">Panel Admin</a>
              <% end %>
              <% if Current.user.profile_type != "paciente" %>
                <a href="<%= profile_path %>" class="block px-4 py-2 text-sm text-gray-700 dark:text-slate-200 hover:bg-sky-50 dark:hover:bg-slate-700">Mi Perfil</a>
              <% end %>
              <a href="<%= dashboard_path %>" class="block px-4 py-2 text-sm text-gray-700 dark:text-slate-200 hover:bg-sky-50 dark:hover:bg-slate-700">Panel de Control</a>
              <% if Current.user.profile_type == "vendor" %>
                <a href="<%= vendor_products_path %>" class="block px-4 py-2 text-sm text-gray-700 dark:text-slate-200 hover:bg-sky-50 dark:hover:bg-slate-700">Mis Productos</a>
              <% end %>
              <% if Current.user.profile_type == "paciente" %>
                <a href="<%= paciente_appointments_path %>" class="block px-4 py-2 text-sm text-gray-700 dark:text-slate-200 hover:bg-sky-50 dark:hover:bg-slate-700">Mis Citas</a>
                <a href="<%= paciente_profile_path %>" class="block px-4 py-2 text-sm text-gray-700 dark:text-slate-200 hover:bg-sky-50 dark:hover:bg-slate-700">Mi Perfil</a>
              <% end %>
              <% if (Current.user.profile_type == "doctor" && Current.user.subscription&.subscription_plan&.tier.in?(%w[profesional elite])) || Current.user.secretary? %>
                <a href="<%= agenda_appointments_path %>" class="block px-4 py-2 text-sm text-gray-700 dark:text-slate-200 hover:bg-sky-50 dark:hover:bg-slate-700">Agenda</a>
              <% end %>
              <a href="<%= settings_path %>" class="block px-4 py-2 text-sm text-gray-700 dark:text-slate-200 hover:bg-sky-50 dark:hover:bg-slate-700">Configuración</a>
              <div class="border-t border-gray-200 dark:border-slate-600"></div>
              <%= button_to "Cerrar Sesión", session_path, method: :delete, class: "w-full text-left px-4 py-2 text-sm text-gray-700 dark:text-slate-200 hover:bg-sky-50 dark:hover:bg-slate-700" %>
            </div>
          </div>
        <% else %>
          <a href="<%= new_session_path %>" class="text-white hover:text-primary-200 transition">Iniciar Sesión</a>
        <% end %>
      </div>

      <!-- Mobile Menu Button -->
      <div class="md:hidden">
        <button id="mobile-menu-button" class="text-white hover:text-primary-200 focus:outline-none" aria-label="Menú">
          <%= icon(:bars_3, class: "h-6 w-6") %>
        </button>
      </div>
    </div>

    <!-- Mobile Menu -->
    <div id="mobile-menu" class="md:hidden hidden pb-4">
      <a href="/" class="block py-2 text-white hover:text-primary-200 transition">Inicio</a>
      <a href="/doctors" class="block py-2 text-white hover:text-primary-200 transition">Doctores</a>
      <% if section_visible?("establishments") %>
        <a href="/hospitales-y-clinicas" class="block py-2 text-white hover:text-primary-200 transition">Hospitales y Clínicas</a>
      <% end %>
      <% if section_visible?("suppliers") %>
        <a href="/proveedores" class="block py-2 text-white hover:text-primary-200 transition">Proveedores</a>
      <% end %>
      <% if Current.user %>
        <div class="mt-4 pt-4 border-t border-primary-300 dark:border-slate-600">
          <div class="block py-2 text-white font-medium"><%= Current.user.email %></div>
          <% if Current.user&.admin? %>
            <a href="<%= admin_dashboard_path %>" class="block py-2 text-white hover:text-primary-200 transition bg-sky-900/20 border-l-2 border-sky-400 pl-2">Panel Admin</a>
          <% end %>
          <% if Current.user.profile_type != "paciente" %>
            <a href="<%= profile_path %>" class="block py-2 text-white hover:text-primary-200 transition">Mi Perfil</a>
          <% end %>
          <a href="<%= dashboard_path %>" class="block py-2 text-white hover:text-primary-200 transition">Panel de Control</a>
          <% if Current.user.profile_type == "vendor" %>
            <a href="<%= vendor_products_path %>" class="block py-2 text-white hover:text-primary-200 transition">Mis Productos</a>
          <% end %>
          <% if Current.user.profile_type == "paciente" %>
            <a href="<%= paciente_appointments_path %>" class="block py-2 text-white hover:text-primary-200 transition">Mis Citas</a>
            <a href="<%= paciente_profile_path %>" class="block py-2 text-white hover:text-primary-200 transition">Mi Perfil</a>
          <% end %>
          <% if (Current.user.profile_type == "doctor" && Current.user.subscription&.subscription_plan&.tier.in?(%w[profesional elite])) || Current.user.secretary? %>
            <a href="<%= agenda_appointments_path %>" class="block py-2 text-white hover:text-primary-200 transition">Agenda</a>
          <% end %>
          <a href="<%= settings_path %>" class="block py-2 text-white hover:text-primary-200 transition">Configuración</a>
          <%= button_to "Cerrar Sesión", session_path, method: :delete, class: "block w-full text-left py-2 text-white hover:text-primary-200 transition" %>
        </div>
      <% else %>
        <div class="mt-4 pt-4 border-t border-primary-300 dark:border-slate-600">
          <a href="<%= new_session_path %>" class="block py-2 text-white hover:text-primary-200 transition">Iniciar Sesión</a>
        </div>
      <% end %>
    </div>
  </div>
</nav>

<script>
  // Función para inicializar los menús
  function initializeMenus() {
    // Mobile menu toggle
    const mobileMenuButton = document.getElementById('mobile-menu-button');
    const mobileMenu = document.getElementById('mobile-menu');

    if (mobileMenuButton && mobileMenu) {
      mobileMenuButton.addEventListener('click', function() {
        mobileMenu.classList.toggle('hidden');
      });
    }

    // User dropdown menu toggle
    const userMenuButton = document.getElementById('user-menu-button');
    const userDropdown = document.getElementById('user-dropdown');

    if (userMenuButton && userDropdown) {
      // Variable para controlar el estado del menú
      let menuOpen = false;

      // Eliminar eventos anteriores para evitar duplicados
      userMenuButton.removeEventListener('click', handleUserMenuClick);

      // Función para manejar el clic en el menú de usuario
      function handleUserMenuClick(e) {
        e.preventDefault();
        e.stopPropagation();

        if (menuOpen) {
          userDropdown.style.display = 'none';
          menuOpen = false;
        } else {
          userDropdown.style.display = 'block';
          menuOpen = true;
        }
      }

      // Agregar el evento de clic
      userMenuButton.addEventListener('click', handleUserMenuClick);

      // Eliminar eventos anteriores para evitar duplicados
      document.removeEventListener('click', handleDocumentClick);

      // Función para manejar clics fuera del menú
      function handleDocumentClick(e) {
        if (menuOpen && !userMenuButton.contains(e.target) && !userDropdown.contains(e.target)) {
          userDropdown.style.display = 'none';
          menuOpen = false;
        }
      }

      // Agregar el evento de clic en el documento
      document.addEventListener('click', handleDocumentClick);
    }
  }

  // Inicializar menús cuando se carga la página
  document.addEventListener('DOMContentLoaded', initializeMenus);

  // Inicializar menús cuando se navega con Turbo
  document.addEventListener('turbo:load', initializeMenus);
  document.addEventListener('turbo:render', initializeMenus);
</script>
