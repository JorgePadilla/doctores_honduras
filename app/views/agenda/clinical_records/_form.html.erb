<%= form_with(model: @clinical_record, url: agenda_patient_clinical_record_path(@patient), class: "space-y-6") do |f| %>
  <%= render "shared/form_errors", model: @clinical_record %>

  <div class="card p-6 space-y-6">
    <div>
      <%= f.label :allergies, "Alergias e información crítica", class: "form-label" %>
      <%= f.text_area :allergies, rows: 2, class: "form-input" %>
      <p class="form-hint">Se mostrará como alerta destacada en el expediente y en las citas.</p>
    </div>

    <div>
      <%= f.label :chronic_conditions, "Condiciones crónicas", class: "form-label" %>
      <%= f.text_area :chronic_conditions, rows: 2, class: "form-input" %>
    </div>

    <div>
      <%= f.label :current_medications, "Medicamentos actuales", class: "form-label" %>
      <%= f.text_area :current_medications, rows: 2, class: "form-input" %>
    </div>

    <div>
      <%= f.label :blood_type, "Tipo de sangre", class: "form-label" %>
      <%= f.select :blood_type, ClinicalRecord::BLOOD_TYPES, { include_blank: "—" }, class: "form-input form-select" %>
    </div>

    <div>
      <%= f.label :medical_history, "Antecedentes", class: "form-label" %>
      <%= f.text_area :medical_history, rows: 3, class: "form-input" %>
    </div>

    <div>
      <%= f.label :notes, "Notas", class: "form-label" %>
      <%= f.text_area :notes, rows: 3, class: "form-input" %>
    </div>
  </div>

  <div class="mt-6 flex items-center justify-end gap-3">
    <%= link_to "Cancelar", agenda_patient_path(@patient), class: "btn-secondary" %>
    <%= f.submit "Guardar ficha", class: "btn-primary" %>
  </div>
<% end %>
