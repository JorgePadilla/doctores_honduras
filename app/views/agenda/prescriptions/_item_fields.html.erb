<div data-nested-fields-entry class="grid grid-cols-1 sm:grid-cols-4 gap-3 items-end border-b border-line dark:border-slate-700 pb-3">
  <div>
    <%= f.label :medication, "Medicamento", class: "form-label" %>
    <%= f.text_field :medication, class: "form-input" %>
  </div>
  <div>
    <%= f.label :dosage, "Dosis", class: "form-label" %>
    <%= f.text_field :dosage, class: "form-input" %>
  </div>
  <div>
    <%= f.label :frequency, "Frecuencia", class: "form-label" %>
    <%= f.text_field :frequency, class: "form-input" %>
  </div>
  <div>
    <%= f.label :duration, "Duración", class: "form-label" %>
    <%= f.text_field :duration, class: "form-input" %>
  </div>
  <div class="sm:col-span-4 flex justify-end">
    <%= f.hidden_field :_destroy %>
    <button type="button" data-action="nested-fields#remove" class="text-sm text-red-600 dark:text-red-400 hover:underline">Quitar</button>
  </div>
</div>
