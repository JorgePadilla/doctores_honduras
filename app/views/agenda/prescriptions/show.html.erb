<div class="max-w-3xl mx-auto">
  <div class="no-print flex items-center justify-between mb-6">
    <%= link_to "← Volver a la cita", agenda_appointment_path(@appointment), class: "text-sky-600 hover:underline text-sm font-medium" %>
    <button onclick="window.print()" class="btn-primary">
      Imprimir
    </button>
  </div>

  <div class="bg-white rounded-xl shadow p-8">
    <div class="flex items-start justify-between border-b border-line pb-6 mb-6">
      <div>
        <p class="text-2xl font-bold text-ink"><%= @appointment.doctor_profile.name %></p>
        <% if @appointment.doctor_profile.medical_license.present? %>
          <p class="text-sm text-muted mt-1">Cédula/Colegiación: <%= @appointment.doctor_profile.medical_license %></p>
        <% end %>
      </div>
      <div class="text-right text-sm text-muted">
        <%= I18n.l(@appointment.appointment_date, format: :long) %>
      </div>
    </div>

    <p class="text-ink mb-1"><span class="font-semibold">Paciente:</span> <%= @appointment.patient_name %></p>
    <% if @appointment.patient&.identity_document.present? %>
      <p class="text-gray-700 text-sm mb-6"><span class="font-semibold">DNI:</span> <%= @appointment.patient.identity_document %></p>
    <% else %>
      <div class="mb-6"></div>
    <% end %>

    <div class="mb-8">
      <p class="text-3xl font-serif italic text-ink mb-4">Rp.</p>
      <ol class="space-y-4">
        <% @prescription.prescription_items.each do |item| %>
          <% details = [ item.dosage, item.frequency, item.duration ].reject(&:blank?).join(" · ") %>
          <li class="text-ink">
            <span class="font-bold"><%= item.medication %></span>
            <% if details.present? %>
              <span class="text-muted"> — <%= details %></span>
            <% end %>
          </li>
        <% end %>
      </ol>
    </div>

    <% if @prescription.instructions.present? %>
      <div class="mb-8">
        <p class="text-sm font-semibold text-gray-700 mb-1">Indicaciones generales</p>
        <p class="text-ink whitespace-pre-line"><%= @prescription.instructions %></p>
      </div>
    <% end %>

    <div class="mt-16 pt-2">
      <hr class="border-t border-gray-400 w-64 mx-auto">
      <p class="text-center text-sm text-muted mt-2">Firma y sello</p>
    </div>
  </div>
</div>
