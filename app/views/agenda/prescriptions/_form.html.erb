<%= form_with(model: @prescription, url: agenda_appointment_prescription_path(@appointment), method: :patch, class: "space-y-6") do |f| %>
  <div class="bg-white dark:bg-slate-800 rounded-xl shadow-md dark:shadow-slate-900/50 p-6 space-y-6">
    <% if @prescription.errors.any? %>
      <div class="bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-800 rounded-xl p-4">
        <ul class="list-disc list-inside text-sm text-red-700 dark:text-red-300 space-y-1">
          <% @prescription.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div data-controller="nested-fields">
      <div class="flex items-center justify-between mb-2">
        <h2 class="text-lg font-semibold text-gray-900 dark:text-white">Medicamentos</h2>
      </div>

      <div data-nested-fields-target="container" class="space-y-3">
        <%= f.fields_for :prescription_items do |item_form| %>
          <%= render "item_fields", f: item_form %>
        <% end %>
      </div>

      <template data-nested-fields-target="template">
        <%= f.fields_for :prescription_items, PrescriptionItem.new, child_index: "NEW_RECORD" do |item_form| %>
          <%= render "item_fields", f: item_form %>
        <% end %>
      </template>

      <button type="button" data-action="nested-fields#add" data-nested-fields-target="addButton"
              class="mt-3 inline-flex items-center px-4 py-1.5 text-sm font-medium text-white bg-sky-500 rounded-full transition-all hover:shadow-md transform hover:scale-105 hover:bg-sky-600 dark:bg-sky-600 dark:hover:bg-sky-500">
        ＋ Agregar medicamento
      </button>
    </div>

    <div>
      <%= f.label :instructions, "Indicaciones generales", class: "block text-sm font-medium text-gray-700 dark:text-slate-300 mb-1" %>
      <%= f.text_area :instructions, rows: 3, class: "w-full rounded-lg border-gray-300 dark:border-slate-600 dark:bg-slate-700 dark:text-white focus:ring-sky-500 focus:border-sky-500" %>
    </div>

    <div class="flex justify-end space-x-3">
      <%= link_to "Cancelar", agenda_appointment_path(@appointment), class: "inline-flex items-center border border-gray-300 dark:border-slate-600 text-gray-700 dark:text-slate-300 hover:bg-gray-50 dark:hover:bg-slate-700 px-5 py-2 rounded-full font-medium transition-all" %>
      <%= f.submit "Guardar receta", class: "inline-flex items-center bg-sky-500 hover:bg-sky-600 text-white px-5 py-2.5 rounded-full font-medium transition-all shadow-md hover:shadow-lg transform hover:scale-105 cursor-pointer" %>
    </div>
  </div>
<% end %>
