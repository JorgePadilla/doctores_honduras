<%= form_with(model: @prescription, url: agenda_appointment_prescription_path(@appointment), method: :patch, class: "space-y-6") do |f| %>
  <%= render "shared/form_errors", model: @prescription %>

  <div class="card p-6 space-y-6">
    <div data-controller="nested-fields">
      <div class="flex items-center justify-between mb-2">
        <h2 class="text-lg font-semibold text-ink dark:text-white">Medicamentos</h2>
      </div>

      <div data-nested-fields-target="container" class="space-y-3">
        <%= f.fields_for :prescription_items do |item_form| %>
          <%= render "item_fields", f: item_form %>
        <% end %>
      </div>

      <template data-nested-fields-target="template">
        <%= f.fields_for :prescription_items, PrescriptionItem.new, child_index: "NEW_RECORD" do |item_form| %>
          <%= render "item_fields", f: item_form %>
        <% end %>
      </template>

      <button type="button" data-action="nested-fields#add" data-nested-fields-target="addButton"
              class="btn-secondary btn-sm mt-3">
        <%= icon(:plus, class: "w-4 h-4") %> Agregar medicamento
      </button>
    </div>

    <div>
      <%= f.label :instructions, "Indicaciones generales", class: "form-label" %>
      <%= f.text_area :instructions, rows: 3, class: "form-input" %>
    </div>
  </div>

  <div class="mt-6 flex items-center justify-end gap-3">
    <%= link_to "Cancelar", agenda_appointment_path(@appointment), class: "btn-secondary" %>
    <%= f.submit "Guardar receta", class: "btn-primary" %>
  </div>
<% end %>
