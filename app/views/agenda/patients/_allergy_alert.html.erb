<%#
  Alerta de seguridad: alergias e info crítica del paciente (G2).
  Se renderiza donde el médico necesita verla (ficha del paciente, detalle de cita).
  Requiere una ficha clínica (Elite) con alergias cargadas; si no, no muestra nada.
  Espera la variable local `patient` (un Patient).
%>
<% if patient&.allergies? %>
  <div class="mb-6 flex items-start gap-3 rounded-xl bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-800 p-4" role="alert">
    <%= icon(:exclamation_triangle, class: "h-6 w-6 flex-shrink-0 text-red-500 dark:text-red-400") %>
    <div class="min-w-0">
      <h3 class="text-sm font-semibold text-red-800 dark:text-red-300">Alergias e información crítica</h3>
      <p class="mt-1 text-sm text-red-700 dark:text-red-400 whitespace-pre-line"><%= patient.allergies %></p>
    </div>
  </div>
<% end %>
