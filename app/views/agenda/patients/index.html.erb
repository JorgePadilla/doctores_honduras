<div class="max-w-4xl mx-auto">
  <%= render "shared/page_header", title: "Mis Pacientes" %>

  <%= render "agenda/nav", active: :pacientes %>

  <% if @patients.any? %>
    <div class="card overflow-hidden">
      <div class="divide-y divide-line dark:divide-slate-700">
        <% @patients.each do |patient| %>
          <%= link_to agenda_patient_path(patient), class: "block p-4 hover:bg-slate-50 dark:hover:bg-slate-700/50 transition-colors" do %>
            <div class="flex items-center justify-between gap-3">
              <div class="min-w-0 flex-1">
                <p class="font-semibold text-ink dark:text-white"><%= patient.name %></p>
                <p class="text-sm text-muted dark:text-slate-400 truncate">
                  <%= patient.email %>
                  <% if patient.phone.present? %>
                    &middot; <%= patient.phone %>
                  <% end %>
                </p>
              </div>
              <div class="text-right shrink-0">
                <p class="text-sm font-medium text-sky-600 dark:text-sky-400"><%= patient.appointment_count %> cita(s)</p>
                <p class="text-sm text-muted dark:text-slate-500">Última: <%= patient.last_visit&.strftime("%d/%m/%Y") %></p>
              </div>
            </div>
          <% end %>
        <% end %>
      </div>
    </div>
  <% else %>
    <div class="card p-8 text-center">
      <%= icon(:user_circle, class: "mx-auto w-12 h-12 text-slate-300 dark:text-slate-600 mb-3") %>
      <p class="text-muted dark:text-slate-400 text-sm">Aún no tienes pacientes registrados.</p>
    </div>
  <% end %>
</div>
