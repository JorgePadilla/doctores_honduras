<div class="max-w-4xl mx-auto">
  <% subtitle = [
       ("DNI: #{@patient.identity_document}" if @patient.identity_document.present?),
       @patient.display_contact.presence
     ].compact.join(" · ").presence %>
  <%= render "shared/page_header",
        title: @patient.name,
        subtitle: subtitle,
        back: { label: "Volver a pacientes", path: agenda_patients_path } %>

  <%= render "agenda/patients/allergy_alert", patient: @patient %>

  <!-- Expediente clínico (ficha) -->
  <div class="card p-6 mb-6">
    <div class="flex items-center justify-between mb-4">
      <h2 class="text-lg font-semibold text-ink dark:text-white">Expediente clínico</h2>
      <% if current_doctor_elite? %>
        <% if @clinical_record %>
          <%= link_to "Editar ficha", edit_agenda_patient_clinical_record_path(@patient), class: "text-sm font-medium text-sky-600 dark:text-sky-400 hover:underline" %>
        <% else %>
          <%= link_to "Crear ficha", new_agenda_patient_clinical_record_path(@patient), class: "text-sm font-medium text-sky-600 dark:text-sky-400 hover:underline" %>
        <% end %>
      <% end %>
    </div>

    <% if !current_doctor_elite? %>
      <div class="rounded-lg bg-sky-50 dark:bg-sky-900/20 border border-sky-200 dark:border-sky-800 p-4 text-sm text-sky-800 dark:text-sky-300">
        El <strong>Expediente Clínico Digital</strong> (alergias, condiciones crónicas, medicamentos y antecedentes) está disponible en el plan <strong>Elite</strong>.
        <%= link_to "Ver planes", settings_subscription_path, class: "underline font-medium" %>
      </div>
    <% elsif @clinical_record && !@clinical_record.blank_record? %>
      <%= render "agenda/patients/clinical_summary", record: @clinical_record %>
    <% else %>
      <p class="text-sm text-muted dark:text-slate-400">Aún no hay ficha clínica para este paciente.</p>
    <% end %>
  </div>

  <h2 class="text-lg font-semibold text-ink dark:text-white mb-4">Historial de Citas (<%= @appointments.size %>)</h2>

  <div class="space-y-3">
    <% @appointments.each do |apt| %>
      <%= link_to agenda_appointment_path(apt), class: "block card card-hover card-accent #{apt.status_classes[:border]} p-5" do %>
        <div class="flex items-center justify-between">
          <div>
            <p class="text-sm text-ink dark:text-white font-medium">
              <%= apt.appointment_date.strftime("%d/%m/%Y") %> &middot; <%= apt.start_time.strftime("%H:%M") %> - <%= apt.end_time.strftime("%H:%M") %>
            </p>
            <p class="text-sm text-muted dark:text-slate-400"><%= apt.doctor_branch&.name %></p>
            <% if apt.reason.present? %>
              <p class="text-sm text-muted dark:text-slate-500 mt-1"><%= truncate(apt.reason, length: 60) %></p>
            <% end %>
          </div>
          <span class="text-sm px-3 py-1 rounded-full font-medium <%= apt.status_classes[:bg] %> <%= apt.status_classes[:text] %>"><%= apt.status_label %></span>
        </div>
      <% end %>
    <% end %>
  </div>
</div>
