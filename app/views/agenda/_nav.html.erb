<%# Agenda section tabs. render "agenda/nav", active: :citas %>
<% tabs = [ { key: :citas, label: "Citas", path: agenda_appointments_path, icon: :calendar_days },
            { key: :pacientes, label: "Pacientes", path: agenda_patients_path, icon: :user } ] %>
<% tabs << { key: :secretarias, label: "Secretarias", path: agenda_secretaries_path, icon: :user_circle } unless acting_as_secretary? %>
<% tabs << { key: :ajustes, label: "Ajustes", path: agenda_settings_path, icon: :cog_6_tooth } %>
<%= render "shared/section_tabs", tabs: tabs, active: active %>
