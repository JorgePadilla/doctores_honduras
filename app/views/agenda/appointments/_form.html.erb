<%= form_with(model: appointment, url: form_url, class: "space-y-6", data: { controller: "slot-picker" }) do |f| %>
  <%= render "shared/form_errors", model: appointment %>

  <div class="card p-6 space-y-6">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <!-- Ubicación -->
      <div>
        <label class="form-label">Ubicación *</label>
        <%= f.select :doctor_branch_id, options_from_collection_for_select(branches, :id, :name, appointment.doctor_branch_id),
            { prompt: "Selecciona una ubicación" },
            { class: "form-input form-select",
              data: { slot_picker_target: "branchSelect", action: "change->slot-picker#loadSlots" } } %>
      </div>

      <!-- Fecha -->
      <div>
        <label class="form-label">Fecha *</label>
        <%= f.text_field :appointment_date, value: appointment.appointment_date&.to_s,
            class: "form-input",
            data: { controller: "datepicker", slot_picker_target: "dateInput", action: "change->slot-picker#loadSlots" },
            placeholder: "Selecciona una fecha", autocomplete: "off" %>
      </div>
    </div>

    <% current_duration = (appointment.persisted? && appointment.duration_minutes.positive?) ? appointment.duration_minutes : (appointment.doctor_profile&.agenda_setting&.appointment_duration || 30) %>
    <% duration_choices = (Appointment::DURATION_OPTIONS + [ current_duration ]).uniq.sort %>

    <!-- Duración -->
    <div>
      <label class="form-label">Duración</label>
      <div class="md:w-1/2">
        <%= f.select :requested_duration,
            options_for_select(duration_choices.map { |d| [ "#{d} minutos", d ] }, current_duration),
            {},
            { class: "form-input form-select",
              data: { slot_picker_target: "durationSelect", action: "change->slot-picker#durationChanged" } } %>
      </div>
      <p class="form-hint">Ajusta la duración de esta cita (mínimo 15 minutos).</p>
    </div>

    <!-- Horarios disponibles -->
    <div>
      <label class="form-label">Horario *</label>
      <div data-slot-picker-target="slotsContainer" class="grid grid-cols-4 md:grid-cols-6 gap-2">
        <p class="col-span-full text-sm text-muted dark:text-slate-400">Selecciona ubicación y fecha para ver horarios disponibles.</p>
      </div>
      <%= f.hidden_field :start_time, data: { slot_picker_target: "startTime" } %>
      <%= f.hidden_field :end_time, data: { slot_picker_target: "endTime" } %>
    </div>

    <!-- Sobrecupo -->
    <div class="flex items-start gap-3 rounded-lg bg-amber-50 dark:bg-amber-900/20 border border-amber-200 dark:border-amber-800 p-4">
      <div class="flex h-5 items-center">
        <%= f.check_box :sobrecupo, class: "rounded border-amber-300 dark:border-amber-700 text-amber-500 focus:ring-amber-500 dark:bg-slate-700" %>
      </div>
      <div>
        <label class="block text-sm font-medium text-amber-800 dark:text-amber-300">Sobrecupo</label>
        <p class="text-sm text-amber-700 dark:text-amber-400">Permite agendar esta cita aunque el horario esté lleno. No cuenta contra el límite de citas simultáneas.</p>
      </div>
    </div>

    <div class="border-t border-line dark:border-slate-700 pt-6" data-controller="patient-search">
      <h3 class="text-sm font-semibold text-primary-700 dark:text-sky-400 mb-4">Datos del paciente</h3>
      <%= f.hidden_field :patient_user_id, data: { patient_search_target: "patientUserIdField" } %>
      <%= f.hidden_field :patient_id, data: { patient_search_target: "patientIdField" } %>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <!-- Nombre del paciente (with auto-suggest) -->
        <div class="relative">
          <label class="form-label">Nombre del paciente *</label>
          <%= f.text_field :patient_name, class: "form-input", required: true, autocomplete: "off", data: { patient_search_target: "input", action: "input->patient-search#search" } %>
          <div data-patient-search-target="dropdown" class="hidden absolute z-20 w-full mt-1 bg-white dark:bg-slate-800 border border-line dark:border-slate-600 rounded-lg shadow-lg max-h-48 overflow-y-auto"></div>
        </div>

        <!-- Telefono -->
        <div>
          <label class="form-label">Teléfono</label>
          <%= f.telephone_field :patient_phone, class: "form-input", data: { patient_search_target: "phoneField" } %>
        </div>

        <!-- Email -->
        <div>
          <label class="form-label">Correo electrónico</label>
          <%= f.email_field :patient_email, class: "form-input", data: { patient_search_target: "emailField" } %>
        </div>

        <!-- DNI (solo lectura; se llena al seleccionar un paciente conocido) -->
        <div>
          <label class="form-label">DNI</label>
          <input type="text" readonly placeholder="Se completa al elegir un paciente"
                 data-patient-search-target="dniField"
                 class="form-input cursor-not-allowed">
        </div>

        <% if appointment.persisted? %>
          <!-- Status -->
          <div>
            <label class="form-label">Estado</label>
            <%= f.select :status, Appointment::STATUSES.map { |s| [s.capitalize, s] },
                {},
                { class: "form-input form-select" } %>
          </div>
        <% end %>
      </div>
    </div>

    <!-- Motivo -->
    <div>
      <label class="form-label">Motivo de la consulta</label>
      <%= f.text_area :reason, rows: 3, class: "form-input" %>
    </div>

    <!-- Notas del doctor -->
    <% if !appointment.new_record? %>
      <div>
        <label class="form-label">Notas del doctor</label>
        <%= f.text_area :doctor_notes, rows: 3, class: "form-input" %>
      </div>
    <% end %>
  </div>

  <div class="mt-6 flex items-center justify-end gap-3">
    <%= link_to "Cancelar", agenda_appointments_path, class: "btn-secondary" %>
    <%= f.submit appointment.persisted? ? "Actualizar Cita" : "Crear Cita", class: "btn-primary" %>
  </div>
<% end %>
