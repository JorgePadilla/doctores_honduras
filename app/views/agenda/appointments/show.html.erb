<div class="max-w-3xl mx-auto">
  <% actions = capture do %>
    <%= link_to "Editar", edit_agenda_appointment_path(@appointment), class: "btn-secondary" %>
    <% unless @appointment.cancelada? %>
      <%= button_to "Cancelar cita", agenda_appointment_path(@appointment), method: :delete,
          class: "btn-danger",
          data: { turbo_confirm: "¿Estás seguro de cancelar esta cita?" } %>
    <% end %>
  <% end %>
  <%= render "shared/page_header",
        title: "Detalle de cita",
        back: { label: "Volver a la agenda", path: agenda_appointments_path },
        actions: actions %>

  <%= render "agenda/patients/allergy_alert", patient: @appointment.patient %>

  <div class="card card-accent <%= @appointment.status_classes[:border] %> p-6 space-y-6">
    <!-- Status badge -->
    <div class="flex flex-wrap items-center gap-3">
      <%= render "agenda/status_badge", appointment: @appointment %>
      <span class="text-sm text-muted dark:text-slate-400">
        <%= @appointment.booking_source == "public_booking" ? "Reserva en línea" : "Cita manual" %>
      </span>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div>
        <h3 class="text-sm font-medium text-muted dark:text-slate-400 mb-1">Paciente</h3>
        <p class="text-sky-700 dark:text-sky-400 font-semibold text-lg"><%= @appointment.patient_name %></p>
        <% if @appointment.patient_phone.present? %>
          <p class="text-sm text-muted dark:text-slate-300 mt-1"><%= @appointment.patient_phone %></p>
        <% end %>
        <% if @appointment.patient_email.present? %>
          <p class="text-sm text-muted dark:text-slate-300 break-words"><%= @appointment.patient_email %></p>
        <% end %>
      </div>

      <div>
        <h3 class="text-sm font-medium text-muted dark:text-slate-400 mb-1">Fecha y Hora</h3>
        <p class="text-ink dark:text-white font-semibold"><%= I18n.l(@appointment.appointment_date, format: :long) %></p>
        <p class="text-sm text-muted dark:text-slate-300 mt-1"><%= @appointment.start_time.strftime("%H:%M") %> - <%= @appointment.end_time.strftime("%H:%M") %> (<%= @appointment.duration_minutes %> min)</p>
      </div>

      <div>
        <h3 class="text-sm font-medium text-muted dark:text-slate-400 mb-1">Ubicación</h3>
        <p class="text-ink dark:text-white font-semibold"><%= @appointment.doctor_branch.name %></p>
        <p class="text-sm text-muted dark:text-slate-300 mt-1"><%= @appointment.doctor_branch.address %></p>
      </div>

      <% if @appointment.created_by %>
        <div>
          <h3 class="text-sm font-medium text-muted dark:text-slate-400 mb-1">Creada por</h3>
          <p class="text-ink dark:text-white break-words"><%= @appointment.created_by.email %></p>
        </div>
      <% end %>
    </div>

    <% if @appointment.reason.present? %>
      <div class="border-t border-line dark:border-slate-700 pt-6">
        <h3 class="text-sm font-medium text-muted dark:text-slate-400 mb-1">Motivo</h3>
        <p class="text-ink dark:text-slate-300"><%= @appointment.reason %></p>
      </div>
    <% end %>

    <% if @appointment.doctor_notes.present? %>
      <div class="border-t border-line dark:border-slate-700 pt-6">
        <h3 class="text-sm font-medium text-muted dark:text-slate-400 mb-1">Notas del doctor</h3>
        <p class="text-ink dark:text-slate-300"><%= @appointment.doctor_notes %></p>
      </div>
    <% end %>
  </div>

  <!-- Documentación clínica de la consulta (H1 nota + H3 vitales + H2 receta) — Elite -->
  <% if current_doctor_elite? %>
    <div class="card p-6 mt-6 space-y-6">
      <h2 class="card-title">Documentación clínica</h2>

      <div>
        <div class="flex items-center justify-between mb-2">
          <h3 class="text-sm font-semibold text-ink dark:text-slate-300">Nota de evolución y signos vitales</h3>
          <%= link_to (@appointment.encounter&.any_data? ? "Editar" : "Documentar"), edit_agenda_appointment_encounter_path(@appointment), class: "text-sm font-medium text-sky-600 dark:text-sky-400 hover:underline" %>
        </div>
        <%= render "agenda/appointments/encounter_summary", encounter: @appointment.encounter %>
      </div>

      <div class="border-t border-line dark:border-slate-700 pt-6">
        <div class="flex items-center justify-between mb-2">
          <h3 class="text-sm font-semibold text-ink dark:text-slate-300">Receta</h3>
          <div class="flex items-center gap-3">
            <%= link_to "Editar receta", edit_agenda_appointment_prescription_path(@appointment), class: "text-sm font-medium text-sky-600 dark:text-sky-400 hover:underline" %>
            <% if @appointment.prescription&.any_items? %>
              <%= link_to "Ver / imprimir", agenda_appointment_prescription_path(@appointment), class: "text-sm font-medium text-sky-600 dark:text-sky-400 hover:underline" %>
            <% end %>
          </div>
        </div>
        <%= render "agenda/appointments/prescription_summary", prescription: @appointment.prescription %>
      </div>

      <div class="border-t border-line dark:border-slate-700 pt-6">
        <h3 class="text-sm font-semibold text-ink dark:text-slate-300 mb-2">Adjuntos / resultados de laboratorio</h3>
        <% if @appointment.lab_attachments.attached? %>
          <ul class="space-y-2 mb-3">
            <% @appointment.lab_attachments.each do |att| %>
              <li class="flex items-center justify-between gap-3 text-sm">
                <%= link_to att.filename, rails_blob_path(att, disposition: "attachment"), target: "_blank", class: "text-sky-600 dark:text-sky-400 hover:underline truncate" %>
                <span class="text-muted dark:text-slate-500 text-xs whitespace-nowrap"><%= number_to_human_size(att.byte_size) %></span>
                <%= button_to "Eliminar", agenda_appointment_attachment_path(@appointment, att.id), method: :delete, class: "text-xs text-red-600 dark:text-red-400 hover:underline", form: { data: { turbo_confirm: "¿Eliminar este adjunto?" } } %>
              </li>
            <% end %>
          </ul>
        <% else %>
          <p class="text-sm text-muted dark:text-slate-400 mb-3">Sin adjuntos.</p>
        <% end %>
        <%= form_with url: agenda_appointment_attachments_path(@appointment), method: :post, multipart: true, class: "flex flex-wrap items-center gap-3" do %>
          <input type="file" name="files[]" multiple accept="application/pdf,image/*"
                 class="w-full min-w-0 sm:w-auto text-sm text-muted dark:text-slate-300 file:mr-3 file:rounded-full file:border-0 file:bg-sky-50 dark:file:bg-sky-900/30 file:px-4 file:py-2 file:text-sky-700 dark:file:text-sky-300 file:font-medium">
          <%= submit_tag "Subir", class: "btn-primary cursor-pointer" %>
        <% end %>
        <p class="mt-2 text-xs text-muted dark:text-slate-500">PDF o imágenes, hasta 10 MB. Almacenamiento privado con enlaces firmados.</p>
      </div>
    </div>
  <% else %>
    <div class="bg-sky-50 dark:bg-sky-900/20 border border-sky-200 dark:border-sky-800 rounded-xl p-4 mt-6 text-sm text-sky-800 dark:text-sky-300">
      Documentá la consulta (nota de evolución, signos vitales y receta imprimible) con el plan <strong>Elite</strong>.
      <%= link_to "Ver planes", settings_subscription_path, class: "underline font-medium" %>
    </div>
  <% end %>
</div>
