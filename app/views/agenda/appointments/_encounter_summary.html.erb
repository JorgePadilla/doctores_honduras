<%#
  Resumen de solo lectura de la consulta (nota de evolución + signos vitales).
  Espera la variable local `encounter` (puede ser nil).
%>
<% if encounter&.any_data? %>
  <% if encounter.vitals? %>
    <dl class="grid grid-cols-2 sm:grid-cols-3 gap-3 text-sm mb-3">
      <% {
        "Presión arterial" => encounter.blood_pressure,
        "Frec. cardíaca" => (encounter.heart_rate ? "#{encounter.heart_rate} lpm" : nil),
        "Temperatura" => (encounter.temperature ? "#{encounter.temperature} °C" : nil),
        "Frec. respiratoria" => (encounter.respiratory_rate ? "#{encounter.respiratory_rate} rpm" : nil),
        "Saturación O₂" => (encounter.oxygen_saturation ? "#{encounter.oxygen_saturation} %" : nil),
        "Peso" => (encounter.weight ? "#{encounter.weight} kg" : nil),
        "Altura" => (encounter.height ? "#{encounter.height} cm" : nil)
      }.each do |label, value| %>
        <% if value.present? %>
          <div>
            <dt class="text-muted dark:text-slate-400"><%= label %></dt>
            <dd class="text-ink dark:text-white font-medium"><%= value %></dd>
          </div>
        <% end %>
      <% end %>
    </dl>
  <% end %>
  <% if encounter.evolution_note.present? %>
    <div>
      <h4 class="text-sm font-medium text-muted dark:text-slate-400 mb-1">Nota de evolución</h4>
      <p class="text-ink dark:text-slate-300 whitespace-pre-line"><%= encounter.evolution_note %></p>
    </div>
  <% end %>
<% else %>
  <p class="text-sm text-muted dark:text-slate-400">Sin nota ni signos vitales.</p>
<% end %>
