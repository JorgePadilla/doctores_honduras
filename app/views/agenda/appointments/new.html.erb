<div class="max-w-3xl mx-auto">
  <%= render "shared/page_header", title: "Nueva Cita" %>

  <% if @branches.any? %>
    <%= render "form", appointment: @appointment, branches: @branches, form_url: agenda_appointments_path %>
  <% else %>
    <div class="rounded-xl bg-amber-50 dark:bg-amber-900/20 border border-amber-200 dark:border-amber-800 p-8 text-center">
      <%= icon(:exclamation_triangle, class: "w-12 h-12 text-amber-500 mx-auto mb-3") %>
      <h3 class="text-lg font-semibold text-amber-800 dark:text-amber-300 mb-2">No tienes ubicaciones configuradas</h3>
      <p class="text-amber-700 dark:text-amber-400 text-sm mb-4">Agrega al menos una ubicación con horarios para poder crear citas.</p>
      <%= link_to "Configurar ubicaciones", edit_profile_path, class: "btn-primary" %>
    </div>
  <% end %>
</div>
