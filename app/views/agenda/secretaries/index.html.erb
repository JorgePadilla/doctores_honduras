<div class="max-w-3xl mx-auto">
  <% actions = capture do %>
    <%= link_to new_agenda_secretary_path, class: "btn-primary" do %>
      <%= icon(:plus, class: "w-4 h-4") %> Agregar secretaria
    <% end %>
  <% end %>
  <%= render "shared/page_header", title: "Secretarias", actions: actions %>

  <%= render "agenda/nav", active: :secretarias %>

  <% if @assignments.any? %>
    <div class="card overflow-hidden">
      <% @assignments.each do |assignment| %>
        <div class="flex items-center justify-between p-5 border-b border-line dark:border-slate-700 last:border-b-0 hover:bg-slate-50 dark:hover:bg-slate-700/50 transition-colors">
          <div class="flex items-center space-x-3">
            <div class="w-10 h-10 rounded-full bg-sky-100 dark:bg-sky-900/30 flex items-center justify-center">
              <span class="text-sky-600 dark:text-sky-400 text-sm font-bold"><%= assignment.user.email.first.upcase %></span>
            </div>
            <div>
              <p class="font-medium text-ink dark:text-white"><%= assignment.user.email %></p>
              <p class="text-sm text-muted dark:text-slate-400">
                <% if assignment.active? %>
                  <span class="inline-flex items-center px-2 py-0.5 rounded-full text-sm font-medium bg-green-100 dark:bg-green-900/30 text-green-800 dark:text-green-300">Activa</span>
                <% else %>
                  <span class="inline-flex items-center px-2 py-0.5 rounded-full text-sm font-medium bg-red-100 dark:bg-red-900/30 text-red-800 dark:text-red-300">Revocada</span>
                <% end %>
                <span class="ml-1">Asignada <%= time_ago_in_words(assignment.created_at) %> atrás</span>
              </p>
            </div>
          </div>
          <% if assignment.active? %>
            <%= button_to "Revocar", agenda_secretary_path(assignment), method: :delete,
                class: "btn-danger btn-sm",
                data: { turbo_confirm: "¿Revocar acceso de esta secretaria?" } %>
          <% end %>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="card p-8 text-center">
      <%= icon(:user_circle, class: "mx-auto w-12 h-12 text-slate-300 dark:text-slate-600 mb-4") %>
      <p class="text-muted dark:text-slate-400 font-medium mb-2">No tienes secretarias asignadas</p>
      <p class="text-sm text-muted dark:text-slate-500 mb-4">Agrega secretarias para que te ayuden a gestionar tu agenda</p>
      <%= link_to "Agregar tu primera secretaria", new_agenda_secretary_path, class: "btn-primary" %>
    </div>
  <% end %>
</div>
