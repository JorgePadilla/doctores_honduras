<div class="max-w-lg mx-auto">
  <%= render "shared/page_header",
        title: "Agregar secretaria",
        back: { label: "Volver a secretarias", path: agenda_secretaries_path } %>

  <div class="card p-6">
    <p class="text-sm text-muted dark:text-slate-400 mb-6">
      Ingresa el correo electrónico de la persona que deseas asignar como secretaria.
      Debe tener una cuenta registrada en Doctores Honduras.
    </p>

    <%= render "shared/form_errors", model: @assignment %>

    <%= form_with(model: @assignment, url: agenda_secretaries_path, class: "space-y-6") do |f| %>
      <div>
        <%= f.label :invited_email, "Correo electrónico *", class: "form-label" %>
        <%= f.email_field :invited_email, class: "form-input", required: true, placeholder: "secretaria@ejemplo.com" %>
      </div>

      <div class="flex items-center justify-end gap-3">
        <%= link_to "Cancelar", agenda_secretaries_path, class: "btn-secondary" %>
        <%= f.submit "Asignar secretaria", class: "btn-primary" %>
      </div>
    <% end %>
  </div>
</div>
