<%= form_with(model: @encounter, url: agenda_appointment_encounter_path(@appointment), method: :patch, class: "space-y-6") do |f| %>
  <%= render "shared/form_errors", model: @encounter %>

  <div class="card p-6 space-y-6">
    <div>
      <%= f.label :evolution_note, "Nota de evolución", class: "form-label" %>
      <%= f.text_area :evolution_note, rows: 4, class: "form-input" %>
      <p class="form-hint">Uso interno del médico; no se muestra al paciente.</p>
    </div>

    <h3 class="text-sm font-semibold text-gray-700 dark:text-slate-300 border-t border-line dark:border-slate-700 pt-6">Signos vitales</h3>

    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
      <div>
        <%= f.label :blood_pressure, "Presión arterial", class: "form-label" %>
        <%= f.text_field :blood_pressure, placeholder: "120/80", class: "form-input" %>
      </div>

      <div>
        <%= f.label :heart_rate, "Frec. cardíaca (lpm)", class: "form-label" %>
        <%= f.number_field :heart_rate, class: "form-input" %>
      </div>

      <div>
        <%= f.label :temperature, "Temperatura (°C)", class: "form-label" %>
        <%= f.number_field :temperature, step: 0.1, class: "form-input" %>
      </div>

      <div>
        <%= f.label :respiratory_rate, "Frec. respiratoria (rpm)", class: "form-label" %>
        <%= f.number_field :respiratory_rate, class: "form-input" %>
      </div>

      <div>
        <%= f.label :oxygen_saturation, "Saturación O₂ (%)", class: "form-label" %>
        <%= f.number_field :oxygen_saturation, class: "form-input" %>
      </div>

      <div>
        <%= f.label :weight, "Peso (kg)", class: "form-label" %>
        <%= f.number_field :weight, step: 0.01, class: "form-input" %>
      </div>

      <div>
        <%= f.label :height, "Altura (cm)", class: "form-label" %>
        <%= f.number_field :height, step: 0.01, class: "form-input" %>
      </div>
    </div>
  </div>

  <div class="mt-6 flex items-center justify-end gap-3">
    <%= link_to "Cancelar", agenda_appointment_path(@appointment), class: "btn-secondary" %>
    <%= f.submit "Guardar", class: "btn-primary" %>
  </div>
<% end %>
