<div class="max-w-4xl mx-auto">
  <%= render "shared/page_header", title: "Mis Citas" %>

  <!-- Upcoming -->
  <div class="mb-8">
    <h2 class="text-lg font-semibold text-ink dark:text-white mb-4">Próximas Citas</h2>
    <% if @upcoming.any? %>
      <div class="space-y-3">
        <% @upcoming.each do |apt| %>
          <%= link_to paciente_appointment_path(apt), class: "block card card-hover card-accent #{apt.status_classes[:border]} p-5" do %>
            <div class="flex items-start justify-between gap-3">
              <div>
                <p class="font-semibold text-ink dark:text-white"><%= apt.doctor_profile.display_name %></p>
                <p class="text-sm text-muted dark:text-slate-400"><%= apt.doctor_profile.specialty&.name %></p>
                <p class="text-sm text-muted dark:text-slate-300 mt-1">
                  <%= icon(:calendar_days, class: "w-4 h-4 inline-block mr-1") %>
                  <%= apt.appointment_date.strftime("%A %d de %B, %Y") %>
                  &middot; <%= apt.start_time.strftime("%H:%M") %> - <%= apt.end_time.strftime("%H:%M") %>
                </p>
                <% if apt.doctor_branch %>
                  <p class="text-sm text-muted dark:text-slate-500 mt-1"><%= apt.doctor_branch.name %></p>
                <% end %>
              </div>
              <span class="text-sm px-3 py-1 rounded-full font-medium <%= apt.status_classes[:bg] %> <%= apt.status_classes[:text] %>"><%= apt.status_label %></span>
            </div>
          <% end %>
        <% end %>
      </div>
    <% else %>
      <div class="card p-8 text-center">
        <%= icon(:calendar_days, class: "w-12 h-12 mx-auto text-slate-300 dark:text-slate-600 mb-3") %>
        <p class="text-muted dark:text-slate-400 text-sm mb-4">No tienes citas próximas.</p>
        <%= link_to "Buscar doctores", doctors_path, class: "btn-primary" %>
      </div>
    <% end %>
  </div>

  <!-- Past -->
  <div>
    <h2 class="text-lg font-semibold text-ink dark:text-white mb-4">Historial</h2>
    <% if @past.any? %>
      <div class="space-y-3">
        <% @past.each do |apt| %>
          <%= link_to paciente_appointment_path(apt), class: "block card card-hover card-accent #{apt.status_classes[:border]} p-5 opacity-75 hover:opacity-100" do %>
            <div class="flex items-start justify-between gap-3">
              <div>
                <p class="font-semibold text-ink dark:text-white"><%= apt.doctor_profile.display_name %></p>
                <p class="text-sm text-muted dark:text-slate-400"><%= apt.doctor_profile.specialty&.name %></p>
                <p class="text-sm text-muted dark:text-slate-300 mt-1">
                  <%= apt.appointment_date.strftime("%d/%m/%Y") %> &middot; <%= apt.start_time.strftime("%H:%M") %>
                </p>
              </div>
              <span class="text-sm px-3 py-1 rounded-full font-medium <%= apt.status_classes[:bg] %> <%= apt.status_classes[:text] %>"><%= apt.status_label %></span>
            </div>
          <% end %>
        <% end %>
      </div>
    <% else %>
      <p class="text-muted dark:text-slate-400 text-sm">Aún no tienes citas pasadas.</p>
    <% end %>
  </div>
</div>
