<div class="max-w-3xl mx-auto">
  <% actions = capture do %>
    <%= link_to "Editar perfil", edit_paciente_profile_path, class: "btn-primary" %>
  <% end %>
  <%= render "shared/page_header", title: "Mi Perfil", actions: actions %>

  <div class="card p-6">
    <div class="space-y-4">
      <div>
        <h3 class="text-sm font-medium text-muted dark:text-slate-400">Nombre</h3>
        <p class="text-ink dark:text-white font-semibold"><%= @patient_profile.name %></p>
      </div>

      <% if @patient_profile.identity_document.present? %>
        <div>
          <h3 class="text-sm font-medium text-muted dark:text-slate-400">Número de identidad</h3>
          <p class="text-ink dark:text-white"><%= @patient_profile.identity_document %></p>
        </div>
      <% end %>

      <div>
        <h3 class="text-sm font-medium text-muted dark:text-slate-400">Correo electrónico</h3>
        <p class="text-ink dark:text-white"><%= Current.user.email %></p>
      </div>

      <% if @patient_profile.phone.present? %>
        <div>
          <h3 class="text-sm font-medium text-muted dark:text-slate-400">Teléfono</h3>
          <p class="text-ink dark:text-white"><%= @patient_profile.phone %></p>
        </div>
      <% end %>

      <% if @patient_profile.date_of_birth.present? %>
        <div>
          <h3 class="text-sm font-medium text-muted dark:text-slate-400">Fecha de nacimiento</h3>
          <p class="text-ink dark:text-white"><%= @patient_profile.date_of_birth.strftime("%d/%m/%Y") %></p>
        </div>
      <% end %>

      <% if @patient_profile.country.present? || @patient_profile.department.present? || @patient_profile.city.present? %>
        <div>
          <h3 class="text-sm font-medium text-muted dark:text-slate-400">Ubicación</h3>
          <p class="text-ink dark:text-white"><%= [@patient_profile.city&.name, @patient_profile.department&.name, @patient_profile.country&.name].compact.join(", ") %></p>
        </div>
      <% end %>
    </div>
  </div>
</div>
