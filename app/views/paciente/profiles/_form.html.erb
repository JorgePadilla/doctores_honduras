<%= form_with model: patient_profile, url: paciente_profile_path, method: :patch, class: "space-y-6" do |f| %>
  <%= render "shared/form_errors", model: patient_profile %>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6"
       data-controller="location-filter"
       data-location-filter-department-blank-value="Selecciona un departamento"
       data-location-filter-city-blank-value="Selecciona una ciudad">
    <div>
      <%= f.label :name, "Nombre completo *", class: "form-label" %>
      <%= f.text_field :name, class: "form-input", required: true %>
    </div>

    <div>
      <%= f.label :identity_document, "Número de identidad (DNI) *", class: "form-label" %>
      <%= f.text_field :identity_document, placeholder: "0801-1990-12345", class: "form-input", required: true %>
    </div>

    <div>
      <%= label_tag :email, "Correo electrónico *", class: "form-label" %>
      <%= email_field_tag :email, Current.user.email, class: "form-input", required: true %>
    </div>

    <div>
      <%= f.label :phone, "Teléfono *", class: "form-label" %>
      <%= f.telephone_field :phone, placeholder: "+504 0000-0000", class: "form-input", required: true %>
    </div>

    <div>
      <%= f.label :date_of_birth, "Fecha de nacimiento", class: "form-label" %>
      <%= f.text_field :date_of_birth,
            value: patient_profile.date_of_birth&.to_s,
            data: { controller: "datepicker", datepicker_mode_value: "past" },
            placeholder: "Selecciona una fecha",
            autocomplete: "off",
            class: "form-input" %>
    </div>

    <div>
      <%= f.label :country_id, "País *", class: "form-label" %>
      <%= f.select :country_id, options_from_collection_for_select(countries, :id, :name, patient_profile.country_id),
          { include_blank: "Selecciona un país" },
          { class: "form-input form-select", required: true,
            data: { location_filter_target: "country", action: "change->location-filter#loadDepartments" } } %>
    </div>

    <div>
      <%= f.label :department_id, "Departamento", class: "form-label" %>
      <%= f.select :department_id, options_from_collection_for_select(departments, :id, :name, patient_profile.department_id),
          { include_blank: "Selecciona un departamento" },
          { class: "form-input form-select",
            data: { location_filter_target: "department", action: "change->location-filter#loadCities" } } %>
    </div>

    <div>
      <%= f.label :city_id, "Ciudad", class: "form-label" %>
      <%= f.select :city_id, options_from_collection_for_select(cities, :id, :name, patient_profile.city_id),
          { include_blank: "Selecciona una ciudad" },
          { class: "form-input form-select",
            data: { location_filter_target: "city" } } %>
    </div>
  </div>

  <div class="flex items-center justify-end gap-3">
    <%= link_to "Cancelar", paciente_profile_path, class: "btn-secondary" %>
    <%= f.submit "Guardar cambios", class: "btn-primary" %>
  </div>
<% end %>
