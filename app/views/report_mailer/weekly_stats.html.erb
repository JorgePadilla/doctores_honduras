<div style="max-width: 560px; margin: 0 auto; font-family: Helvetica, Arial, sans-serif; color: #0B1220;">
  <div style="background: #0C4A6E; border-radius: 12px 12px 0 0; padding: 20px 24px;">
    <p style="margin: 0; color: #ffffff; font-size: 18px; font-weight: bold;">Doctores Honduras</p>
    <p style="margin: 4px 0 0; color: #BAE6FD; font-size: 13px;">Tu reporte semanal de visitas</p>
  </div>

  <div style="border: 1px solid #E4E9F0; border-top: 0; border-radius: 0 0 12px 12px; padding: 24px;">
    <p style="margin: 0 0 4px; font-size: 15px;">Hola <strong><%= @doctor.display_name %></strong>,</p>
    <p style="margin: 0 0 20px; font-size: 14px; color: #4B5768;">Así se movió tu perfil en los últimos 7 días:</p>

    <div style="background: #F0F9FF; border-radius: 10px; padding: 18px 20px; margin-bottom: 20px; text-align: center;">
      <span style="font-size: 40px; font-weight: bold; color: #0284C7;"><%= @views %></span>
      <span style="font-size: 15px; color: #4B5768;"><%= @views == 1 ? "visita" : "visitas" %> a tu perfil</span>
      <% if @trend %>
        <p style="margin: 6px 0 0; font-size: 13px; font-weight: bold; color: <%= @trend >= 0 ? '#1A9E6C' : '#C43D3D' %>;">
          <%= @trend >= 0 ? "▲" : "▼" %> <%= @trend.abs %>% vs. la semana anterior (<%= @analytics.views_last_week %>)
        </p>
      <% end %>
    </div>

    <% sources = @analytics.sources_breakdown %>
    <% if sources.values.sum > 0 %>
      <p style="margin: 0 0 6px; font-size: 13px; font-weight: bold; text-transform: uppercase; letter-spacing: 0.05em; color: #8B95A5;">Cómo te encuentran</p>
      <table style="width: 100%; border-collapse: collapse; margin-bottom: 18px;">
        <% sources.each do |label, count| %>
          <tr>
            <td style="padding: 4px 0; font-size: 14px; color: #0B1220;"><%= label %></td>
            <td style="padding: 4px 0; font-size: 14px; font-weight: bold; text-align: right; color: #0284C7;"><%= count %></td>
          </tr>
        <% end %>
      </table>
    <% end %>

    <% devices = @analytics.by_device %>
    <% if devices.any? %>
      <p style="margin: 0 0 6px; font-size: 13px; font-weight: bold; text-transform: uppercase; letter-spacing: 0.05em; color: #8B95A5;">Dispositivos</p>
      <table style="width: 100%; border-collapse: collapse; margin-bottom: 18px;">
        <% devices.each do |label, count| %>
          <tr>
            <td style="padding: 4px 0; font-size: 14px; color: #0B1220;"><%= label %></td>
            <td style="padding: 4px 0; font-size: 14px; font-weight: bold; text-align: right; color: #0284C7;"><%= count %></td>
          </tr>
        <% end %>
      </table>
    <% end %>

    <% if @tier == "elite" %>
      <% clicks = @analytics.contact_clicks %>
      <% if clicks.any? %>
        <p style="margin: 0 0 6px; font-size: 13px; font-weight: bold; text-transform: uppercase; letter-spacing: 0.05em; color: #8B95A5;">Clicks de contacto</p>
        <table style="width: 100%; border-collapse: collapse; margin-bottom: 18px;">
          <% clicks.each do |kind, count| %>
            <tr>
              <td style="padding: 4px 0; font-size: 14px; color: #0B1220;"><%= kind %></td>
              <td style="padding: 4px 0; font-size: 14px; font-weight: bold; text-align: right; color: #0284C7;"><%= count %></td>
            </tr>
          <% end %>
        </table>
      <% end %>
      <% if @analytics.bookings_completed > 0 %>
        <p style="margin: 0 0 18px; font-size: 14px;">📅 <strong><%= @analytics.bookings_completed %></strong> reserva(s) completada(s) esta semana.</p>
      <% end %>
    <% end %>

    <div style="text-align: center; margin: 24px 0 8px;">
      <a href="<%= estadisticas_url %>"
         style="display: inline-block; background: #0284C7; color: #ffffff; font-size: 14px; font-weight: bold; text-decoration: none; padding: 12px 28px; border-radius: 999px;">
        Ver estadísticas completas
      </a>
    </div>

    <p style="margin: 20px 0 0; font-size: 12px; color: #8B95A5; text-align: center;">
      Recibes este correo por tu plan <%= @tier.capitalize %>. Puedes desactivarlo en
      <a href="<%= settings_notifications_url %>" style="color: #0284C7;">Ajustes → Notificaciones</a>.
    </p>
  </div>
</div>
