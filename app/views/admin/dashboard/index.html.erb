<div class="max-w-6xl mx-auto">
  <%# Header %>
  <% actions = capture do %>
    <span class="px-3 py-1 text-sm font-medium rounded-full bg-sky-50 dark:bg-sky-900/30 text-sky-700 dark:text-sky-400">Admin</span>
    <span class="text-sm text-muted dark:text-slate-400 truncate max-w-[14rem]"><%= Current.user.email %></span>
  <% end %>
  <%= render "shared/page_header", title: "Panel de Control", actions: actions %>

  <%= render "admin/dashboard/nav", active: :dashboard %>

  <!-- Overview stat cards -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 mb-6">
    <% stats = [
         { label: "Total Usuarios", value: @users_count, sub: "<span class=\"text-green-600 dark:text-green-400 font-medium\">+#{@new_users_this_week}</span> esta semana".html_safe, icon: :user },
         { label: "Total Doctores", value: @doctors_count, sub: "<span class=\"text-green-600 dark:text-green-400 font-medium\">+#{@new_doctors_this_week}</span> esta semana".html_safe, icon: :heart },
         { label: "Suscripciones Activas", value: @active_subscriptions, sub: "Ingreso mensual: $#{@monthly_revenue}", icon: :credit_card },
         { label: "Perfiles con Imagen", value: "#{@completion_rate}%", sub: "#{@doctors_with_images}/#{@doctors_count} con imagen", icon: :squares_2x2 }
       ] %>
    <% stats.each do |s| %>
      <div class="card card-hover p-6">
        <div class="flex items-start justify-between">
          <div class="min-w-0">
            <p class="text-sm font-medium text-muted dark:text-slate-400 truncate"><%= s[:label] %></p>
            <p class="text-2xl font-bold text-ink dark:text-white mt-1"><%= s[:value] %></p>
            <p class="text-sm text-muted dark:text-slate-400 mt-1"><%= s[:sub] %></p>
          </div>
          <div class="p-3 rounded-full bg-primary-soft dark:bg-sky-900/30 text-primary dark:text-sky-400 flex-shrink-0">
            <%= icon(s[:icon], class: "w-6 h-6") %>
          </div>
        </div>
      </div>
    <% end %>
  </div>

  <!-- Growth & revenue charts -->
  <div class="grid gap-6 md:grid-cols-2 mb-6">
    <%= render "shared/bar_list", title: "Nuevos doctores (7 días)",
        data: @doctor_growth_data.to_h { |d| [d[:date], d[:doctors]] },
        empty: "Sin nuevos doctores en los últimos 7 días." %>
    <%= render "shared/bar_list", title: "Ingresos (6 meses)",
        data: @revenue_data.to_h { |d| [d[:month], d[:revenue]] },
        empty: "Sin ingresos registrados en los últimos 6 meses." %>
  </div>

  <!-- System status -->
  <div class="card p-6 mb-6">
    <h2 class="card-title">Estado del Sistema</h2>
      <div class="space-y-4">
        <% active_pct = @doctors_count > 0 ? [((@doctors_count - @hidden_profiles).to_f / @doctors_count * 100).round, 100].min : 0 %>
        <div class="flex justify-between items-center">
          <span class="text-sm font-medium text-muted dark:text-slate-400">Perfiles Activos</span>
          <span class="text-sm font-medium text-primary dark:text-sky-400"><%= @doctors_count - @hidden_profiles %>/<%= @doctors_count %></span>
        </div>
        <div class="w-full bg-slate-200 dark:bg-slate-600 rounded-full h-2">
          <div class="bg-primary h-2 rounded-full" style="width: <%= active_pct %>%"></div>
        </div>

        <div class="flex justify-between items-center">
          <span class="text-sm font-medium text-muted dark:text-slate-400">Perfiles Completos</span>
          <span class="text-sm font-medium text-primary dark:text-sky-400"><%= @completion_rate %>%</span>
        </div>
        <div class="w-full bg-slate-200 dark:bg-slate-600 rounded-full h-2">
          <div class="bg-primary h-2 rounded-full" style="width: <%= @completion_rate %>%"></div>
        </div>

        <% subs_pct = @users_count > 0 ? [(@active_subscriptions.to_f / @users_count * 100).round, 100].min : 0 %>
        <div class="flex justify-between items-center">
          <span class="text-sm font-medium text-muted dark:text-slate-400">Suscripciones Activas</span>
          <span class="text-sm font-medium text-primary dark:text-sky-400"><%= @active_subscriptions %></span>
        </div>
        <div class="w-full bg-slate-200 dark:bg-slate-600 rounded-full h-2">
          <div class="bg-primary h-2 rounded-full" style="width: <%= subs_pct %>%"></div>
        </div>
      </div>

      <% if @hidden_profiles > 0 || @incomplete_profiles > 0 %>
        <div class="mt-4 p-3 bg-yellow-50 dark:bg-yellow-900/20 border border-yellow-200 dark:border-yellow-800 rounded-lg">
          <div class="flex items-center">
            <%= icon(:exclamation_triangle, class: "w-4 h-4 text-yellow-600 dark:text-yellow-400 flex-shrink-0") %>
            <div class="ml-2">
              <p class="text-sm font-medium text-yellow-800 dark:text-yellow-300">Acciones Pendientes</p>
              <p class="text-sm text-yellow-600 dark:text-yellow-400">
                <% if @hidden_profiles > 0 %><%= @hidden_profiles %> perfiles ocultos<% end %>
                <% if @incomplete_profiles > 0 %><% if @hidden_profiles > 0 %> y <% end %><%= @incomplete_profiles %> incompletos<% end %>
              </p>
            </div>
          </div>
        </div>
      <% else %>
        <div class="mt-4 p-3 bg-green-50 dark:bg-green-900/20 border border-green-200 dark:border-green-800 rounded-lg">
          <div class="flex items-center">
            <%= icon(:check_circle, class: "w-4 h-4 text-green-600 dark:text-green-400 flex-shrink-0") %>
            <div class="ml-2">
              <p class="text-sm font-medium text-green-800 dark:text-green-300">Todo en orden</p>
              <p class="text-sm text-green-600 dark:text-green-400">No hay acciones pendientes</p>
            </div>
          </div>
        </div>
      <% end %>
  </div>

  <!-- Recent activity -->
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
    <!-- Recent Users -->
    <div class="card p-6">
      <h2 class="card-title">Usuarios Recientes</h2>
      <div class="space-y-3">
        <% @recent_users.each do |user| %>
          <div class="flex items-center justify-between py-2 border-b border-line dark:border-slate-700 last:border-0">
            <div class="flex items-center min-w-0">
              <div class="w-8 h-8 bg-slate-200 dark:bg-slate-700 rounded-full flex items-center justify-center flex-shrink-0">
                <span class="text-sm font-medium text-slate-700 dark:text-slate-300"><%= user.email[0].upcase %></span>
              </div>
              <div class="ml-3 min-w-0">
                <p class="text-sm font-medium text-ink dark:text-white truncate"><%= user.email %></p>
                <p class="text-sm text-muted dark:text-slate-400">Registrado: <%= time_ago_in_words(user.created_at) %> atrás</p>
              </div>
            </div>
            <% if user.admin? %>
              <span class="ml-2 px-2.5 py-0.5 text-sm font-medium bg-sky-50 dark:bg-sky-900/30 text-sky-700 dark:text-sky-400 rounded-full flex-shrink-0">Admin</span>
            <% end %>
          </div>
        <% end %>
      </div>
      <%= link_to "Ver todos los usuarios", admin_users_path, class: "mt-4 inline-block text-sm font-medium text-sky-600 dark:text-sky-400 hover:underline" %>
    </div>

    <!-- Recent Doctors -->
    <div class="card p-6">
      <h2 class="card-title">Doctores Recientes</h2>
      <div class="space-y-3">
        <% @recent_doctors.each do |doctor| %>
          <div class="flex items-center justify-between py-2 border-b border-line dark:border-slate-700 last:border-0">
            <div class="flex items-center min-w-0">
              <% if doctor.image_url.present? %>
                <%= image_tag doctor.image_thumb_url.presence || doctor.image_url, loading: "lazy", class: "w-8 h-8 rounded-full object-cover flex-shrink-0" %>
              <% else %>
                <div class="w-8 h-8 bg-slate-200 dark:bg-slate-700 rounded-full flex items-center justify-center flex-shrink-0">
                  <span class="text-sm font-medium text-slate-700 dark:text-slate-300"><%= doctor.name[0].upcase %></span>
                </div>
              <% end %>
              <div class="ml-3 min-w-0">
                <p class="text-sm font-medium text-ink dark:text-white truncate"><%= doctor.name %></p>
                <p class="text-sm text-muted dark:text-slate-400 truncate"><%= doctor.specialty&.name %></p>
              </div>
            </div>
            <% if doctor.hidden? %>
              <span class="ml-2 px-2.5 py-0.5 text-sm font-medium bg-yellow-100 dark:bg-yellow-900/30 text-yellow-800 dark:text-yellow-300 rounded-full flex-shrink-0">Oculto</span>
            <% end %>
          </div>
        <% end %>
      </div>
      <%= link_to "Ver todos los doctores", admin_doctors_path, class: "mt-4 inline-block text-sm font-medium text-sky-600 dark:text-sky-400 hover:underline" %>
    </div>
  </div>
</div>
