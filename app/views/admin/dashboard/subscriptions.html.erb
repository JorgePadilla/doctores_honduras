<div class="max-w-6xl mx-auto">
  <%# Header %>
  <% actions = capture do %>
    <span class="px-3 py-1 text-sm font-medium rounded-full bg-sky-50 dark:bg-sky-900/30 text-sky-700 dark:text-sky-400">Admin</span>
    <span class="text-sm text-muted dark:text-slate-400 truncate max-w-[14rem]"><%= Current.user.email %></span>
  <% end %>
  <%= render "shared/page_header", title: "Gestión de Suscripciones", actions: actions %>

  <%= render "admin/dashboard/nav", active: :subscriptions %>

  <!-- Stats -->
  <div class="card p-6 mb-6">
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
      <div class="text-center">
        <p class="text-sm font-medium text-muted dark:text-slate-400">Total Suscripciones</p>
        <p class="text-2xl font-bold text-ink dark:text-white"><%= @total_subscriptions %></p>
      </div>
      <div class="text-center">
        <p class="text-sm font-medium text-muted dark:text-slate-400">Activas</p>
        <p class="text-2xl font-bold text-green-600 dark:text-green-400"><%= @active_subscriptions_count %></p>
      </div>
      <div class="text-center">
        <p class="text-sm font-medium text-muted dark:text-slate-400">Canceladas</p>
        <p class="text-2xl font-bold text-red-600 dark:text-red-400"><%= @canceled_subscriptions %></p>
      </div>
      <div class="text-center">
        <p class="text-sm font-medium text-muted dark:text-slate-400">Ingreso Mensual</p>
        <p class="text-2xl font-bold text-purple-600 dark:text-purple-400">$<%= @monthly_revenue %></p>
      </div>
    </div>
  </div>

  <!-- Subscriptions Table -->
  <div class="card overflow-hidden">
    <div class="overflow-x-auto">
      <table class="min-w-full divide-y divide-line dark:divide-slate-700">
        <thead>
          <tr>
            <th class="px-6 py-3 bg-slate-50 dark:bg-slate-700/50 text-left text-sm font-medium text-muted dark:text-slate-400 uppercase tracking-wider">Usuario</th>
            <th class="px-6 py-3 bg-slate-50 dark:bg-slate-700/50 text-left text-sm font-medium text-muted dark:text-slate-400 uppercase tracking-wider">Plan</th>
            <th class="px-6 py-3 bg-slate-50 dark:bg-slate-700/50 text-left text-sm font-medium text-muted dark:text-slate-400 uppercase tracking-wider">Estado</th>
            <th class="px-6 py-3 bg-slate-50 dark:bg-slate-700/50 text-left text-sm font-medium text-muted dark:text-slate-400 uppercase tracking-wider">Inicio</th>
            <th class="px-6 py-3 bg-slate-50 dark:bg-slate-700/50 text-left text-sm font-medium text-muted dark:text-slate-400 uppercase tracking-wider">Fin</th>
            <th class="px-6 py-3 bg-slate-50 dark:bg-slate-700/50 text-left text-sm font-medium text-muted dark:text-slate-400 uppercase tracking-wider">Precio</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-line dark:divide-slate-700">
          <% if @subscriptions.present? %>
            <% @subscriptions.each do |subscription| %>
              <tr class="hover:bg-slate-50 dark:hover:bg-slate-700/50 transition-colors">
                <td class="px-6 py-4 whitespace-nowrap">
                  <div class="flex items-center">
                    <div class="w-8 h-8 bg-slate-200 dark:bg-slate-600 rounded-full flex items-center justify-center">
                      <span class="text-sm font-medium text-slate-700 dark:text-slate-300"><%= subscription.user.email[0].upcase %></span>
                    </div>
                    <div class="ml-4">
                      <div class="text-sm font-medium text-ink dark:text-white"><%= subscription.user.email %></div>
                    </div>
                  </div>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-ink dark:text-white">
                  <%= subscription.subscription_plan&.name || 'Sin plan' %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                  <% case subscription.status %>
                  <% when 'active' %>
                    <span class="badge badge-success">Activa</span>
                  <% when 'canceled' %>
                    <span class="badge badge-error">Cancelada</span>
                  <% when 'past_due' %>
                    <span class="badge badge-warning">Vencida</span>
                  <% else %>
                    <span class="badge badge-neutral"><%= subscription.status %></span>
                  <% end %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-muted dark:text-slate-400">
                  <%= subscription.current_period_start&.strftime('%d/%m/%Y') || 'N/A' %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-muted dark:text-slate-400">
                  <%= subscription.current_period_end&.strftime('%d/%m/%Y') || 'N/A' %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-ink dark:text-white">
                  $<%= subscription.subscription_plan&.price || '0' %>
                </td>
              </tr>
            <% end %>
          <% else %>
            <tr>
              <td colspan="6" class="px-6 py-8 text-center text-muted dark:text-slate-400">
                No hay suscripciones registradas
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>

  <% if @total_pages > 1 %>
    <nav class="mt-6 flex justify-center" aria-label="Paginación">
      <%= pagination_links(@page, @total_pages, {}) %>
    </nav>
  <% end %>

  <!-- Revenue Breakdown -->
  <div class="mt-6 grid grid-cols-1 lg:grid-cols-2 gap-6">
    <!-- Plan Distribution -->
    <div class="card p-6">
      <h2 class="card-title">Distribución por Plan</h2>
      <div class="space-y-3">
        <% active_total = @active_subscriptions_count %>
        <% @subscription_plans.each do |plan| %>
          <% plan_count = @active_counts_by_plan[plan.id] || 0 %>
          <% if plan_count > 0 %>
            <div class="flex justify-between items-center">
              <span class="text-sm text-muted dark:text-slate-400"><%= plan.name %></span>
              <span class="text-sm font-medium text-ink dark:text-white"><%= plan_count %> usuarios</span>
            </div>
            <div class="w-full bg-slate-200 dark:bg-slate-600 rounded-full h-2">
              <div class="bg-sky-500 h-2 rounded-full" style="width: <%= active_total > 0 ? (plan_count.to_f / active_total * 100).round : 0 %>%"></div>
            </div>
          <% end %>
        <% end %>
      </div>
    </div>

    <!-- Monthly Revenue -->
    <div class="card p-6">
      <h2 class="card-title">Ingresos por Plan</h2>
      <div class="space-y-3">
        <% @subscription_plans.each do |plan| %>
          <% plan_count = @active_counts_by_plan[plan.id] || 0 %>
          <% plan_revenue = plan_count * plan.price %>
          <% if plan_revenue > 0 %>
            <div class="flex justify-between items-center">
              <span class="text-sm text-muted dark:text-slate-400"><%= plan.name %></span>
              <span class="text-sm font-medium text-ink dark:text-white">$<%= plan_revenue %></span>
            </div>
            <div class="w-full bg-slate-200 dark:bg-slate-600 rounded-full h-2">
              <div class="bg-green-600 h-2 rounded-full" style="width: <%= @monthly_revenue > 0 ? (plan_revenue.to_f / @monthly_revenue * 100).round : 0 %>%"></div>
            </div>
          <% end %>
        <% end %>
      </div>
    </div>
  </div>
</div>
