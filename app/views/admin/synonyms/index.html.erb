<div class="max-w-6xl mx-auto">
  <!-- Page header -->
  <div class="flex flex-wrap items-center justify-between gap-3 mb-6">
    <div class="flex items-center gap-3">
      <h1 class="text-2xl font-bold text-gray-900 dark:text-white">Sinónimos de búsqueda</h1>
      <span class="px-3 py-1 text-sm font-medium rounded-full bg-sky-50 dark:bg-sky-900/30 text-sky-700 dark:text-sky-400">Admin</span>
    </div>
    <span class="text-sm text-gray-500 dark:text-slate-400 truncate"><%= Current.user.email %></span>
  </div>

  <%= render "admin/dashboard/nav", active: :synonyms %>

  <div class="bg-white dark:bg-slate-800 rounded-xl shadow-md dark:shadow-slate-900/50 p-6">
    <p class="text-sm text-gray-500 dark:text-slate-400 mb-6">
      El paciente escribe el <strong>término coloquial</strong> (izquierda) y la búsqueda de médicos lo traduce a estas <strong>palabras clave clínicas</strong> (derecha), separadas por comas. Ej.: <em>caries</em> → <em>endodoncia, limpieza dental, odontología</em>.
    </p>

    <!-- Alta -->
    <%= form_with model: @synonym, url: admin_synonyms_path, method: :post, class: "flex flex-col sm:flex-row gap-2 mb-6" do |f| %>
      <%= f.text_field :term, placeholder: "Término (ej. caries)", class: "form-input sm:w-56", required: true %>
      <%= f.text_field :keywords, placeholder: "Palabras clave separadas por comas", class: "form-input flex-1", required: true %>
      <button type="submit" class="inline-flex items-center justify-center gap-1 px-4 py-2 rounded-lg bg-sky-500 hover:bg-sky-600 text-white text-sm font-medium transition-colors cursor-pointer shrink-0">
        <%= icon(:plus, class: "w-4 h-4") %> Agregar
      </button>
    <% end %>

    <% if @synonym.errors.any? %>
      <div role="alert" class="bg-red-50 dark:bg-red-900/20 text-red-700 dark:text-red-300 p-3 rounded-md mb-4 text-sm border border-red-200 dark:border-red-800">
        <%= @synonym.errors.full_messages.to_sentence %>
      </div>
    <% end %>

    <!-- Lista editable -->
    <% if @synonyms.any? %>
      <div class="divide-y divide-gray-100 dark:divide-slate-700 border-y border-gray-100 dark:border-slate-700">
        <% @synonyms.each do |synonym| %>
          <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-2 py-3">
            <%= form_with model: synonym, url: admin_synonym_path(synonym), method: :patch, class: "flex flex-col sm:flex-row gap-2 flex-1" do |f| %>
              <%= f.text_field :term, class: "form-input sm:w-56", required: true %>
              <%= f.text_field :keywords, class: "form-input flex-1", required: true %>
              <button type="submit" class="inline-flex items-center justify-center gap-1 px-3 py-2 rounded-lg border border-gray-300 dark:border-slate-600 text-gray-700 dark:text-slate-300 hover:bg-gray-50 dark:hover:bg-slate-700 text-sm font-medium transition-colors cursor-pointer shrink-0" title="Guardar">
                <%= icon(:check, class: "w-4 h-4") %>
              </button>
            <% end %>
            <%= button_to admin_synonym_path(synonym), method: :delete,
                  data: { turbo_confirm: "¿Eliminar el sinónimo \"#{synonym.term}\"?" },
                  class: "inline-flex items-center justify-center px-3 py-2 rounded-lg text-red-600 dark:text-red-400 hover:bg-red-50 dark:hover:bg-red-900/20 text-sm font-medium transition-colors cursor-pointer shrink-0", title: "Eliminar" do %>
              <%= icon(:trash, class: "w-4 h-4") %>
            <% end %>
          </div>
        <% end %>
      </div>
    <% else %>
      <p class="text-center text-sm text-gray-500 dark:text-slate-400 py-6">Aún no hay sinónimos. Agrega el primero arriba.</p>
    <% end %>
  </div>
</div>
