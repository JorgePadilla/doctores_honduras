# AWS S3 Configuration
AWS_BUCKET=your-bucket-name
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_REGION=us-east-1

# Stripe Configuration (if needed locally)
# STRIPE_SECRET_KEY=sk_test_xxx
# STRIPE_PUBLISHABLE_KEY=pk_test_xxx
# STRIPE_WEBHOOK_SECRET=whsec_xxx

# Email (production) — Resend SMTP. Without SMTP_PASSWORD, deliveries are skipped.
# SMTP_PASSWORD=re_xxx              # Resend API key
# MAIL_FROM=Doctores Honduras <notificaciones@tudominio.com>
# APP_HOST=doctoreshonduras-production.up.railway.app
# SOLID_QUEUE_IN_PUMA=true          # run the job worker inside Puma (Railway)

# MaxMind GeoLite2 (analytics geolocation, production)
# MAXMIND_LICENSE_KEY=xxx
